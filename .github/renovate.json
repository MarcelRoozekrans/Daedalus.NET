{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "schedule": ["before 6am on Monday"],
  "platformAutomerge": false,
  "timezone": "Europe/Amsterdam",
  "labels": ["dependencies"],
  "branchPrefix": "renovate/",
  "rangeStrategy": "pin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "The SDK version in global.json, moved together with the sdk Docker tags",
      "fileMatch": ["(^|/)global\\.json$"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group all NuGet minor/patch updates",
      "groupName": "NuGet packages (non-major)",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "NuGet major updates as individual PRs",
      "groupName": null,
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group Docker base image updates",
      "groupName": "Docker base images",
      "matchManagers": ["dockerfile"],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates and automerge",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "One PR per .NET SDK bump: global.json and the Docker tags. It re-runs count-warnings.sh --all --write",
      "groupName": ".NET SDK",
      "matchPackagePatterns": ["^mcr.microsoft.com/dotnet/", "^dotnet-sdk$"],
      "automerge": false
    },
    {
      "description": "Group test framework updates",
      "groupName": "Test frameworks",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": [
        "^xunit",
        "^NUnit",
        "^NSubstitute",
        "^coverlet",
        "^AwesomeAssertions",
        "^Bogus",
        "^Testcontainers",
        "^Respawn",
        "^Microsoft\\.NET\\.Test"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group code analyzer updates",
      "groupName": "Code analyzers",
      "matchManagers": ["nuget"],
      "matchPackagePatterns": [
        "^SonarAnalyzer",
        "^Meziantou\\.Analyzer",
        "^Microsoft\\.CodeAnalysis"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
