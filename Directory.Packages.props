<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- 1.7.5 → 1.7.8: floor set by Thalos.NET.Abstractions 0.11.0 -->
    <ZeroAllocValidationVersion>1.7.8</ZeroAllocValidationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire (13.1.0 → 13.4.6 fixes MessagePack via StreamJsonRpc). Aspire.Hosting.AppHost is implicit via Aspire.AppHost.Sdk (NU1009) -->
    <PackageVersion Include="Aspire.Hosting" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.4.6-preview.1.26319.6" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.4.1-beta.706" />

    <!-- OpenTelemetry 1.15.0 → 1.17.0 -->
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.17.0" />

    <!-- OpenAPI (10.0.3 → 10.0.12 fixes Microsoft.OpenApi 2.0.0) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

    <!-- Testcontainers 4.10.0 → 4.14.0 (SSH.NET) -->
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.14.0" />

    <!-- AI stack aligned with Thalos.NET -->
    <!-- 12.49.0 → 12.50.0: floor set by Thalos.NET.Anthropic 0.8.0 -->
    <PackageVersion Include="Anthropic" Version="12.50.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <!-- 10.10.0 → 10.10.1: floor set by Thalos.NET.Abstractions 0.11.0. Microsoft.Extensions.AI
         itself has no 10.10.1 and declares Abstractions >= 10.10.0, so it stays at 10.10.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />

    <!-- Analyzers (highest of the former per-project overrides) -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.19.0.132793" />
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.296" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.102" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.3" />

    <!-- Thalos.NET (nuget.org). 0.10.0 → 0.11.0 across the whole family: Thalos.NET.Workflow/.Orm pin
         Thalos.NET and Thalos.NET.Skills at exactly their own version, and all fifteen packages release
         together (see Thalos.NET/docs/release.md, "The next release ships fifteen packages").
         0.11.0 is BREAKING and is consumed by phase 2.5 task B1, run write authority: a run's start and
         every resume carry the principal that asked for them (WorkflowStartRequest.StartedBy and
         WorkflowResumeRequest.ResumedBy are required, the positional overloads are gone), StartAsync
         returns Result<Guid>, WorkflowNodeDispatcher takes required dispatch gates and host actions,
         IWorkflowReferenceResolver gained HostActionExistsAsync, and a node that leaves by `next` with
         declared outcomes fails the run on an undeclared one. -->
    <PackageVersion Include="Thalos.NET" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Git" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Git.LibGit2Sharp" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Abstractions" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Testing" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Mcp" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Anthropic" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Sentinel" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Memory" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Memory.RagNet" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Skills" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Channels" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Channels.Telegram" Version="0.11.0" />
    <!-- Phase 2.2 Part B: consume the durable workflow engine Part A shipped. -->
    <PackageVersion Include="Thalos.NET.Workflow" Version="0.11.0" />
    <PackageVersion Include="Thalos.NET.Workflow.Orm" Version="0.11.0" />
    <!-- ZeroAlloc.ORM 1.7.1 → 2.0.1 (#310): ZeroAlloc.Outbox.Orm 3.0.1 declares >= 2.0.0, and 2.0.1 is the
         version Thalos.NET.Workflow.Orm 0.11.0 is built against.
         2.0 rejects a migration version collision instead of skipping it: the outbox schema is versions 1-2
         and the workflow schema 1001+, so the two sources Daedalus.Migrations runs never collide. -->
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.0.1" />
    <!-- AdoNet.Async.Adapters: floor set by Thalos.NET.Workflow.Orm 0.7.0's own nuspec (1.4.1) — NOT the
         1.4.0 ZeroAlloc.Outbox.Orm 2.6.0 itself declares; Workflow.Orm's direct pin is the higher one and
         wins under CentralPackageTransitivePinningEnabled, so this must be pinned at 1.4.1 or NU1109 fires
         the moment Thalos.NET.Workflow.Orm is referenced. -->
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.4.1" />
    <!-- 1.2.2 → 1.2.3: floor set by Thalos.NET.Abstractions 0.6.0 -->
    <PackageVersion Include="ZeroAlloc.Results" Version="1.2.3" />
    <!-- 2.0.9 → 2.0.10: floor set by Thalos.NET.Abstractions 0.11.0 -->
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="2.0.10" />
    <!-- 2.4.2 → 2.4.4: floor set by ZeroAlloc.Outbox 3.0.1 -->
    <PackageVersion Include="ZeroAlloc.Serialisation" Version="2.4.4" />
    <!-- 2.1.0 → 2.1.3: floor set by Thalos.NET.Abstractions 0.6.0 -->
    <PackageVersion Include="ZeroAlloc.Authorization" Version="2.1.3" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="$(ZeroAllocValidationVersion)" />
    <PackageVersion Include="ZeroAlloc.Validation.Generator" Version="$(ZeroAllocValidationVersion)" />
    <PackageVersion Include="ZeroAlloc.Validation.Testing" Version="$(ZeroAllocValidationVersion)" />
    <PackageVersion Include="ZeroAlloc.Mapping" Version="1.6.1" />
    <!-- 5.1.1 → 5.1.5: floor set by Thalos.NET.Abstractions 0.6.0 -->
    <PackageVersion Include="ZeroAlloc.Mediator" Version="5.1.5" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="5.1.5" />
    <PackageVersion Include="ZeroAlloc.Pipeline" Version="1.2.2" />
    <!-- 2.7.1 → 3.0.1 (#310), all three together: 3.0 replaces FetchPendingAsync with a lease-based claim,
         row-locked on Postgres, so several hosts can poll one outbox table without dispatching a message twice.
         3.0.1, not 3.0.0: it fixes an EF Core 10 crash in ZeroAlloc.Outbox.EfCore. The EF table's lease columns
         come from the AddOutboxLease migration; the ORM table's from OutboxOrmMigrations migration 2, applied by
         Daedalus.Migrations. The live RepoDigest scheduling chain runs on ZeroAlloc.Outbox.EfCore. -->
    <PackageVersion Include="ZeroAlloc.Outbox" Version="3.0.1" />
    <PackageVersion Include="ZeroAlloc.Outbox.EfCore" Version="3.0.1" />
    <!-- Moves with ZeroAlloc.Outbox above. Thalos.NET.Workflow.Orm 0.10.0 declares >= 2.7.1 and only enqueues
         through OrmOutboxStore's single-argument constructor, which 3.0.1 keeps. -->
    <PackageVersion Include="ZeroAlloc.Outbox.Orm" Version="3.0.1" />

    <!-- ASP.NET Core / Blazor -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageVersion Include="Radzen.Blazor" Version="8.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.12.50" />

    <!-- EF Core / data. 10.0.2 → 10.0.12 across the family: floor set by ZeroAlloc.Outbox.EfCore 3.0.1, which
         declares Microsoft.EntityFrameworkCore and .Relational >= 10.0.12. Design and InMemory move with them so
         the family stays on one version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <!-- transitive pin: aligns Relational (10.0.0 via Npgsql.EFCore) with EFCore.Design (MSB3277) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- 10.0.1 → 10.0.3: floor set by Rag.NET.VectorStores.PgVector 0.1.0 (via Thalos.NET.Memory.RagNet) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Microsoft.Extensions.* (10.0.12: transitive-pinning floor set by Thalos.NET.Abstractions 0.5.0 / Microsoft.Extensions.AI 10.10 / ModelContextProtocol 2.2 / Aspire 13.4.6) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />

    <!-- Libraries -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- 0.31.0 → 0.32.0: floor set by Thalos.NET.Git.LibGit2Sharp 0.6.0 -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.12" /> <!-- floor set by CommunityToolkit.Aspire.Hosting.Ollama 13.4.1 -->
    <PackageVersion Include="ZLinq" Version="1.5.4" />

    <!-- Testing -->
    <!-- 9.5.0 → 9.6.0: floor set by Thalos.NET.Testing 0.7.0 (Daedalus.Tests.Integration references it). -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.58.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.1.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.54.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.2" />
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
