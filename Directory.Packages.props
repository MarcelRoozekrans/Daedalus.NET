<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- 1.7.5 → 1.7.8: floor set by Thalos.NET.Abstractions 0.11.0.
         1.7.8 → 2.1.0, Validation and Testing: floor set by Thalos.NET.Abstractions 0.14.2. 2.0 bundles its source
         generator, so the separate ZeroAlloc.Validation.Generator reference is gone: with both, ZV9001 fails the build.
         2.1.0 → 2.2.0, Validation and Testing: floor set by Thalos.NET.Channels 0.15.0.
         2.2.0 → 2.3.1, Validation and Testing: floor set by Thalos.NET.Abstractions 0.16.0.
         2.3.1 → 2.3.2, Validation and Testing: floor set by Minos.NET 1.1.0.
         2.3.2 → 2.3.3, Validation and Testing: floor set by Thalos.NET.Abstractions 0.18.0.
         2.3.3 → 2.3.4, Validation and Testing: floor set by Thalos.NET.Abstractions 0.19.0. -->
    <ZeroAllocValidationVersion>2.3.4</ZeroAllocValidationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire (13.1.0 → 13.4.6 fixes MessagePack via StreamJsonRpc). Aspire.Hosting.AppHost is implicit via Aspire.AppHost.Sdk (NU1009) -->
    <PackageVersion Include="Aspire.Hosting" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.4.6-preview.1.26319.6" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.4.1-beta.706" />
    <!-- MessagePack 2.5.302 → 2.5.307 for GHSA-qhrr-8q5h-9q3h (nested arrays can pass buffer length limits; patched in
         2.5.303). It is transitive: Aspire.Hosting → StreamJsonRpc 2.25.29, which still asks for 2.5.302, so the pin
         lifts it under CentralPackageTransitivePinningEnabled. Drop it once StreamJsonRpc depends on a fixed version. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />

    <!-- OpenTelemetry 1.15.0 → 1.17.0 -->
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <!-- Tests only: an isolated, per-provider exporter, so a wiring test reads what this provider exported. -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />

    <!-- OpenAPI (10.0.3 → 10.0.12 fixes Microsoft.OpenApi 2.0.0; 10.0.13 with the ASP.NET Core family below) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />

    <!-- Testcontainers 4.10.0 → 4.14.0 (SSH.NET) -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.16.0" />

    <!-- AI stack aligned with Thalos.NET -->
    <!-- 12.50.0 → 12.53.0: floor set by Thalos.NET.Anthropic 0.13.0 -->
    <!-- 12.53.0 → 12.55.0: floor set by Thalos.NET.Anthropic 0.15.0 -->
    <!-- 12.55.0 → 12.58.0: floor set by Thalos.NET.Anthropic 0.18.0 -->
    <!-- 12.58.0 → 13.1.0: floor set by Thalos.NET.Anthropic 0.19.0.
         Runtime behaviour change: API version 2026-10-21, the key sent as Authorization: Bearer, and AsIChatClient
         no longer forwards temperature, TopP or TopK. AgentFactory uses none of these. -->
    <PackageVersion Include="Anthropic" Version="13.1.0" />
    <!-- 10.10.0 → 10.11.0: floor set by Thalos.NET 0.18.0 -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- 10.10.0 → 10.10.1: floor set by Thalos.NET.Abstractions 0.11.0. Microsoft.Extensions.AI
         itself has no 10.10.1 and declares Abstractions >= 10.10.0, so it stays at 10.10.0.
         10.10.1 → 10.11.0, with Microsoft.Extensions.AI: floor set by Thalos.NET.Abstractions 0.18.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <!-- 2.2.0 → 2.3.0: floor set by Thalos.NET.Sandbox.Host 0.19.0, whose ModelContextProtocol.AspNetCore 2.3.0
         pins ModelContextProtocol at exactly [2.3.0]. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />

    <!-- Analyzers (highest of the former per-project overrides) -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.19.0.132793" />
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.296" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.102" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.3" />

    <!-- Thalos.NET (nuget.org). 0.10.0 → 0.11.0 across the whole family: Thalos.NET.Workflow/.Orm pin
         Thalos.NET and Thalos.NET.Skills at exactly their own version, and all eighteen packages release
         together (see Thalos.NET/docs/release.md, "0.14.0 ships eighteen packages").
         0.11.0 is BREAKING and is consumed by phase 2.5 task B1, run write authority: a run's start and
         every resume carry the principal that asked for them (WorkflowStartRequest.StartedBy and
         WorkflowResumeRequest.ResumedBy are required, the positional overloads are gone), StartAsync
         returns Result<Guid>, WorkflowNodeDispatcher takes required dispatch gates and host actions,
         IWorkflowReferenceResolver gained HostActionExistsAsync, and a node that leaves by `next` with
         declared outcomes fails the run on an undeclared one.
         0.11.0 → 0.11.1 (Thalos PR #210): IRunWorkspaceGit staging treats a requested path that is absent and
         untracked as nothing to stage, and an explicit empty Paths list stages nothing, so the open-pull-request
         action's AGENT.md commit no longer fails on a repository that has no AGENT.md.
         0.11.1 → 0.12.0 (Thalos PR #228): IWorkflowStore.RetryFailedNodeAsync, a required member that moves a Failed
         run back to Running at a host-action node, records a Retried event with its actor and re-dispatches that node.
         0.12.0 → 0.14.0 (phase 2.6): 0.13.0 fixed environment inheritance. 0.14.0 adds the run sandbox packages
         Thalos.NET.Sandbox, .Sandbox.Docker and .Sandbox.Host, which takes the family to eighteen packages.
         0.14.0 → 0.14.2 (phase 2.6 task B5): 0.14.1 adds GitCommitRequest.CommitStagedIndex, which publish needs
         to commit a sandboxed run's checked index as it stands, and registers IRunWorkspaceGit in
         UseSandboxRunWorkspaces (Thalos #250); 0.14.2 fixes the HTTP MCP connect, with no API change here.
         0.14.2 → 0.15.0 (phase 2.9): workflow telemetry on the `thalos.workflow` source and meter, the
         `workflow_run.trace_parent` column (migration 1010), and `TelemetryCapture` in Thalos.NET.Testing.
         0.15.0 → 0.16.0: IWorkflowRunQuery and IWorkflowRunObserver for phase 2.12's console.
         0.16.0 → 0.17.0 (Thalos PR #325): per-request model and tool overrides for phase 2.10.
         SubagentRunRequest gains Model and ToolFilter, checked by the engine against the agent's
         AllowedModels and resolved tools; AgentDefinition and AgentEnvelope gain AllowedModels.
         BREAKING: IAgentFactory gained a member.
         0.17.0 → 0.18.0 (Thalos PR #365): the sandbox host is AOT-clean, so phase 3.1 publishes
         Daedalus.Sandbox native. BREAKING: SandboxHost.CreateBuilder returns a slim builder, with no HTTPS
         configuration, no hosting startup assemblies and console logging only; the host refuses to start
         when a tool source cannot build its tools; the workspace tools register through AddLocalTools.
         0.18.0 → 0.19.0 (phase 3.2): every package but Testing is IsAotCompatible. BREAKING: a run variable must
         be JSON-shaped, refused with ArgumentException where it enters, so NodeResult, HostActionResult and the
         start options take no Guid, DateTime, enum or record; Thalos.NET.Sentinel moves to AI.Sentinel 3.2.1,
         whose PII and credential detectors redact by default. WorkflowVariableJson.ToElement is public. -->
    <PackageVersion Include="Thalos.NET" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Git" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Git.LibGit2Sharp" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Abstractions" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Testing" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Mcp" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Anthropic" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Sentinel" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Memory" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Memory.RagNet" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Skills" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Channels" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Channels.Telegram" Version="0.19.0" />
    <!-- Phase 2.2 Part B: consume the durable workflow engine Part A shipped. -->
    <PackageVersion Include="Thalos.NET.Workflow" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Workflow.Orm" Version="0.19.0" />
    <!-- Phase 2.6: the per-run Docker sandbox packages, net10.0 only, shipped from 0.14.0. -->
    <PackageVersion Include="Thalos.NET.Sandbox" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Sandbox.Docker" Version="0.19.0" />
    <PackageVersion Include="Thalos.NET.Sandbox.Host" Version="0.19.0" />

    <!-- Minos.NET 1.1.0: per-node model and tool selection, phase 2.10. Daedalus.Agents references Minos.NET and
         Minos.NET.SystemOne, the OpenRouter decision client. 1.0.1 → 1.1.0: OpenRouter's per-request zero data
         retention and data-collection deny, Minos.NET#202. -->
    <PackageVersion Include="Minos.NET" Version="1.1.0" />
    <PackageVersion Include="Minos.NET.SystemOne" Version="1.1.0" />

    <!-- 1.1.11: Flux.Blazor references Microsoft.AspNetCore.Components; 1.1.10 could not build for browser-wasm. -->
    <PackageVersion Include="ZeroAlloc.Flux" Version="1.1.11" />
    <PackageVersion Include="ZeroAlloc.Flux.Blazor" Version="1.1.11" />
    <!-- ZeroAlloc.ORM 1.7.1 → 2.0.1 (#310): ZeroAlloc.Outbox.Orm 3.0.1 declares >= 2.0.0. 2.0.1 → 2.1.1: floor
         set by Thalos.NET.Workflow.Orm 0.11.1, the version it is built against.
         2.0 rejects a migration version collision instead of skipping it: the outbox schema is versions 1-2
         and the workflow schema 1001+, so the two sources Daedalus.Migrations runs never collide.
         2.1.1 → 2.2.0: floor set by ZeroAlloc.Outbox.Orm 4.2.0 and Thalos.NET.Workflow.Orm 0.14.x. 2.2 scopes the
         history table's versions by source, and its own upgrade of an older table refuses one both sources wrote,
         so Daedalus.Migrations attributes the rows first: see PreScopingMigrationHistory. -->
    <!-- 2.2.0 → 2.3.1: floor set by Thalos.NET.Workflow.Orm 0.16.0 -->
    <!-- 2.3.1 → 2.4.0: floor set by Thalos.NET.Workflow.Orm 0.18.0 -->
    <!-- 2.4.0 → 2.9.0: floor set by Thalos.NET.Workflow.Orm 0.19.0 -->
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.9.0" />
    <!-- AdoNet.Async.Adapters: floor set by Thalos.NET.Workflow.Orm 0.7.0's own nuspec (1.4.1) — NOT the
         1.4.0 ZeroAlloc.Outbox.Orm 2.6.0 itself declares; Workflow.Orm's direct pin is the higher one and
         wins under CentralPackageTransitivePinningEnabled, so this must be pinned at 1.4.1 or NU1109 fires
         the moment Thalos.NET.Workflow.Orm is referenced. -->
    <!-- 1.4.1 → 1.5.0: floor set by Thalos.NET.Workflow.Orm 0.15.0 -->
    <!-- 1.5.0 → 1.5.2: floor set by Thalos.NET.Workflow.Orm 0.16.0 -->
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.5.2" />
    <!-- 1.2.3 → 1.2.4: floor set by Thalos.NET.Abstractions 0.11.1. 1.2.4 → 1.4.0: floor set by ZeroAlloc.Rest 3.3.2.
         1.4.0 → 1.4.1: floor set by Thalos.NET.Abstractions 0.16.0.
         1.4.1 → 1.4.2: floor set by Minos.NET 1.1.0.
         1.4.2 → 1.4.4: floor set by Thalos.NET.Abstractions 0.18.0.
         1.4.4 → 1.4.5: floor set by Thalos.NET.Abstractions 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Results" Version="1.4.5" />
    <!-- Phase 2.11: the generated GitHub and Azure DevOps clients. The source generator ships inside ZeroAlloc.Rest;
         the standalone ZeroAlloc.Rest.Generator package exists only for old direct references, so it is not used.
         3.3.2 → 3.3.3: floor set by Minos.NET.SystemOne 1.1.0. -->
    <PackageVersion Include="ZeroAlloc.Rest" Version="3.3.3" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="3.3.3" />
    <!-- 1.1.11, transitive until now → 1.2.0: floor set by ZeroAlloc.Rest 3.3.2.
         1.2.0 → 1.2.1: floor set by AI.Sentinel 2.3.2, via Thalos.NET.Sentinel 0.16.0.
         1.2.1 → 1.2.4: floor set by AI.Sentinel 3.2.1, via Thalos.NET.Sentinel 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Collections" Version="1.2.4" />
    <!-- Phase 2.9: Daedalus.Agents generates [Instrument] proxies. Thalos's own dependency on this package excludes its
         analyzers, so the generator does not flow transitively: Daedalus references it directly. Version: the one
         Thalos.NET.Workflow 0.15.0's nuspec declares.
         1.12.0 → 1.12.2: floor set by Thalos.NET.Workflow 0.16.0.
         1.12.2 → 1.12.5: floor set by Thalos.NET.Abstractions and Thalos.NET.Workflow 0.18.0.
         1.12.5 → 1.12.6: floor set by Thalos.NET.Abstractions and Thalos.NET.Workflow 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.12.6" />
    <!-- 2.0.10 → 2.0.12: floor set by Thalos.NET.Abstractions 0.13.0 -->
    <!-- 2.0.12 → 2.1.0: floor set by Thalos.NET.Abstractions 0.15.0 -->
    <!-- 2.1.0 → 2.2.0: floor set by Thalos.NET.Abstractions 0.16.0 -->
    <!-- 2.2.0 → 2.2.2: floor set by Thalos.NET.Abstractions 0.18.0 -->
    <!-- 2.2.2 → 2.2.5: floor set by Thalos.NET.Abstractions 0.19.0 -->
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="2.2.5" />
    <!-- 2.4.4 → 2.5.0: floor set by ZeroAlloc.Outbox 4.2.0. 2.5.0 → 2.5.1: floor set by AI.Sentinel 2.3.1, via
         Thalos.NET.Sentinel 0.14.2. 2.5.1 → 2.8.1: floor set by AI.Sentinel 2.3.2, via Thalos.NET.Sentinel 0.16.0.
         2.8.1 → 2.8.5: floor set by AI.Sentinel 3.2.1, via Thalos.NET.Sentinel 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Serialisation" Version="2.8.5" />
    <!-- 2.1.3 → 2.1.5: floor set by Thalos.NET.Abstractions 0.13.0 -->
    <!-- 2.1.5 → 2.1.8: floor set by Thalos.NET.Abstractions 0.18.0 -->
    <PackageVersion Include="ZeroAlloc.Authorization" Version="2.1.8" />
    <PackageVersion Include="ZeroAlloc.Validation" Version="$(ZeroAllocValidationVersion)" />
    <PackageVersion Include="ZeroAlloc.Validation.Testing" Version="$(ZeroAllocValidationVersion)" />
    <PackageVersion Include="ZeroAlloc.Mapping" Version="1.6.1" />
    <!-- 5.1.5 → 6.0.2: floor set by Thalos.NET.Abstractions 0.12.0 (5.1.1 → 5.1.5 earlier: floor set by 0.6.0).
         Runtime behaviour change in Daedalus.Application: Mediator 6 opens an Activity span on every dispatch,
         even without WithTelemetry. -->
    <!-- 6.0.2 → 6.1.0, Mediator and Generator together: floor set by Thalos.NET.Abstractions 0.14.0.
         6.1.0 → 6.1.1, Mediator and Generator together: floor set by Thalos.NET.Abstractions 0.14.2.
         6.1.1 → 6.4.0, Mediator and Generator together: floor set by Thalos.NET.Abstractions 0.15.0.
         6.4.0 → 6.6.0, Mediator and Generator together: floor set by Thalos.NET.Abstractions 0.16.0.
         6.6.0 → 6.6.3, Mediator and Generator together: floor set by Thalos.NET.Abstractions 0.18.0. -->
    <PackageVersion Include="ZeroAlloc.Mediator" Version="6.6.3" />
    <PackageVersion Include="ZeroAlloc.Mediator.Generator" Version="6.6.3" />
    <!-- 1.2.2 → 1.3.0: floor set by ZeroAlloc.Mediator 6.1.0. 1.3.0 → 1.4.0: floor set by ZeroAlloc.Validation 2.1.0. -->
    <PackageVersion Include="ZeroAlloc.Pipeline" Version="1.4.0" />
    <!-- 2.7.1 → 3.0.1 (#310), all three together: 3.0 replaces FetchPendingAsync with a lease-based claim,
         row-locked on Postgres, so several hosts can poll one outbox table without dispatching a message twice.
         3.0.1, not 3.0.0: it fixes an EF Core 10 crash in ZeroAlloc.Outbox.EfCore. The EF table's lease columns
         come from the AddOutboxLease migration; the ORM table's from OutboxOrmMigrations migration 2, applied by
         Daedalus.Migrations. The live RepoDigest scheduling chain runs on ZeroAlloc.Outbox.EfCore.
         3.0.1 → 4.0.1, all three together: floor set by Thalos.NET.Workflow.Orm 0.11.1. 4.0 drops the default
         serializer, so AddChannelOutbox calls WithSystemTextJsonSerializer, which writes the same bytes 3.x did;
         and it rejects a second, different store, which Daedalus never registers. No schema change.
         4.0.1 → 4.2.0, ZeroAlloc.Outbox alone: floor set by Thalos.NET.Workflow.Orm 0.13.0. EfCore and Orm stay 4.0.1.
         4.2.0 → 4.4.0: floor set by Thalos.NET.Workflow.Orm 0.15.0.
         4.4.0 → 4.4.3: floor set by Thalos.NET.Workflow.Orm 0.16.0.
         4.4.3 → 4.4.5: floor set by Thalos.NET.Workflow.Orm 0.18.0.
         4.4.5 → 4.4.6: floor set by Thalos.NET.Workflow.Orm 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Outbox" Version="4.4.6" />
    <PackageVersion Include="ZeroAlloc.Outbox.EfCore" Version="4.0.1" />
    <!-- 4.0.1 → 4.2.0: floor set by Thalos.NET.Workflow.Orm 0.14.0. 4.2.0 → 4.4.0: floor set by
         Thalos.NET.Workflow.Orm 0.15.0. 4.4.0 → 4.4.3: floor set by Thalos.NET.Workflow.Orm 0.16.0.
         4.4.3 → 4.4.5: floor set by Thalos.NET.Workflow.Orm 0.18.0.
         4.4.5 → 4.4.6: floor set by Thalos.NET.Workflow.Orm 0.19.0. -->
    <PackageVersion Include="ZeroAlloc.Outbox.Orm" Version="4.4.6" />

    <!-- ASP.NET Core / Blazor -->
    <!-- Api calls AddNpgSql directly; it used to arrive transitively through Aspire.Hosting.PostgreSQL -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <!-- 10.0.2 → 10.0.12 across the Microsoft.AspNetCore.* family: SignalR.Client, and Components through
         Flux.Blazor, are at 10.0.12, so the rest move with them to one ASP.NET Core patch level.
         10.0.12 → 10.0.13, the whole family with OpenAPI: CVE-2026-70159 in SignalR.Common, which SignalR.Client
         brings in, and CVE-2026-102870 and CVE-2026-96230 in Components.WebAssembly.Server. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <!-- On every bump of WebAssembly.Authentication: re-check that its AuthenticationService.js still stores the OIDC
         user in sessionStorage under the 'oidc.user:' prefix. Daedalus.Web/wwwroot/js/session.js clears that prefix
         when a session expires; a changed store would leave the stored user in place without failing any test. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Phase 2.12: the console's live connection to /hubs/workflow-runs. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Radzen.Blazor" Version="8.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.12.50" />

    <!-- EF Core / data. 10.0.2 → 10.0.12 across the family: floor set by ZeroAlloc.Outbox.EfCore 3.0.1, which
         declares Microsoft.EntityFrameworkCore and .Relational >= 10.0.12. Design and InMemory move with them so
         the family stays on one version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <!-- transitive pin: aligns Relational (10.0.0 via Npgsql.EFCore) with EFCore.Design (MSB3277) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- 10.0.1 → 10.0.3: floor set by Rag.NET.VectorStores.PgVector 0.1.0 (via Thalos.NET.Memory.RagNet) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- Microsoft.Extensions.* (10.0.12: transitive-pinning floor set by Thalos.NET.Abstractions 0.5.0 / Microsoft.Extensions.AI 10.10 / ModelContextProtocol 2.2 / Aspire 13.4.6) -->
    <!-- 10.0.12 → 10.0.13: floor set by Microsoft.AspNetCore.Components.WebAssembly and SignalR.Client 10.0.13. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />

    <!-- Libraries -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- 0.31.0 → 0.32.0: floor set by Thalos.NET.Git.LibGit2Sharp 0.6.0 -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.12" /> <!-- floor set by CommunityToolkit.Aspire.Hosting.Ollama 13.4.1 -->
    <PackageVersion Include="ZLinq" Version="1.5.4" />

    <!-- Testing -->
    <!-- 9.5.0 → 9.6.0: floor set by Thalos.NET.Testing 0.7.0 (Daedalus.Tests.Integration references it). -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- 10.10.0 → 10.11.0: floor set by Thalos.NET.Testing 0.18.0 -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
