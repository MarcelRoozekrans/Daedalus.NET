<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>CA1707;CA2225;CS1591;CS1503;CS0854;CS1929</NoWarn>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <!-- Disable trimming for tests -->
        <TrimMode>none</TrimMode>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CSharpFunctionalExtensions" />
        <PackageReference Include="Bogus" />
        <PackageReference Include="Anthropic" />
        <!-- ZeroAlloc.Results 1.2.1 ships AssemblyVersion 0.1.0.0, a downgrade from 1.2.0's 1.2.0.0, which
             breaks the default assembly binder at host startup. Remove this override once 1.2.2 fixes the stamp. -->
        <PackageReference Include="ZeroAlloc.Results" VersionOverride="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Daedalus.Domain\Daedalus.Domain.csproj" />
        <ProjectReference Include="..\..\src\Daedalus.Application\Daedalus.Application.csproj" />
        <ProjectReference Include="..\..\src\Daedalus.Infrastructure\Daedalus.Infrastructure.csproj" />
    </ItemGroup>

</Project>
