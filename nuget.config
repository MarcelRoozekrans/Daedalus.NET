<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local Thalos.NET feed (phase 1.1). Packages are committed under packages-local/ so CI can restore.
         Delete the folder and this source once Thalos.NET 0.1.0 is published to nuget.org. -->
    <add key="thalos-local" value="packages-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="thalos-local">
      <package pattern="Thalos.NET*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
