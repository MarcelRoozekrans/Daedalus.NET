<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- TEMPORARY: Minos.NET 1.0.1 is not on nuget.org yet. Its packages are vendored in vendor/nuget/ so CI and the
         Docker images restore. Remove this source, its mapping and the folder once nuget.org lists 1.0.1; see
         vendor/nuget/README.md and #361. -->
    <add key="vendored" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vendored">
      <package pattern="Minos.NET*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
