<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The per-run sandbox host. Built into its own container image and referenced by no other project. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>Daedalus.Sandbox</RootNamespace>
        <!-- Published as a Native AOT binary, phase 3.1: the image runs /app/Daedalus.Sandbox. Thalos 0.18.0's host
             registers its tools without reflection, so the trim and AOT analyzers stay on and report nothing; the AOT
             warning ratchet, eng/aot/baseline.json, holds this project at 0. Native AOT trims every assembly, so the
             trim mode is full, and its output is one native file already, so the single-file bundler is off. -->
        <PublishAot>true</PublishAot>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFilePublish>false</EnableSingleFilePublish>
        <TrimMode>full</TrimMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Thalos.NET.Sandbox.Host" />
    </ItemGroup>

</Project>
