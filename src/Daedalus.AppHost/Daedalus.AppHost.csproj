<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <UserSecretsId>daedalus-apphost-secrets</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting"/>
        <PackageReference Include="Aspire.Hosting.Keycloak"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Api\Daedalus.Api.csproj"/>
        <ProjectReference Include="..\Daedalus.Web\Daedalus.Web.csproj"/>
    </ItemGroup>
</Project>
