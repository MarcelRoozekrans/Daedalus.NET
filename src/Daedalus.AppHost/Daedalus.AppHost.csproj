<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <UserSecretsId>daedalus-apphost-secrets</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting"/>
        <PackageReference Include="Aspire.Hosting.Keycloak"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AppHostOllamaWiringTests builds this app model, which needs the generated Program entry point type. -->
        <InternalsVisibleTo Include="Daedalus.Tests.Integration"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Api\Daedalus.Api.csproj"/>
        <ProjectReference Include="..\Daedalus.Web\Daedalus.Web.csproj"/>
    </ItemGroup>
</Project>
