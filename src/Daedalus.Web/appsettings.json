{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "ApiBaseUrl": "https://localhost:5001",
  "Oidc": {
    "Authority": "http://localhost:8082/realms/daedalus",
    "ClientId": "daedalus-wasm",
    "ResponseType": "code",
    "DefaultScopes": [
      "openid",
      "profile",
      "email"
    ],
    "PostLogoutRedirectUri": "http://localhost:8081/",
    "RedirectUri": "http://localhost:8081/authentication/login-callback"
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  }
}
