@page "/tasks"
@attribute [Authorize]
@inherits FluxComponent
@inject ApiClient Api
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IStore<TasksState> TaskStore
@inject IDispatcher Dispatcher
@inject TasksEffects Effects
@inject IStore<ProjectsState> ProjectStore
@inject ProjectsEffects ProjectsEffects
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

@* As Home's: the action wraps under the title on a phone rather than squeeze its text onto two lines. *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Tasks</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
            Plan work and start manufacture runs
        </RadzenText>
    </RadzenStack>
    <RadzenButton Text="New task" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialog"
                  Style="white-space: nowrap;" data-testid="btn-create-task"/>
</RadzenStack>

@if (!string.IsNullOrEmpty(TaskStore.Value.Error) && !SessionExpiry.IsSigningIn(TaskStore.Value.Error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4"
                 Close="@(() => Dispatcher.DispatchAsync(new TasksErrorDismissed()).AsTask())">
        @TaskStore.Value.Error
    </RadzenAlert>
}

@* ProjectsEffects stores no SigningInAgain failure, so this alert needs no sign-in check. *@
@if (ProjectStore.Value.Error is { } projectsError)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4" data-testid="tasks-projects-error">
        The projects could not be loaded: @projectsError
        <RadzenButton Text="Retry" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Click="@(() => ProjectsEffects.LoadAsync(_cts.Token))"/>
    </RadzenAlert>
}

@if (_manufactureRefused is { } refused)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4"
                 Close="@(() => _manufactureRefused = null)" data-testid="tasks-manufacture-refused">
        @refused
    </RadzenAlert>
}

@* The contract's tablet breakpoint: below 1280px Priority and Created are not rendered. Below 768px, a phone, the grid
   is one column: the title, then its status and pull request, then its actions, so Status and Manufacture show without
   scrolling sideways. Project is not shown there. *@
<RadzenMediaQuery Query="(min-width: 1280px)" Change="@(matches => _desktop = matches)"/>
<RadzenMediaQuery Query="(max-width: 767.98px)" Change="@(matches => _phone = matches)"/>

<div class="tasks-grid">
<RadzenDataGrid TItem="TaskDto" Data="@TaskStore.Value.Items" Count="@TaskStore.Value.Total" AllowPaging="true" PageSize="15"
                AllowSorting="true" AllowColumnResize="true" PagerHorizontalAlign="HorizontalAlign.Center"
                ShowPagingSummary="true" IsLoading="@TaskStore.Value.Loading"
                Style="@GridStyle" data-testid="tasks-grid">
    <EmptyTemplate>
        @* Only a board that was read and is empty says so. One that could not be read is not empty: the alert above says
           why. One still loading, or not yet asked for, as the initial state is, has nothing to claim either. *@
        @if (TaskStore.Value is { LoadRequested: true, Loading: false } && string.IsNullOrEmpty(TaskStore.Value.Error))
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                         Wrap="FlexWrap.Wrap" class="rz-p-4" data-testid="tasks-empty">
                <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">No tasks yet.</RadzenText>
                <RadzenButton Text="New task" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                              Size="ButtonSize.Small" Click="@OpenCreateDialog"/>
            </RadzenStack>
        }
    </EmptyTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="TaskDto" Property="Title" Title="Title">
            <Template Context="task">
                @if (!string.IsNullOrEmpty(task.Title))
                {
                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 500; margin: 0;">@task.Title</RadzenText>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        @task.Id.ToString()[..8]...
                    </RadzenText>
                }
                @if (_phone)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                 Wrap="FlexWrap.Wrap" class="rz-mt-1">
                        @StatusCell(task)
                        @PullRequestCell(task)
                    </RadzenStack>
                    <div class="rz-mt-2">@ActionsCell(task)</div>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Title="Project" Width="@Px(ProjectWidth)" Sortable="false" Visible="@(!_phone)">
            <Template Context="task">@ProjectName(task)</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Status" Title="Status" Width="@Px(StatusWidth)" Visible="@(!_phone)">
            <Template Context="task">@StatusCell(task)</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Title="Pull request" Width="@Px(PullRequestWidth)" Sortable="false"
                              Visible="@(!_phone)">
            <Template Context="task">@PullRequestCell(task)</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Priority" Title="Priority" Width="@Px(PriorityWidth)" Visible="@_desktop">
            <Template Context="task">
                <RadzenBadge Text="@GetPriorityName(task.Priority)" BadgeStyle="@GetPriorityBadgeStyle(task.Priority)"
                             Variant="Variant.Outlined" Shade="Shade.Darker"/>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="CreatedAt" Title="Created" Width="@Px(CreatedWidth)" Visible="@_desktop">
            <Template Context="task">@LocalTimes.ShortDateTime(task.CreatedAt)</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Title="Actions" Width="@Px(ActionsWidth)" Sortable="false" Filterable="false"
                              Visible="@(!_phone)">
            <Template Context="task">@ActionsCell(task)</Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
</div>

@code {
    // Radzen lays the grid out as a fixed table: each column's width is its <col>, and Title, which has none, gets what
    // the others leave. The grid is never narrower than the shown columns plus Title's minimum, and scrolls inside its
    // wrapper when the page is narrower than that.
    private const int TitleMinWidth = 200;
    private const int ProjectWidth = 160;
    private const int StatusWidth = 170;
    private const int PullRequestWidth = 120;
    private const int PriorityWidth = 110;
    private const int CreatedWidth = 160;
    private const int ActionsWidth = 230;

    private readonly CancellationTokenSource _cts = new();

    /// <summary>Whether the viewport is desktop width, 1280px or more: Priority and Created are shown.</summary>
    private bool _desktop = true;

    /// <summary>Whether the viewport is a phone's, below 768px: the grid is one column.</summary>
    private bool _phone;

    /// <summary>Why the last Create and manufacture could not start its run, for the board's alert; null when none.</summary>
    private string? _manufactureRefused;

    /// <summary>
    ///     Whether the user may start a run, so the rows offer Manufacture: the manufacture endpoint needs the developer
    ///     or admin role. Decided for each authentication state, so it follows a change of roles.
    /// </summary>
    private bool _canStart;

    private Task<AuthenticationState>? _evaluated;

    /// <summary>The signed-in user. <c>AddCascadingAuthenticationState</c> always provides it.</summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private int MinGridWidth =>
        TitleMinWidth + ProjectWidth + StatusWidth + PullRequestWidth + ActionsWidth
        + (_desktop ? PriorityWidth + CreatedWidth : 0);

    /// <summary>A phone's one column fits the screen; wider, the grid keeps its columns and scrolls in its wrapper.</summary>
    private string GridStyle => _phone ? "height: auto;" : $"height: auto; min-width: {MinGridWidth}px;";

    /// <summary>The task's status: its run's badge, linking to the run when it has one.</summary>
    private static RenderFragment StatusCell(TaskDto task) =>
        @<text>
            @if (task.WorkflowRunId is { } runId)
            {
                <a href="@($"runs/{runId}")" aria-label="@($"Open run, {TaskStatusLabels.BadgeText(task)}")">
                    <RunStatusBadge Status="@(task.RunStatus ?? "")" AwaitingSignal="@task.AwaitingSignal" NoRunText="@TaskStatusLabels.NoRunText(task)"/>
                </a>
            }
            else
            {
                <RunStatusBadge Status="@(task.RunStatus ?? "")" AwaitingSignal="@task.AwaitingSignal" NoRunText="@TaskStatusLabels.NoRunText(task)"/>
            }
        </text>;

    /// <summary>The task's pull request: a "#N" link, or a dash.</summary>
    private static RenderFragment PullRequestCell(TaskDto task) =>
        @<text>
            @if (TaskStatusLabels.PullRequestHref(task) is { } href)
            {
                <a href="@href" target="_blank" rel="noopener" data-testid="task-pr"
                   aria-label="@($"Pull request {TaskStatusLabels.PullRequestText(task)}")">@TaskStatusLabels.PullRequestText(task)</a>
            }
            else
            {
                <span data-testid="task-pr">—</span>
            }
        </text>;

    /// <summary>Edit, Manufacture when the task can start and the user may start a run, and Delete.</summary>
    private RenderFragment ActionsCell(TaskDto task) =>
        @<RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => OpenEditDialog(task))" title="Edit task" aria-label="Edit task"/>
            @if (_canStart && TaskStatusLabels.IsStartable(task))
            {
                <RadzenButton Icon="precision_manufacturing" Text="Manufacture" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Success" Shade="Shade.Darker" Disabled="@TaskStore.Value.Starting.Contains(task.Id)"
                              Click="@(() => ManufactureTask(task))" title="Manufacture" aria-label="Manufacture"/>
            }
            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                          Click="@(() => DeleteTask(task))" title="Delete task" aria-label="Delete task"/>
        </RadzenStack>;

    private static string Px(int width) => string.Create(CultureInfo.InvariantCulture, $"{width}px");

    private string ProjectName(TaskDto task) =>
        ProjectStore.Value.Names.TryGetValue(task.ProjectId, out var name) ? name : "—";

    protected override void SubscribeStores()
    {
        Subscribe(TaskStore);
        Subscribe(ProjectStore);
    }

    /// <summary>
    ///     The media queries report only after the first render, which would draw the grid for the wrong width for a
    ///     frame. In the browser the width can be read at once, as MainLayout reads it; without the helper the queries
    ///     set the layout once they report.
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Js is IJSInProcessRuntime browser)
        {
            try
            {
                var width = browser.Invoke<double>("daedalusViewportWidth");
                _phone = width < PhoneBelow;
                _desktop = width >= DesktopFrom;
            }
            catch (JSException)
            {
                // A page without the helper, such as a stale cached index.html: the media queries decide.
            }
        }
    }

    /// <summary>The width a phone's viewport stays below, as the phone query reads it.</summary>
    private const double PhoneBelow = 768;

    /// <summary>The width from which Priority and Created show, as the desktop query reads it.</summary>
    private const double DesktopFrom = 1280;

    protected override async Task OnInitializedAsync()
    {
        // The projects are shared and never cleared, so the board re-reads them on every open. Started first, alongside
        // the board, so the load is marked before anything renders and the create dialog waits for its answer.
        // Awaited together, so a fault in either load is observed.
        await Task.WhenAll(ProjectsEffects.LoadAsync(_cts.Token), Effects.LoadAsync(_cts.Token));
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (AuthenticationState is not { } state || ReferenceEquals(state, _evaluated))
        {
            return;
        }

        _evaluated = state;
        var user = (await state).User;
        if (ReferenceEquals(state, _evaluated))
        {
            _canStart = RunAccess.CanStart(user);
        }
    }

    private Task LoadTasks() => Effects.LoadAsync(_cts.Token);

    /// <summary>
    ///     Opens the create dialog, which Radzen shows full width on a phone. Create reloads the board, with the new task on top; Create and
    ///     manufacture opens the run it started, or, when the start was refused, reloads the board and says why.
    /// </summary>
    private async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<TaskCreateDialog>("Create New Task",
            options: new DialogOptions { Width = "700px", AutoFocusFirstElement = false });

        if (result is not TaskCreateOutcome outcome)
        {
            return;
        }

        if (outcome.RunId is { } runId)
        {
            Navigation.NavigateTo($"runs/{runId}");
            return;
        }

        _manufactureRefused = outcome.ManufactureRefusal is { } reason && !SessionExpiry.IsSigningIn(reason)
            ? $"The task was created, but manufacture was refused: {reason}"
            : null;
        await LoadTasks();
    }

    private async Task OpenEditDialog(TaskDto task)
    {
        var result = await DialogService.OpenAsync<TaskEditDialog>("Edit Task",
            new Dictionary<string, object> { { "Task", task } },
            new DialogOptions { Width = "700px" });

        if (result is bool confirmed2 && confirmed2)
        {
            await LoadTasks();
        }
    }

    private async Task ManufactureTask(TaskDto task)
    {
        if (TaskStore.Value.Starting.Contains(task.Id))
        {
            return;
        }

        var result = await Effects.ManufactureAsync(task.Id, _cts.Token);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"runs/{result.Value.RunId}");
            return;
        }

        NotificationService.NotifyFailure("Could not start", result.Error);
        await LoadTasks();
    }

    private async Task DeleteTask(TaskDto task)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete task '{task.Title ?? task.Id.ToString()[..8]}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is true)
        {
            var result = await Api.DeleteTaskAsync(task.Id);
            if (result.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Task Deleted");
            }
            else
            {
                NotificationService.NotifyFailure("Error", result.Error);
            }
            await LoadTasks();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new TasksClosed());
    }

    private static string GetPriorityName(int priority)
    {
        return priority switch
        {
            0 => "Low",
            1 => "Medium",
            2 => "High",
            3 => "Critical",
            _ => "Unknown"
        };
    }

    private static BadgeStyle GetPriorityBadgeStyle(int priority)
    {
        return priority switch
        {
            0 => BadgeStyle.Light,
            1 => BadgeStyle.Info,
            2 => BadgeStyle.Warning,
            3 => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }


}