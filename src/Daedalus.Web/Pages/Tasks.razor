@page "/tasks"
@inherits FluxComponent
@inject ApiClient Api
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IStore<TasksState> TaskStore
@inject IDispatcher Dispatcher
@inject TasksEffects Effects
@implements IAsyncDisposable

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Tasks</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.6; margin: 0;">
            Plan work and start manufacture runs
        </RadzenText>
    </RadzenStack>
    <RadzenButton Text="Create Task" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialog"
                  data-testid="btn-create-task"/>
</RadzenStack>

@if (!string.IsNullOrEmpty(TaskStore.Value.Error) && TaskStore.Value.Error != _dismissedError)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4"
                 Close="@(() => _dismissedError = TaskStore.Value.Error)">
        @TaskStore.Value.Error
    </RadzenAlert>
}

<RadzenDataGrid TItem="TaskDto" Data="@TaskStore.Value.Items" Count="@TaskStore.Value.Total" AllowPaging="true" PageSize="15"
                AllowSorting="true" AllowColumnResize="true" PagerHorizontalAlign="HorizontalAlign.Center"
                ShowPagingSummary="true" IsLoading="@TaskStore.Value.Loading" Style="height: auto;" data-testid="tasks-grid">
    <Columns>
        <RadzenDataGridColumn TItem="TaskDto" Property="Title" Title="Title" Width="200px">
            <Template Context="task">
                @if (!string.IsNullOrEmpty(task.Title))
                {
                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 500;">@task.Title</RadzenText>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        @task.Id.ToString()[..8]...
                    </RadzenText>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Status" Title="Status" Width="120px"
                              TextAlign="TextAlign.Center">
            <Template Context="task">
                @if (task.WorkflowRunId is { } runId)
                {
                    <a href="@($"runs/{runId}")" aria-label="@($"Open run, {TaskStatusLabels.Name(task.Status)}")">
                        <RadzenBadge Text="@TaskStatusLabels.Name(task.Status)" BadgeStyle="@TaskStatusLabels.Style(task.Status)"/>
                    </a>
                }
                else
                {
                    <RadzenBadge Text="@TaskStatusLabels.Name(task.Status)" BadgeStyle="@TaskStatusLabels.Style(task.Status)"/>
                }
                @if (TaskStatusLabels.PullRequestHref(task) is { } pullRequestHref)
                {
                    <RadzenLink Path="@pullRequestHref" Text="PR" Target="_blank" title="Pull request" data-testid="task-pr-link" Style="margin-left: 0.5rem;"/>
                }
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Priority" Title="Priority" Width="100px"
                              TextAlign="TextAlign.Center">
            <Template Context="task">
                <RadzenBadge Text="@GetPriorityName(task.Priority)" BadgeStyle="@GetPriorityBadgeStyle(task.Priority)"
                             Variant="Variant.Outlined"/>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Phase" Title="Phase" Width="120px">
            <Template Context="task">
                @(string.IsNullOrEmpty(task.Phase) ? "—" : task.Phase)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="IterationCount" Title="Iterations" Width="110px"
                              TextAlign="TextAlign.Center">
            <Template Context="task">
                <RadzenText TextStyle="TextStyle.Body2">@(TaskStatusLabels.HasLoopHistory(task) ? $"{task.IterationCount} / {task.MaxIterations}" : "—")</RadzenText>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="Prompt" Title="Prompt" Width="250px">
            <Template Context="task">
                <RadzenText TextStyle="TextStyle.Caption"
                            Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; display: block;"
                            title="@task.Prompt">
                    @task.Prompt
                </RadzenText>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="TaskDto" Property="CreatedAt" Title="Created" Width="140px" FormatString="{0:g}"/>

        <RadzenDataGridColumn TItem="TaskDto" Title="Actions" Width="180px" TextAlign="TextAlign.Center"
                              Sortable="false" Filterable="false">
            <Template Context="task">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => OpenEditDialog(task))" title="Edit"/>
                    @if (TaskStatusLabels.IsStartable(task))
                    {
                        <RadzenButton Icon="precision_manufacturing" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                      Disabled="@TaskStore.Value.Starting.Contains(task.Id)" Click="@(() => ManufactureTask(task))" title="Manufacture"/>
                    }
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                  Click="@(() => DeleteTask(task))" title="Delete"/>
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private readonly CancellationTokenSource _cts = new();
    private string? _dismissedError;

    protected override void SubscribeStores() => Subscribe(TaskStore);

    protected override async Task OnInitializedAsync() => await Effects.LoadAsync(_cts.Token);

    private Task LoadTasks() => Effects.LoadAsync(_cts.Token);

    private async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<TaskCreateDialog>("Create New Task",
            options: new DialogOptions { Width = "700px", Height = "600px", Resizable = true, Draggable = true });

        if (result is bool confirmed1 && confirmed1)
        {
            await LoadTasks();
        }
    }

    private async Task OpenEditDialog(TaskDto task)
    {
        var result = await DialogService.OpenAsync<TaskEditDialog>("Edit Task",
            new Dictionary<string, object> { { "Task", task } },
            new DialogOptions { Width = "700px", Height = "600px", Resizable = true, Draggable = true });

        if (result is bool confirmed2 && confirmed2)
        {
            await LoadTasks();
        }
    }

    private async Task ManufactureTask(TaskDto task)
    {
        var result = await Effects.ManufactureAsync(task.Id, _cts.Token);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"runs/{result.Value.RunId}");
            return;
        }

        NotificationService.Notify(NotificationSeverity.Error, "Could not start", result.Error);
        await LoadTasks();
    }

    private async Task DeleteTask(TaskDto task)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete task '{task.Title ?? task.Id.ToString()[..8]}'? This cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is true)
        {
            var result = await Api.DeleteTaskAsync(task.Id);
            if (result.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Task Deleted");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", result.Error);
            }
            await LoadTasks();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new TasksClosed());
    }

    private static string GetPriorityName(int priority)
    {
        return priority switch
        {
            0 => "Low",
            1 => "Medium",
            2 => "High",
            3 => "Critical",
            _ => "Unknown"
        };
    }

    private static BadgeStyle GetPriorityBadgeStyle(int priority)
    {
        return priority switch
        {
            0 => BadgeStyle.Light,
            1 => BadgeStyle.Info,
            2 => BadgeStyle.Warning,
            3 => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }


}