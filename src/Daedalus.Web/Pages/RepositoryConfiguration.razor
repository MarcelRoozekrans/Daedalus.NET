@page "/repositories"
@attribute [Authorize]
@using System.Net
@using System.Text.Json
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService
@implements IDisposable

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Git Repositories</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
            Configure the repositories projects link to.
        </RadzenText>
    </RadzenStack>
    @if (!_forbidden)
    {
        <RadzenButton Text="Add Repository" Icon="add" Click="@ShowAddForm"
                      ButtonStyle="ButtonStyle.Primary"/>
    }
</RadzenStack>

@if (_isLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                               Style="display: block; margin: 3rem auto;"/>
}
else if (_forbidden)
{
    @* The API refuses everyone but an admin. A refusal is not an empty list, so it says so, and offers nothing to add. *@
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false" data-testid="repositories-forbidden">
        Git repositories are managed by admins.
    </RadzenAlert>
}
else if (_loadError is { } loadError)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="repositories-error">
        The repositories could not be loaded: @loadError
        <RadzenButton Text="Retry" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@LoadRepositories"/>
    </RadzenAlert>
}
else if (_repositories is { Count: 0 })
{
    <div class="empty-state">
        <RadzenIcon Icon="source" Style="font-size: 3rem; opacity: 0.3;"/>
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0.5rem 0 0.25rem;">No Repositories Configured</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin-bottom: 1rem;">
            Add a git repository to get started with code analysis.
        </RadzenText>
        <RadzenButton Text="Add Repository" Icon="add" Click="@ShowAddForm"
                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"/>
    </div>
}
else if (_repositories is not null)
{
    @* Null with no error is a read whose session ended: the layout's notice says so, and sign-in is under way. *@
    <RadzenRow Gap="1rem">
        @foreach (var repo in _repositories)
        {
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@repo.Name</RadzenText>
                        <RadzenBadge Text="@(repo.IsActive ? "Active" : "Inactive")"
                                     BadgeStyle="@(repo.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"/>
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Repository URL</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2"
                                Style="font-family: monospace; word-break: break-all; margin-bottom: 0.75rem;">
                        @repo.Url
                    </RadzenText>

                    <RadzenRow Gap="0.5rem" class="rz-mb-3">
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Platform</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@repo.Platform</RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Default Branch</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@repo.DefaultBranch</RadzenText>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (!string.IsNullOrEmpty(repo.Description))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Description</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">@repo.Description</RadzenText>
                    }

                    <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.4;">
                        Added @LocalTimes.ShortDateTime(repo.CreatedAt)
                    </RadzenText>

                    <hr style="opacity: 0.1; margin: 0.75rem 0;"/>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Info"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => EditRepository(repo))"/>
                        <RadzenButton Text="Test" Icon="sync" ButtonStyle="ButtonStyle.Warning"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => TestConnection(repo.Id))"/>
                        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => ConfirmDelete(repo.Id))"/>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    private List<RepositoryConfigurationDto>? _repositories;
    private bool _isLoading = true;

    /// <summary>Whether the API refused the read, 403: the user is not an admin.</summary>
    private bool _forbidden;

    /// <summary>Why the read failed, for any failure but a refusal or an ended session; null when it did not.</summary>
    private string? _loadError;

    /// <summary>Cancelled when the page goes, so a read still running stops with it.</summary>
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositories();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadRepositories()
    {
        _isLoading = true;
        _forbidden = false;
        _loadError = null;
        _repositories = null;
        // Read before any await: once the page is gone its token source is disposed.
        var ct = _cts.Token;
        try
        {
            using var response = await Http.GetAsync("api/repositories", ct);
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _forbidden = true;
            }
            else if (!response.IsSuccessStatusCode)
            {
                _loadError = $"The server answered {HttpStatusText.Of(response)}.";
            }
            else
            {
                _repositories = await response.Content.ReadFromJsonAsync<List<RepositoryConfigurationDto>>(ct) ?? [];
            }
        }
        catch (Exception ex) when (SessionExpiry.IsSigningIn(ex))
        {
            // The session ended: the layout's one notice says so, and the page shows nothing of its own.
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The page went: the read stopped with it, and there is nothing to show.
        }
        catch (TaskCanceledException)
        {
            // Not cancelled by the page, so the client's timeout ran out.
            _loadError = "The request timed out.";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or NotSupportedException)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowAddForm()
    {
        var repo = new RepositoryConfigurationDto
        {
            Id = Guid.NewGuid(),
            Platform = "GitHub",
            DefaultBranch = "main"
        };

        var result = await DialogService.OpenAsync<RepositoryForm>("Add Repository",
            new Dictionary<string, object> { { "Repository", repo }, { "IsEditing", false } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true });

        if (result is bool resultValue && resultValue)
        {
            try
            {
                var createDto = new CreateRepositoryConfigurationDto
                {
                    Name = repo.Name,
                    Url = repo.Url,
                    Platform = repo.Platform,
                    DefaultBranch = repo.DefaultBranch,
                    AuthenticationMethod = repo.AuthenticationMethod,
                    CredentialIdentifier = repo.CredentialIdentifier,
                    Description = repo.Description
                };
                using var response = await Http.PostAsJsonAsync("api/repositories", createDto);
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Created", "Repository added successfully.");
                }
                else
                {
                    NotificationService.NotifyFailure("Error", Refused("Failed to create repository.", response));
                }

                await LoadRepositories();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyFailure("Error", ex, "Failed to create repository.");
            }
        }
    }

    private async Task EditRepository(RepositoryConfigurationDto repo)
    {
        var editCopy = new RepositoryConfigurationDto
        {
            Id = repo.Id,
            Name = repo.Name,
            Url = repo.Url,
            Platform = repo.Platform,
            DefaultBranch = repo.DefaultBranch,
            AuthenticationMethod = repo.AuthenticationMethod,
            CredentialIdentifier = repo.CredentialIdentifier,
            IsActive = repo.IsActive,
            Description = repo.Description
        };

        var result = await DialogService.OpenAsync<RepositoryForm>("Edit Repository",
            new Dictionary<string, object> { { "Repository", editCopy }, { "IsEditing", true } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true });

        if (result is bool resultValue && resultValue)
        {
            try
            {
                var updateDto = new UpdateRepositoryConfigurationDto
                {
                    Name = editCopy.Name,
                    Url = editCopy.Url,
                    DefaultBranch = editCopy.DefaultBranch,
                    AuthenticationMethod = editCopy.AuthenticationMethod,
                    CredentialIdentifier = editCopy.CredentialIdentifier,
                    IsActive = editCopy.IsActive,
                    Description = editCopy.Description
                };
                using var response = await Http.PutAsJsonAsync($"api/repositories/{editCopy.Id}", updateDto);
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Updated", "Repository updated successfully.");
                }
                else
                {
                    NotificationService.NotifyFailure("Error", Refused("Failed to update repository.", response));
                }

                await LoadRepositories();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyFailure("Error", ex, "Failed to update repository.");
            }
        }
    }

    private async Task TestConnection(Guid id)
    {
        try
        {
            using var response = await Http.PostAsync($"api/repositories/{id}/test-connection", null);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Connection test passed.");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Failed", "Connection test failed.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.NotifyFailure("Error", ex, "Could not test connection.");
        }
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this repository configuration? This action cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                using var response = await Http.DeleteAsync($"api/repositories/{id}");
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Repository removed.");
                }
                else
                {
                    NotificationService.NotifyFailure("Error", Refused("Failed to delete repository.", response));
                }

                await LoadRepositories();
            }
            catch (Exception ex)
            {
                NotificationService.NotifyFailure("Error", ex, "Failed to delete repository.");
            }
        }
    }

    /// <summary>A refused write's message: what failed and the status the API answered with.</summary>
    private static string Refused(string what, HttpResponseMessage response) =>
        $"{what} The server answered {HttpStatusText.Of(response)}.";
}
