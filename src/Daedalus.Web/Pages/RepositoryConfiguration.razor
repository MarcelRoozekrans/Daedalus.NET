@page "/repositories"
@using Daedalus.Application.DTOs
@inject HttpClient Http
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Git Repositories</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.6; margin: 0;">
            Manage your git repositories for Ralph Loop analysis
        </RadzenText>
    </RadzenStack>
    <RadzenButton Text="Add Repository" Icon="add" Click="@ShowAddForm"
                  ButtonStyle="ButtonStyle.Primary"/>
</RadzenStack>

@if (_isLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                               Style="display: block; margin: 3rem auto;"/>
}
else if (_repositories == null || _repositories.Count == 0)
{
    <div class="empty-state">
        <RadzenIcon Icon="source" Style="font-size: 3rem; opacity: 0.3;"/>
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0.5rem 0 0.25rem;">No Repositories Configured</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin-bottom: 1rem;">
            Add a git repository to get started with code analysis.
        </RadzenText>
        <RadzenButton Text="Add Repository" Icon="add" Click="@ShowAddForm"
                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"/>
    </div>
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (var repo in _repositories)
        {
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@repo.Name</RadzenText>
                        <RadzenBadge Text="@(repo.IsActive ? "Active" : "Inactive")"
                                     BadgeStyle="@(repo.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"/>
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Repository URL</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2"
                                Style="font-family: monospace; word-break: break-all; margin-bottom: 0.75rem;">
                        @repo.Url
                    </RadzenText>

                    <RadzenRow Gap="0.5rem" class="rz-mb-3">
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Platform</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@repo.Platform</RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Default Branch</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@repo.DefaultBranch</RadzenText>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (!string.IsNullOrEmpty(repo.Description))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">Description</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">@repo.Description</RadzenText>
                    }

                    <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.4;">
                        Added @repo.CreatedAt.ToLocalTime().ToString("g")
                    </RadzenText>

                    <hr style="opacity: 0.1; margin: 0.75rem 0;"/>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Info"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => EditRepository(repo))"/>
                        <RadzenButton Text="Test" Icon="sync" ButtonStyle="ButtonStyle.Warning"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => TestConnection(repo.Id))"/>
                        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => ConfirmDelete(repo.Id))"/>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    private List<RepositoryConfigurationDto>? _repositories;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositories();
    }

    private async Task LoadRepositories()
    {
        _isLoading = true;
        try
        {
            _repositories = await Http.GetFromJsonAsync<List<RepositoryConfigurationDto>>("api/repositories")
                            ?? [];
        }
        catch (Exception)
        {
            _repositories = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowAddForm()
    {
        var repo = new RepositoryConfigurationDto
        {
            Id = Guid.NewGuid(),
            Platform = "GitHub",
            DefaultBranch = "main"
        };

        var result = await DialogService.OpenAsync<RepositoryForm>("Add Repository",
            new Dictionary<string, object> { { "Repository", repo }, { "IsEditing", false } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true });

        if (result is bool resultValue && resultValue)
        {
            try
            {
                var createDto = new CreateRepositoryConfigurationDto
                {
                    Name = repo.Name,
                    Url = repo.Url,
                    Platform = repo.Platform,
                    DefaultBranch = repo.DefaultBranch,
                    AuthenticationMethod = repo.AuthenticationMethod,
                    CredentialIdentifier = repo.CredentialIdentifier,
                    Description = repo.Description
                };
                await Http.PostAsJsonAsync("api/repositories", createDto);
                NotificationService.Notify(NotificationSeverity.Success, "Created", "Repository added successfully.");
                await LoadRepositories();
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to create repository.");
            }
        }
    }

    private async Task EditRepository(RepositoryConfigurationDto repo)
    {
        var editCopy = new RepositoryConfigurationDto
        {
            Id = repo.Id,
            Name = repo.Name,
            Url = repo.Url,
            Platform = repo.Platform,
            DefaultBranch = repo.DefaultBranch,
            AuthenticationMethod = repo.AuthenticationMethod,
            CredentialIdentifier = repo.CredentialIdentifier,
            IsActive = repo.IsActive,
            Description = repo.Description
        };

        var result = await DialogService.OpenAsync<RepositoryForm>("Edit Repository",
            new Dictionary<string, object> { { "Repository", editCopy }, { "IsEditing", true } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true });

        if (result is bool resultValue && resultValue)
        {
            try
            {
                var updateDto = new UpdateRepositoryConfigurationDto
                {
                    Name = editCopy.Name,
                    Url = editCopy.Url,
                    DefaultBranch = editCopy.DefaultBranch,
                    AuthenticationMethod = editCopy.AuthenticationMethod,
                    CredentialIdentifier = editCopy.CredentialIdentifier,
                    IsActive = editCopy.IsActive,
                    Description = editCopy.Description
                };
                await Http.PutAsJsonAsync($"api/repositories/{editCopy.Id}", updateDto);
                NotificationService.Notify(NotificationSeverity.Success, "Updated", "Repository updated successfully.");
                await LoadRepositories();
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to update repository.");
            }
        }
    }

    private async Task TestConnection(Guid id)
    {
        try
        {
            var response = await Http.PostAsync($"api/repositories/{id}/test-connection", null);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Connection test passed.");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Failed", "Connection test failed.");
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Could not test connection.");
        }
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this repository configuration? This action cannot be undone.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await Http.DeleteAsync($"api/repositories/{id}");
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Repository removed.");
                await LoadRepositories();
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to delete repository.");
            }
        }
    }
}
