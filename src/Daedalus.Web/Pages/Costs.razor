@page "/costs"
@attribute [Authorize]
@inherits FluxComponent
@implements IAsyncDisposable
@inject IStore<CostsState> CostsStore
@inject IDispatcher Dispatcher
@inject CostsEffects CostsEffects

<RadzenStack Gap="0.25rem" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Cost Analytics</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
        Token usage across manufacture runs, chat, scheduled runs and the retired task loop's history
    </RadzenText>
</RadzenStack>

@if (!string.IsNullOrEmpty(View.Error))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4">
        @View.Error
    </RadzenAlert>
}

<RadzenRow Gap="1rem" class="rz-mb-6" data-testid="cost-stats-row">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard data-testid="stat-total-tokens">
            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@FormatNumber((View.Summary?.TotalInputTokens ?? 0) + (View.Summary?.TotalOutputTokens ?? 0))</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Total Tokens</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard data-testid="stat-total-cost">
            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@FormatCurrency(View.Summary?.TotalCost ?? 0)</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Priced Cost</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard data-testid="stat-cache-read">
            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@FormatNumber(View.Summary?.TotalCacheReadTokens ?? 0)</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Cache Read Tokens (manufacture)</RadzenText>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard data-testid="stat-total-entries">
            <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@FormatNumber(View.Summary?.TotalEntries ?? 0)</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Recorded Entries</RadzenText>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@if (View.Summary is { UnreadableRecords: > 0 } unreadable)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" class="rz-mb-4" data-testid="cost-unreadable">
        @unreadable.UnreadableRecords node-usage record(s) could not be read and are not in these figures.
    </RadzenAlert>
}

<RadzenRow Gap="1rem" class="rz-mb-6">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard data-testid="cost-by-source">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">By Source</RadzenText>
            <RadzenDataGrid Data="@(View.Summary?.BySource ?? [])" TItem="CostSliceDto" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="Key" Title="Source"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="InputTokens" Title="Input" FormatString="{0:N0}"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="OutputTokens" Title="Output" FormatString="{0:N0}"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="CacheReadTokens" Title="Cache Read" FormatString="{0:N0}"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="Cost" Title="Cost" FormatString="{0:C4}"/>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard data-testid="cost-by-model">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">By Model</RadzenText>
            <RadzenDataGrid Data="@(View.Summary?.ByModel ?? [])" TItem="CostSliceDto" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="Key" Title="Model"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="InputTokens" Title="Input" FormatString="{0:N0}"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="OutputTokens" Title="Output" FormatString="{0:N0}"/>
                    <RadzenDataGridColumn TItem="CostSliceDto" Property="Cost" Title="Cost" FormatString="{0:C4}"/>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenCard class="rz-mb-6" data-testid="cost-by-day">
    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">By Day (UTC)</RadzenText>
    <RadzenDataGrid Data="@(View.Summary?.ByDay ?? [])" TItem="CostDayDto" Density="Density.Compact" AllowPaging="true" PageSize="14">
        <Columns>
            <RadzenDataGridColumn TItem="CostDayDto" Property="Day" Title="Day"/>
            <RadzenDataGridColumn TItem="CostDayDto" Property="Source" Title="Source"/>
            <RadzenDataGridColumn TItem="CostDayDto" Property="InputTokens" Title="Input" FormatString="{0:N0}"/>
            <RadzenDataGridColumn TItem="CostDayDto" Property="OutputTokens" Title="Output" FormatString="{0:N0}"/>
            <RadzenDataGridColumn TItem="CostDayDto" Property="Cost" Title="Cost" FormatString="{0:C4}"/>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@if (View.Summary is { } summary)
{
    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-6" Style="display: block; opacity: 0.7;" data-testid="cost-scope">
        @summary.Scope
    </RadzenText>
}

<RadzenRow Gap="1rem" class="rz-mb-6">
    <RadzenColumn Size="12" SizeMD="5">
        <RadzenCard data-testid="cost-estimator">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">Cost Estimator</RadzenText>
            <RadzenStack Gap="0.75rem">
                <div>
                    <RadzenLabel Text="Model" Component="ModelSelect"/>
                    <RadzenDropDown TValue="string" Value="@View.Estimator.ModelId" Data="View.Pricing" TextProperty="DisplayName" ValueProperty="ModelId"
                                    Style="width: 100%;" Name="ModelSelect"
                                    ValueChanged="@((string modelId) => EstimateAsync(View.Estimator with { ModelId = modelId }))"/>
                </div>
                <div>
                    <RadzenLabel Text="Turns" Component="Turns"/>
                    <RadzenNumeric TValue="int" Value="@View.Estimator.Turns" Min="1" Max="100" Style="width: 100%;" Name="Turns"
                                   ValueChanged="@((int turns) => EstimateAsync(View.Estimator with { Turns = turns }))"/>
                </div>
                <div>
                    <RadzenLabel Text="Estimated Prompt Tokens per Turn" Component="PromptTokens"/>
                    <RadzenNumeric TValue="int" Value="@View.Estimator.PromptTokens" Min="100" Max="100000" Style="width: 100%;" Name="PromptTokens"
                                   ValueChanged="@((int tokens) => EstimateAsync(View.Estimator with { PromptTokens = tokens }))"/>
                </div>
                @if (View.Estimate is { } estimate)
                {
                    <RadzenCard Style="background: var(--rz-base-200);">
                        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0; color: var(--rz-success);">
                            @FormatCurrency(estimate.EstimatedMinCost) — @FormatCurrency(estimate.EstimatedMaxCost)
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.6; margin: 0.25rem 0 0 0;">
                            Based on @estimate.EstimatedResponseTokens average output tokens per turn
                        </RadzenText>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="7">
        <RadzenCard data-testid="model-pricing">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">Model Pricing</RadzenText>
            <RadzenDataGrid Data="View.Pricing" TItem="ModelPricingDto" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ModelPricingDto" Property="DisplayName" Title="Model"/>
                    <RadzenDataGridColumn TItem="ModelPricingDto" Property="InputPricePerMillion" Title="Input $/1M" FormatString="{0:C2}"/>
                    <RadzenDataGridColumn TItem="ModelPricingDto" Property="OutputPricePerMillion" Title="Output $/1M" FormatString="{0:C2}"/>
                    <RadzenDataGridColumn TItem="ModelPricingDto" Property="CacheReadPricePerMillion" Title="Cache read $/1M" FormatString="{0:C3}"/>
                    <RadzenDataGridColumn TItem="ModelPricingDto" Property="CacheWritePricePerMillion" Title="Cache write $/1M" FormatString="{0:C3}"/>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenCard data-testid="project-costs">
    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-1">Task Loop History by Project</RadzenText>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-4" Style="display: block; opacity: 0.7;">
        Read-only: iterations of the task loop retired in phase 2.8. Manufacture runs are in the source table above.
    </RadzenText>
    <RadzenDataGrid Data="View.Projects" TItem="ProjectCostDto" AllowSorting="true" RowExpand="@OnRowExpand" ExpandMode="DataGridExpandMode.Single">
        <Template Context="project">
            <RadzenDataGrid Data="@GetTaskCosts(project.ProjectId)" TItem="TaskCostDto" Density="Density.Compact" Style="margin: 0.5rem 1rem;">
                <Columns>
                    <RadzenDataGridColumn TItem="TaskCostDto" Property="TaskTitle" Title="Task"/>
                    <RadzenDataGridColumn TItem="TaskCostDto" Property="InputTokens" Title="Input Tokens" FormatString="{0:N0}" Width="120px"/>
                    <RadzenDataGridColumn TItem="TaskCostDto" Property="OutputTokens" Title="Output Tokens" FormatString="{0:N0}" Width="120px"/>
                    <RadzenDataGridColumn TItem="TaskCostDto" Property="EstimatedCost" Title="Cost" FormatString="{0:C4}" Width="100px"/>
                    <RadzenDataGridColumn TItem="TaskCostDto" Property="IterationCount" Title="Iterations" Width="100px"/>
                </Columns>
            </RadzenDataGrid>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="ProjectCostDto" Property="ProjectName" Title="Project"/>
            <RadzenDataGridColumn TItem="ProjectCostDto" Property="InputTokens" Title="Input Tokens" FormatString="{0:N0}" Width="130px"/>
            <RadzenDataGridColumn TItem="ProjectCostDto" Property="OutputTokens" Title="Output Tokens" FormatString="{0:N0}" Width="130px"/>
            <RadzenDataGridColumn TItem="ProjectCostDto" Property="EstimatedCost" Title="Total Cost" FormatString="{0:C4}" Width="120px"/>
            <RadzenDataGridColumn TItem="ProjectCostDto" Property="ExecutionCount" Title="Iterations" Width="110px"/>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    /// <summary>Cancelled when the page goes, so a read still running stops with it.</summary>
    private readonly CancellationTokenSource _cts = new();

    /// <summary>The page's token, read once: it stays readable after the source is disposed.</summary>
    private CancellationToken _token;

    private CostsState View => CostsStore.Value;

    protected override void SubscribeStores() => Subscribe(CostsStore);

    protected override async Task OnInitializedAsync()
    {
        _token = _cts.Token;
        await CostsEffects.LoadAsync(_token);
    }

    /// <summary>Asks for the estimate of the estimator's new inputs: a model, turns or prompt tokens changed.</summary>
    private Task EstimateAsync(CostEstimator estimator) => CostsEffects.EstimateAsync(estimator, _token);

    /// <summary>Reads the expanded project's tasks, once.</summary>
    private Task OnRowExpand(ProjectCostDto project) => CostsEffects.LoadTaskCostsAsync(project.ProjectId, _token);

    private IReadOnlyList<TaskCostDto> GetTaskCosts(Guid projectId) =>
        View.TaskCosts.TryGetValue(projectId, out var tasks) ? tasks : [];

    private static string FormatNumber(long number) => number switch
    {
        >= 1_000_000 => $"{number / 1_000_000.0:F1}M",
        >= 1_000 => $"{number / 1_000.0:F1}K",
        _ => number.ToString("N0")
    };

    private static string FormatCurrency(decimal amount) => amount.ToString("C2");

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new CostsClosed());
    }
}
