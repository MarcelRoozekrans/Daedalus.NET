@page "/"
@inject ApiClient Api
@inject NavigationManager Nav
@implements IAsyncDisposable

<RadzenStack Gap="0.25rem" class="rz-mb-4" data-testid="home-title">
    <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Dashboard</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.6; margin: 0;">
        Task and project overview
    </RadzenText>
</RadzenStack>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4">
        @_errorMessage
    </RadzenAlert>
}

<RadzenRow Gap="1rem" class="rz-mb-6" data-testid="stats-row">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Style="cursor: pointer;" data-testid="stat-total-tasks" @onclick="@(() => Nav.NavigateTo("tasks"))">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <div class="stat-icon" style="background: linear-gradient(135deg, var(--rz-primary), var(--rz-primary-dark));">
                    <RadzenIcon Icon="task_alt"/>
                </div>
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@_tasksCount</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Total Tasks</RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Style="cursor: pointer;" data-testid="stat-projects" @onclick="@(() => Nav.NavigateTo("projects"))">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <div class="stat-icon" style="background: linear-gradient(135deg, var(--rz-info), var(--rz-info-dark));">
                    <RadzenIcon Icon="folder_special"/>
                </div>
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@_projectsCount</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">Total Projects</RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard data-testid="quick-actions">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4">
                <RadzenIcon Icon="rocket_launch"/>
                Quick Actions
            </RadzenText>
            <RadzenStack Gap="0.5rem">
                <RadzenButton Text="Create New Task" Icon="add_task" ButtonStyle="ButtonStyle.Primary"
                              Style="width: 100%;" Click="@(() => Nav.NavigateTo("tasks"))"/>
                <RadzenButton Text="View Costs" Icon="attach_money" ButtonStyle="ButtonStyle.Secondary"
                              Style="width: 100%;" Click="@(() => Nav.NavigateTo("costs"))"/>
                <RadzenButton Text="Generate PRD" Icon="auto_awesome" ButtonStyle="ButtonStyle.Info"
                              Style="width: 100%;" Click="@(() => Nav.NavigateTo("prd-generator"))"/>
                <RadzenButton Text="Manage Projects" Icon="folder_special" ButtonStyle="ButtonStyle.Success"
                              Style="width: 100%;" Click="@(() => Nav.NavigateTo("projects"))"/>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private int _tasksCount;
    private int _projectsCount;
    private string _errorMessage = "";
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadStatistics(_cts.Token);
    }

    private async Task LoadStatistics(CancellationToken ct)
    {
        try
        {
            var tasksResult = await Api.GetTasksAsync(1, 1, ct);
            _tasksCount = tasksResult.IsSuccess ? tasksResult.Value.Total : 0;

            var projectsResult = await Api.GetProjectsAsync(1, 1, ct);
            _projectsCount = projectsResult.IsSuccess ? projectsResult.Value.Total : 0;
        }
        catch (OperationCanceledException)
        {
            // Silently ignore cancellation
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading statistics: {ex.Message}";
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }
    }

}
