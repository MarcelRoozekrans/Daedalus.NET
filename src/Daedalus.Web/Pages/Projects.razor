@page "/projects"
@attribute [Authorize]
@inherits FluxComponent
@implements IAsyncDisposable
@inject IStore<ProjectsState> ProjectStore
@inject IDispatcher Dispatcher
@inject ProjectsEffects ProjectsEffects
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Projects</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
            Manage your code analysis projects
        </RadzenText>
    </RadzenStack>
    <RadzenButton Text="Create Project" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialog"
                  Style="white-space: nowrap;" data-testid="btn-create-project"/>
</RadzenStack>

@* ProjectsEffects stores no SigningInAgain failure, so this alert needs no sign-in check. *@
@if (ProjectStore.Value.Error is { } error)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4">
        @error
    </RadzenAlert>
}

@* The spinner is for the page's own loads only: a background refresh, such as a reconnect's, keeps the list showing.
   Current, not Projects: a failed load shows the empty state, as the page always did, never a list held from before. *@
@if (ProjectsView.ShowSpinner(_loading, ProjectStore.Value))
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
}
else if (ProjectStore.Value.Current is { Count: > 0 } projects)
{
    <RadzenDataGrid TItem="ProjectDto" Data="@projects" AllowSorting="true" AllowColumnResize="true"
                    Style="height: auto;" data-testid="projects-grid">
        <Columns>
            <RadzenDataGridColumn TItem="ProjectDto" Property="ProjectName" Title="Name" Width="200px">
                <Template Context="project">
                    <RadzenButton Text="@project.ProjectName" Variant="Variant.Text" ButtonStyle="ButtonStyle.Info"
                                  Size="ButtonSize.Small" Click="@(async () => await SelectProjectAsync(project.Id))"
                                  Style="text-decoration: underline; cursor: pointer;"/>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Property="Description" Title="Description" Width="300px">
                <Template Context="project">
                    <RadzenText TextStyle="TextStyle.Caption"
                                Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 290px; display: block;">
                        @project.Description
                    </RadzenText>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Property="Version" Title="Version" Width="100px"/>
            <RadzenDataGridColumn TItem="ProjectDto" Title="Tasks" Width="80px" TextAlign="TextAlign.Center"
                                  Sortable="false">
                <Template Context="project">
                    <RadzenBadge Text="@project.Tasks.Count.ToString()" BadgeStyle="BadgeStyle.Info"/>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Property="CreatedAt" Title="Created" Width="140px">
                <Template Context="project">@LocalTimes.ShortDateTime(project.CreatedAt)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ProjectDto" Title="Actions" Width="150px" TextAlign="TextAlign.Center"
                                  Sortable="false">
                <Template Context="project">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem"
                                 JustifyContent="JustifyContent.Center">
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => OpenEditDialog(project))" title="Edit"/>
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                      Click="@(() => HandleDeleteAsync(project))" title="Delete"/>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <div class="empty-state">
        <RadzenIcon Icon="folder_open" Style="font-size: 3rem; opacity: 0.3;"/>
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0.5rem 0 0.25rem;">No Projects Yet</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin-bottom: 1rem;">
            Create a project to organize your tasks and code analysis.
        </RadzenText>
        <RadzenButton Text="Create Project" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Outlined" Click="@OpenCreateDialog"/>
    </div>
}

@if (ProjectStore.Value.Selected is { } selected)
{
    <RadzenCard class="rz-mt-6">
        <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">
            @selected.ProjectName — Tasks
        </RadzenText>
        @if (selected.Tasks.Count > 0)
        {
            <RadzenDataGrid TItem="TaskDto" Data="@selected.Tasks" AllowSorting="true" Style="height: auto;">
                <Columns>
                    <RadzenDataGridColumn TItem="TaskDto" Property="Title" Title="Title" Width="200px"/>
                    <RadzenDataGridColumn TItem="TaskDto" Property="Prompt" Title="Prompt" Width="300px">
                        <Template Context="task">
                            <RadzenText TextStyle="TextStyle.Caption" title="@task.Prompt"
                                        Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 290px; display: block;">
                                @task.Prompt
                            </RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskDto" Property="Status" Title="Status" Width="110px"
                                          TextAlign="TextAlign.Center">
                        <Template Context="task">
                            <RunStatusBadge Status="@(task.RunStatus ?? "")" AwaitingSignal="@task.AwaitingSignal" NoRunText="@TaskStatusLabels.NoRunText(task)"/>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskDto" Title="Iterations" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="task">
                            @(TaskStatusLabels.HasLoopHistory(task) ? $"{task.IterationCount} / {task.MaxIterations}" : "—")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TaskDto" Property="CreatedAt" Title="Created" Width="140px">
                        <Template Context="task">@LocalTimes.ShortDateTime(task.CreatedAt)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">No tasks in this
                project.
            </RadzenText>
        }
    </RadzenCard>
}

@code {
    private readonly CancellationTokenSource _cts = new();

    /// <summary>Whether a load this page started is in flight; only that shows the spinner.</summary>
    private bool _loading = true;

    protected override void SubscribeStores() => Subscribe(ProjectStore);

    /// <summary>The projects are shared and never cleared, so the page re-reads them on every open.</summary>
    protected override Task OnInitializedAsync() => LoadProjectsAsync();

    private async Task LoadProjectsAsync()
    {
        _loading = true;
        try
        {
            await ProjectsEffects.LoadAsync(_cts.Token);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectProjectAsync(Guid projectId)
    {
        await ProjectsEffects.LoadSelectedAsync(projectId, _cts.Token);
        // Only for the project asked for last: a later click's failure is that click's to show.
        if (ProjectStore.Value is { SelectedId: var asked, SelectError: { } error } && asked == projectId)
        {
            NotificationService.NotifyFailure("Error", error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<ProjectCreateDialog>("Create New Project",
            options: new DialogOptions { Width = "500px", Resizable = true, Draggable = true });

        if (result is bool confirmed1 && confirmed1)
        {
            await LoadProjectsAsync();
        }
    }

    private async Task OpenEditDialog(ProjectDto project)
    {
        var result = await DialogService.OpenAsync<ProjectEditDialog>("Edit Project",
            new Dictionary<string, object> { { "Project", project } },
            new DialogOptions { Width = "500px", Resizable = true, Draggable = true });

        if (result is bool confirmed2 && confirmed2)
        {
            await LoadProjectsAsync();
            if (ProjectStore.Value.Selected?.Id == project.Id)
                await SelectProjectAsync(project.Id);
        }
    }

    private async Task HandleDeleteAsync(ProjectDto project)
    {
        var confirmed = await DialogService.Confirm(
            $"Delete project '{project.ProjectName}'? All associated tasks will also be deleted.",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is true)
        {
            // The effect stops showing the project if it was shown.
            var outcome = await ProjectsEffects.DeleteAsync(project.Id, _cts.Token);
            if (outcome is { Succeeded: true })
            {
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Project deleted");
                await LoadProjectsAsync();
            }
            else if (outcome is { Refusal: { } refusal })
            {
                NotificationService.NotifyFailure("Error", refusal);
            }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new ProjectsPageClosed());
    }

}
