@page "/authentication/{action}"
@inject IConfiguration Configuration

@* Test mode has no identity provider and no OIDC services for RemoteAuthenticatorView to use; a browser test stops at
   this route and reads where sign-in would return to. *@
@if (_testMode)
{
    <p data-testid="test-sign-in">Sign-in is not available in test mode.</p>
}
else
{
    <RemoteAuthenticatorView Action="@Action"/>
}

@code {
    private bool _testMode;

    [Parameter] public string? Action { get; set; }

    protected override void OnInitialized() =>
        _testMode = string.Equals(Configuration["TestMode"], "true", StringComparison.OrdinalIgnoreCase);
}
