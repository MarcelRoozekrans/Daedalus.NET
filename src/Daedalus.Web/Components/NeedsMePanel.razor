@* The signed-in Home: what needs the person, most urgent first, and one New task button. Its own component, so it loads
   nothing for a visitor who is not signed in, and loads when a sign-in completes after Home rendered. Each card reads
   one bounded page of the run list and fails on its own, through HomeEffects, which also re-fetches the awaiting,
   running and failed cards in the background as runs change. The run list needs the developer or admin role, so anyone
   else gets one line in place of the cards, and no read at all. *@
@inherits FluxComponent
@inject IStore<HomeState> HomeStore
@inject IDispatcher Dispatcher
@inject HomeEffects HomeEffects
@inject DialogService DialogService
@inject ProjectsEffects ProjectsEffects
@inject NavigationManager Nav
@implements IAsyncDisposable

<div data-testid="needs-me">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap" Gap="1rem" class="rz-mb-4">
        <RadzenStack Gap="0.25rem" data-testid="home-title">
            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Home</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
                What needs you, most urgent first
            </RadzenText>
        </RadzenStack>
        <RadzenButton Text="New task" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialogAsync"/>
    </RadzenStack>

    @if (_manufactureRefused is { } refused)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="true" class="rz-mb-4"
                     Close="@(() => _manufactureRefused = null)" data-testid="home-manufacture-refused">
            @refused <RadzenLink Path="tasks" Text="Open Tasks"/>
        </RadzenAlert>
    }

    @if (_canView == false)
    {
        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);"
                    data-testid="needs-me-no-runs">Runs are visible to developers and admins.</RadzenText>
    }
    else if (_canView == true)
    {
        @* One column below 1280px, the contract's tablet and phone widths, in order of urgency; two by two above it. *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeLG="6">
                <NeedsMeCard Title="Awaiting approval" TestId="needs-me-awaiting" EmptyText="@NeedsMe.NothingWaiting(Home.Awaiting.More)"
                             Rows="@Home.Awaiting.Rows" Error="@Home.Awaiting.Error" More="@Home.Awaiting.More"
                             OnRetry="@(() => HomeEffects.RetryAsync(HomeCardKind.Awaiting, _cts.Token))">
                    <Row Context="run">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                            <RadzenStack Gap="0">
                                <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0; font-weight: 500;">@NeedsMe.Name(run)</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);"
                                            title="@($"Waiting since {LocalTimes.ShortDateTime(run.UpdatedAt.UtcDateTime)}")">
                                    waiting @LocalTimes.Elapsed(run.UpdatedAt, Home.ReadAt)
                                </RadzenText>
                            </RadzenStack>
                            <RadzenLink Path="@($"runs/{run.Id}")" Text="Open gate" aria-label="@($"Open gate, {NeedsMe.Name(run)}")"/>
                        </RadzenStack>
                    </Row>
                </NeedsMeCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="6">
                <NeedsMeCard Title="Running" TestId="needs-me-running" EmptyText="@NeedsMe.NothingRunning(Home.Running.More)"
                             Rows="@Home.Running.Rows" Error="@Home.Running.Error" More="@Home.Running.More"
                             OnRetry="@(() => HomeEffects.RetryAsync(HomeCardKind.Running, _cts.Token))">
                    <Row Context="run">
                        <RadzenStack Gap="0">
                            <RadzenLink Path="@($"runs/{run.Id}")" Text="@NeedsMe.Name(run)"/>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);">
                                at @run.CurrentNode
                            </RadzenText>
                        </RadzenStack>
                    </Row>
                </NeedsMeCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="6">
                <NeedsMeCard Title="Failed in the last 7 days" TestId="needs-me-failed" EmptyText="@NeedsMe.NoFailedRuns(Home.Failed.More)"
                             Rows="@Home.Failed.Rows" Error="@Home.Failed.Error" More="@Home.Failed.More"
                             OnRetry="@(() => HomeEffects.RetryAsync(HomeCardKind.Failed, _cts.Token))">
                    <Row Context="run">
                        <RadzenStack Gap="0">
                            <RadzenLink Path="@($"runs/{run.Id}")" Text="@NeedsMe.Name(run)"/>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">@(run.FailureReason ?? "No reason recorded.")</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);"
                                        title="@LocalTimes.ShortDateTime(run.UpdatedAt.UtcDateTime)">
                                failed @LocalTimes.Elapsed(run.UpdatedAt, Home.ReadAt) ago
                            </RadzenText>
                        </RadzenStack>
                    </Row>
                </NeedsMeCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="6">
                <NeedsMeCard Title="Recent pull requests" TestId="needs-me-prs" EmptyText="@NeedsMe.NoPullRequests(Home.PullRequests.More)" ShowCount="false"
                             Rows="@Home.PullRequests.Rows" Error="@Home.PullRequests.Error" More="@Home.PullRequests.More"
                             OnRetry="@(() => HomeEffects.RetryAsync(HomeCardKind.PullRequests, _cts.Token))">
                    <Row Context="run">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">@NeedsMe.Name(run)</RadzenText>
                            <a href="@run.PrUrl" target="_blank" rel="noopener"
                               aria-label="@($"{TaskStatusLabels.PullRequestLabel(run.PrUrl!)}, {NeedsMe.Name(run)}, opens in a new tab")">@TaskStatusLabels.PullRequestText(run.PrUrl!)</a>
                        </RadzenStack>
                    </Row>
                </NeedsMeCard>
            </RadzenColumn>
        </RadzenRow>
    }
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    /// <summary>Why the last Create and manufacture could not start its run; null when none.</summary>
    private string? _manufactureRefused;

    private Task<AuthenticationState>? _evaluated;

    /// <summary>Whether the user may see runs, so the cards; null until the authentication state is read.</summary>
    private bool? _canView;

    /// <summary>
    ///     The signed-in user, replaced whenever the authentication state changes, so Home follows a change of roles.
    ///     <c>AddCascadingAuthenticationState</c> always provides it.
    /// </summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The four cards and when they were last read.</summary>
    private HomeState Home => HomeStore.Value;

    protected override void SubscribeStores() => Subscribe(HomeStore);

    /// <summary>
    ///     Decides access for each new authentication state. A user who becomes a viewer gets the four cards read; one who
    ///     stops being one closes Home, with no read.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not { } state || ReferenceEquals(state, _evaluated))
        {
            return;
        }

        _evaluated = state;
        var user = (await state).User;
        if (!ReferenceEquals(state, _evaluated))
        {
            // A newer state arrived while this one was read; that one decides.
            return;
        }

        var could = _canView;
        _canView = RunAccess.CanView(user);
        if (_canView != could)
        {
            await HomeEffects.LoadAsync(_canView == true, _cts.Token);
        }
    }

    /// <summary>
    ///     Opens the create dialog as Tasks does. The dialog's project picker reads the shared projects, which Home
    ///     re-reads here on every press. Create closes the dialog and stays on Home, with the dialog's "Task created"; the
    ///     task is at the top of Tasks. Create and manufacture opens the run it started, or, when the start was refused,
    ///     says why here.
    /// </summary>
    private async Task OpenCreateDialogAsync()
    {
        _manufactureRefused = null;
        var projects = ProjectsEffects.LoadAsync(_cts.Token);
        var result = await DialogService.OpenAsync<TaskCreateDialog>("Create New Task",
            options: new DialogOptions { Width = "700px", AutoFocusFirstElement = false });
        await projects;

        if (result is not TaskCreateOutcome outcome)
        {
            return;
        }

        if (outcome.RunId is { } runId)
        {
            Nav.NavigateTo($"runs/{runId}");
            return;
        }

        _manufactureRefused = outcome.ManufactureRefusal is { } reason && !SessionExpiry.IsSigningIn(reason)
            ? $"The task was created, but manufacture was refused: {reason}"
            : null;
    }

    /// <summary>Unsubscribes, then closes Home, so a run change no longer re-fetches cards no page shows.</summary>
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new HomeClosed());
    }
}
