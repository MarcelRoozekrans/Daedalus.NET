@inject ProjectsEffects ProjectsEffects
@inject DialogService DialogService
@inject NotificationService NotificationService

@* Each field is named by its label: the form field's Component is the label's for, and the input's Name its id. *@
<RadzenStack Gap="1rem">
    <RadzenFormField Text="Project Name *" Component="ProjectName" Style="width: 100%;">
        <RadzenTextBox Name="ProjectName" @bind-Value="@_projectName" Placeholder="Enter project name" MaxLength="255"/>
    </RadzenFormField>

    <RadzenFormField Text="Description" Component="Description" Style="width: 100%;">
        <RadzenTextArea Name="Description" @bind-Value="@_description" Rows="3" Placeholder="Enter project description" MaxLength="1000"/>
    </RadzenFormField>

    <RadzenFormField Text="Version" Component="Version" Style="width: 100%;">
        <RadzenTextBox Name="Version" @bind-Value="@_version" Placeholder="e.g., 1.0"/>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))"/>
        <RadzenButton Text="Create" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@HandleCreate"
                      IsBusy="@_submitting"/>
    </RadzenStack>
</RadzenStack>

@code {
    private string _projectName = "";
    private string _description = "";
    private string _version = "1.0";
    private bool _submitting;

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_projectName))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Project name is required");
            return;
        }

        _submitting = true;
        try
        {
            var dto = new CreateProjectDto(_projectName.Trim(), _description.Trim(), _version.Trim());
            var outcome = await ProjectsEffects.CreateAsync(dto, CancellationToken.None);
            // Only this write's own outcome. None is a session being renewed: the layout says so, and the dialog stays
            // open, as it did.
            if (outcome is { Succeeded: true })
            {
                NotificationService.Notify(NotificationSeverity.Success, "Success", "Project created");
                DialogService.Close(true);
            }
            else if (outcome is { Refusal: { } refusal })
            {
                NotificationService.NotifyFailure("Error", refusal);
            }
        }
        finally
        {
            _submitting = false;
        }
    }

}
