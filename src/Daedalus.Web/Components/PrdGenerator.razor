@page "/prd-generator"
@attribute [Authorize]
@inherits FluxComponent
@implements IAsyncDisposable
@inject IStore<PrdState> PrdStore
@inject IDispatcher Dispatcher
@inject PrdEffects PrdEffects

<div class="prd-generator">
<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">PRD Generator</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="page-caption" Style="margin: 0;">
            AI-powered requirements to executable tasks
        </RadzenText>
    </RadzenStack>

    <RadzenSteps SelectedIndex="@((int)State.Step)" Style="pointer-events: none;">
        <Steps>
            <RadzenStepsItem Text="Select Project"/>
            <RadzenStepsItem Text="Requirements"/>
            <RadzenStepsItem Text="Review PRD"/>
            <RadzenStepsItem Text="Tasks Created"/>
        </Steps>
    </RadzenSteps>

    @if (State.Step == PrdStep.ProjectSelection)
    {
        <ProjectSelectionStep OnProjectSelected="SelectProjectAsync"/>
    }
    else if (State.Step == PrdStep.RequirementsInput)
    {
        <RequirementsInputStep ProjectId="State.ProjectId" OnRequirementsSubmitted="GenerateAsync"
                               IsLoading="_generating" OnCancel="ResetAsync"/>
    }
    else if (State.Step == PrdStep.PrdReview)
    {
        <PrdReviewStep Prd="State.Prd" OnItemsSelected="ConvertAsync"
                       IsConverting="_converting" OnCancel="ResetAsync"/>
    }
    else if (State.Step == PrdStep.TasksCreated)
    {
        <TasksCreatedStep CreatedTasks="State.CreatedTasks" OnDone="ResetAsync"/>
    }

    @if (State.Error is { } error)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat"
                     AllowClose="true" Close="DismissErrorAsync">
            @error
        </RadzenAlert>
    }
</RadzenStack>
</div>

@code {

    private readonly CancellationTokenSource _cts = new();
    private CancellationToken _token;

    /// <summary>Whether the generate this page asked for is in flight; only that busies the Generate button.</summary>
    private bool _generating;

    /// <summary>Whether the convert this page asked for is in flight; only that busies the Convert button.</summary>
    private bool _converting;

    private PrdState State => PrdStore.Value;

    protected override void SubscribeStores() => Subscribe(PrdStore);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _token = _cts.Token;
    }

    private Task SelectProjectAsync(Guid projectId) => Dispatcher.DispatchAsync(new PrdProjectSelected(projectId)).AsTask();

    private async Task GenerateAsync(RequirementsInputStep.RequirementsData data)
    {
        _generating = true;
        try
        {
            await PrdEffects.GenerateAsync(data.Requirements, data.Context, _token);
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task ConvertAsync(List<PrdItemForConversionDto> selectedItems)
    {
        _converting = true;
        try
        {
            await PrdEffects.ConvertAsync(selectedItems, _token);
        }
        finally
        {
            _converting = false;
        }
    }

    private Task ResetAsync() => Dispatcher.DispatchAsync(new PrdReset()).AsTask();

    private Task DismissErrorAsync() => Dispatcher.DispatchAsync(new PrdErrorDismissed()).AsTask();

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        await Dispatcher.DispatchAsync(new PrdClosed());
    }

}
