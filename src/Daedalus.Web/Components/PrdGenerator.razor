@page "/prd-generator"
@using System.Text.Json
@using Daedalus.Application.DTOs
@using TaskDto = Daedalus.Application.DTOs.TaskDto
@implements IAsyncDisposable

@inject NavigationManager Nav
@inject HttpClient Http
@inject ILogger<PrdGenerator> Logger

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">PRD Generator</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.6; margin: 0;">
            AI-powered requirements to executable tasks
        </RadzenText>
    </RadzenStack>

    <RadzenSteps @bind-SelectedIndex="_stepIndex" Style="pointer-events: none;">
        <Steps>
            <RadzenStepsItem Text="Select Project"/>
            <RadzenStepsItem Text="Requirements"/>
            <RadzenStepsItem Text="Review PRD"/>
            <RadzenStepsItem Text="Tasks Created"/>
        </Steps>
    </RadzenSteps>

    @if (_currentStep == PrdGeneratorStep.ProjectSelection)
    {
        <ProjectSelectionStep OnProjectSelected="id => HandleProjectSelected(id)"/>
    }
    else if (_currentStep == PrdGeneratorStep.RequirementsInput)
    {
        <RequirementsInputStep ProjectId="_selectedProjectId"
                               OnRequirementsSubmitted="data => HandleRequirementsSubmitted(new RequirementsData(data.Requirements, data.Context))"
                               IsLoading="_isGenerating" OnCancel="() => ResetWorkflow()"/>
    }
    else if (_currentStep == PrdGeneratorStep.PrdReview)
    {
        <PrdReviewStep Prd="_generatedPrd!" OnItemsSelected="items => HandleItemsSelected(items)"
                       IsConverting="_isConverting" OnCancel="() => ResetWorkflow()"/>
    }
    else if (_currentStep == PrdGeneratorStep.TasksCreated)
    {
        <TasksCreatedStep CreatedTasks="_createdTasks" OnDone="() => ResetWorkflow()"/>
    }

    @if (_showError)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat"
                     AllowClose="true" Close="@(() => _showError = false)">
            @_errorMessage
        </RadzenAlert>
    }
</RadzenStack>

@code {

    private enum PrdGeneratorStep
    {
        ProjectSelection,
        RequirementsInput,
        PrdReview,
        TasksCreated
    }

    private PrdGeneratorStep _currentStep = PrdGeneratorStep.ProjectSelection;
    private int _stepIndex;
    private Guid _selectedProjectId;
    private PrdResponseDto? _generatedPrd;
    private List<TaskDto> _createdTasks = [];
    private bool _isGenerating;
    private bool _isConverting;
    private bool _showError;
    private string _errorMessage = string.Empty;

    private void HandleProjectSelected(Guid projectId)
    {
        _selectedProjectId = projectId;
        _currentStep = PrdGeneratorStep.RequirementsInput;
        _stepIndex = 1;
    }

    private async Task HandleRequirementsSubmitted(RequirementsData data)
    {
        _isGenerating = true;
        _showError = false;

        try
        {
            var request = new PrdRequestDto(
                _selectedProjectId,
                data.Requirements,
                data.Context);

            var response = await Http.PostAsJsonAsync("api/prd/generate", request);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                _generatedPrd = JsonSerializer.Deserialize<PrdResponseDto>(jsonContent);
                _currentStep = PrdGeneratorStep.PrdReview;
                _stepIndex = 2;
                Logger.LogInformation("PRD generated successfully");
            }
            else
            {
                try
                {
                    var jsonContent = await response.Content.ReadAsStringAsync();
                    var error = JsonSerializer.Deserialize<dynamic>(jsonContent);
                    _errorMessage = error?.ToString() ?? "Failed to generate PRD";
                }
                catch
                {
                    _errorMessage = $"Failed to generate PRD (Status: {response.StatusCode})";
                }

                _showError = true;
                Logger.LogError("PRD generation failed: {Error}", _errorMessage);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
            _showError = true;
            Logger.LogError(ex, "Exception generating PRD");
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task HandleItemsSelected(List<PrdItemForConversionDto> selectedItems)
    {
        _isConverting = true;
        _showError = false;

        try
        {
            var request = new PrdConversionRequestDto(
                _selectedProjectId,
                selectedItems);

            var response = await Http.PostAsJsonAsync("api/prd/convert-to-tasks", request);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                _createdTasks = JsonSerializer.Deserialize<List<TaskDto>>(jsonContent) ?? [];
                _currentStep = PrdGeneratorStep.TasksCreated;
                _stepIndex = 3;
                Logger.LogInformation("Tasks created successfully");
            }
            else
            {
                try
                {
                    var jsonContent = await response.Content.ReadAsStringAsync();
                    var error = JsonSerializer.Deserialize<dynamic>(jsonContent);
                    _errorMessage = error?.ToString() ?? "Failed to convert to tasks";
                }
                catch
                {
                    _errorMessage = $"Failed to convert to tasks (Status: {response.StatusCode})";
                }

                _showError = true;
                Logger.LogError("Task conversion failed: {Error}", _errorMessage);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
            _showError = true;
            Logger.LogError(ex, "Exception converting to tasks");
        }
        finally
        {
            _isConverting = false;
        }
    }

    private void ResetWorkflow()
    {
        _currentStep = PrdGeneratorStep.ProjectSelection;
        _stepIndex = 0;
        _selectedProjectId = Guid.Empty;
        _generatedPrd = null;
        _createdTasks = [];
        _showError = false;
        _errorMessage = string.Empty;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await ValueTask.CompletedTask;
    }

    private sealed record RequirementsData(string Requirements, string? Context = null);

}
