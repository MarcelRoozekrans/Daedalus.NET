@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ApiClient Api
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime Js

<RadzenTemplateForm @ref="_form" TItem="TaskForm" Data="@_model">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Status</RadzenText>
            <RunStatusBadge Status="@(Task.RunStatus ?? "")" AwaitingSignal="@Task.AwaitingSignal" NoRunText="@TaskStatusLabels.NoRunText(Task)"/>
        </RadzenStack>

        @if (_error is { } error)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="task-dialog-error">
                @error
            </RadzenAlert>
        }

        <TaskFields Model="@_model" Projects="@_projects" ProjectError="@_projectError" ProjectLocked="true"/>

        @if (!string.IsNullOrEmpty(Task.Result))
        {
            <RadzenFieldset Text="Result" Style="width: 100%;">
                <RadzenText TextStyle="TextStyle.Body2">@Task.Result</RadzenText>
            </RadzenFieldset>
        }

        @if (!string.IsNullOrEmpty(Task.Learnings))
        {
            <RadzenFieldset Text="Learnings" Style="width: 100%;">
                <RadzenText TextStyle="TextStyle.Body2">@Task.Learnings</RadzenText>
            </RadzenFieldset>
        }

        <TaskDialogActions>
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Disabled="@_submitting"
                          Click="@(() => DialogService.Close(false))"/>
            <RadzenButton Text="Save changes" ButtonStyle="ButtonStyle.Primary" IsBusy="@_submitting"
                          Disabled="@(_submitting || !TaskStatusLabels.IsEditable(Task.Status))" Click="@SaveAsync"/>
        </TaskDialogActions>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly CancellationTokenSource _cts = new();
    private TaskForm _model = new();
    private RadzenTemplateForm<TaskForm>? _form;
    private IReadOnlyList<ProjectDto>? _projects;
    private string? _projectError;
    private DialogHold? _hold;
    private string? _error;
    private bool _submitting;

    [Parameter] public TaskDto Task { get; set; } = default!;

    protected override void OnParametersSet() => _model = TaskForm.From(Task);

    protected override void OnInitialized() => _hold = new DialogHold(Js);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _hold!.Prepare();
        }
    }

    /// <summary>
    ///     Reads the task's project, so the locked picker names it; a task cannot move to another project. A project that
    ///     cannot be read says why under the picker, unless the session is signing in again, and the rest of the form
    ///     still works.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var project = await Api.GetProjectAsync(Task.ProjectId, _cts.Token);
        if (project.IsSuccess)
        {
            _projects = [project.Value];
            return;
        }

        _projects = [];
        _projectError = project.Error;
    }

    /// <summary>Saves the task. A refusal stays in the dialog with the server's reason, and the form keeps its values.</summary>
    private async Task SaveAsync()
    {
        if (_submitting || _form?.EditContext?.Validate() != true)
        {
            return;
        }

        // Read before any await: once the dialog is gone its token source is disposed, and nothing below may touch it.
        var ct = _cts.Token;
        _submitting = true;
        _error = null;
        try
        {
            if (!await _hold!.HoldAsync())
            {
                return;
            }

            var result = await Api.UpdateTaskAsync(Task.Id, _model.ToUpdate(Task), ct);
            if (_hold.IsDisposed)
            {
                return;
            }

            await _hold.ReleaseAsync();
            if (result.IsFailure)
            {
                _error = SessionExpiry.IsSigningIn(result.Error) ? null : result.Error;
                return;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Task updated");
            DialogService.Close(true);
        }
        finally
        {
            _submitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
        if (_hold is not null)
        {
            await _hold.DisposeAsync();
        }
    }
}
