@implements IDisposable
@inject ApiClient Api
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenTemplateForm @ref="_form" TItem="TaskForm" Data="@_model">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Status</RadzenText>
            <RunStatusBadge TaskStatus="@Task.Status"/>
        </RadzenStack>

        @if (_error is { } error)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="task-dialog-error">
                @error
            </RadzenAlert>
        }

        <TaskFields Model="@_model" Projects="@_projects" ProjectLocked="true"/>

        @if (!string.IsNullOrEmpty(Task.Result))
        {
            <RadzenFieldset Text="Result" Style="width: 100%;">
                <RadzenText TextStyle="TextStyle.Body2">@Task.Result</RadzenText>
            </RadzenFieldset>
        }

        @if (!string.IsNullOrEmpty(Task.Learnings))
        {
            <RadzenFieldset Text="Learnings" Style="width: 100%;">
                <RadzenText TextStyle="TextStyle.Body2">@Task.Learnings</RadzenText>
            </RadzenFieldset>
        }

        <TaskDialogActions>
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Disabled="@_submitting"
                          Click="@(() => DialogService.Close(false))"/>
            <RadzenButton Text="Save changes" ButtonStyle="ButtonStyle.Primary" IsBusy="@_submitting"
                          Disabled="@(_submitting || !TaskStatusLabels.IsEditable(Task.Status))" Click="@SaveAsync"/>
        </TaskDialogActions>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly CancellationTokenSource _cts = new();
    private TaskForm _model = new();
    private RadzenTemplateForm<TaskForm>? _form;
    private IReadOnlyList<ProjectDto>? _projects;
    private string? _error;
    private bool _submitting;

    [Parameter] public TaskDto Task { get; set; } = default!;

    protected override void OnParametersSet() => _model = TaskForm.From(Task);

    /// <summary>
    ///     Reads the task's project, so the locked picker names it; a task cannot move to another project. A project that
    ///     cannot be read leaves the picker empty, and the rest of the form still works.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var project = await Api.GetProjectAsync(Task.ProjectId, _cts.Token);
        _projects = project.IsSuccess ? [project.Value] : [];
    }

    /// <summary>Saves the task. A refusal stays in the dialog with the server's reason, and the form keeps its values.</summary>
    private async Task SaveAsync()
    {
        if (_submitting || _form?.EditContext?.Validate() != true)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var result = await Api.UpdateTaskAsync(Task.Id, _model.ToUpdate(Task), _cts.Token);
            if (result.IsFailure)
            {
                _error = SessionExpiry.IsSigningIn(result.Error) ? null : result.Error;
                return;
            }

            NotificationService.Notify(NotificationSeverity.Success, "Task updated");
            DialogService.Close(true);
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
