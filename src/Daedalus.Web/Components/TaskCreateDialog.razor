@using Microsoft.JSInterop
@inherits FluxComponent
@implements IAsyncDisposable
@inject ApiClient Api
@inject TasksEffects Effects
@inject IStore<TasksState> TaskStore
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime Js

<RadzenTemplateForm @ref="_form" TItem="TaskForm" Data="@_model">
    <RadzenStack Gap="1rem">
        @if (_error is { } error)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="task-dialog-error">
                @error
            </RadzenAlert>
        }

        <TaskFields @ref="_fields" Model="@_model" Projects="@TaskStore.Value.Projects" ProjectError="@TaskStore.Value.ProjectsError"/>

        <TaskDialogActions>
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Disabled="@_submitting"
                          Click="@(() => DialogService.Close(null))"/>
            <RadzenButton Text="Create" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                          IsBusy="@_submitting" Disabled="@_submitting" Click="@(() => SubmitAsync(manufacture: false))"/>
            @* Only for someone who may start a run: the manufacture endpoint needs the developer or admin role. *@
            @if (_canStart)
            {
                <RadzenButton Text="Create and manufacture" ButtonStyle="ButtonStyle.Primary"
                              IsBusy="@_submitting" Disabled="@_submitting" Click="@(() => SubmitAsync(manufacture: true))"/>
            }
        </TaskDialogActions>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly TaskForm _model = new();
    private DialogHold? _hold;
    private RadzenTemplateForm<TaskForm>? _form;
    private TaskFields? _fields;
    private string? _error;
    private bool _submitting;
    private bool _preselected;
    private bool _canStart;

    /// <summary>The signed-in user, for whether Create and manufacture shows.</summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override void SubscribeStores() => Subscribe(TaskStore);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _hold = new DialogHold(Js);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        _canStart = AuthenticationState is { } state && RunAccess.CanStart((await state).User);
    }

    /// <summary>
    ///     Focuses Project once, and preselects the only project once the board's projects have arrived, which may be after
    ///     the dialog opened.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hold!.Prepare();
            if (_fields is not null)
            {
                await _fields.FocusProjectAsync();
            }
        }

        if (!_preselected && TaskStore.Value.Projects is { } projects)
        {
            _preselected = true;
            if (_model.ProjectId is null && TaskForm.Preselect(projects) is { } only)
            {
                _model.ProjectId = only;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    ///     Creates the task and, for Create and manufacture, starts its run. The dialog is held open meanwhile, so Escape
    ///     and its close button cannot drop a task that is being created. A refused create stays in the dialog with the
    ///     server's reason; once the task exists the dialog closes, saying whether its run started.
    /// </summary>
    private async Task SubmitAsync(bool manufacture)
    {
        if (_submitting || _form?.EditContext?.Validate() != true)
        {
            return;
        }

        // Read before any await: once the dialog is gone its token source is disposed, and nothing below may touch it.
        var ct = _cts.Token;
        _submitting = true;
        _error = null;
        try
        {
            if (!await _hold!.HoldAsync())
            {
                return;
            }

            var created = await Api.CreateTaskAsync(_model.ToCreate(), ct);
            if (_hold.IsDisposed)
            {
                return;
            }

            if (created.IsFailure)
            {
                _error = SessionExpiry.IsSigningIn(created.Error) ? null : created.Error;
                await _hold.ReleaseAsync();
                return;
            }

            var taskId = created.Value.Id;
            if (!manufacture)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Task created");
                await _hold.ReleaseAsync();
                DialogService.Close(new TaskCreateOutcome(taskId, null, null));
                return;
            }

            var started = await Effects.ManufactureAsync(taskId, ct);
            if (_hold.IsDisposed)
            {
                return;
            }

            await _hold.ReleaseAsync();
            DialogService.Close(started.IsSuccess
                ? new TaskCreateOutcome(taskId, started.Value.RunId, null)
                : new TaskCreateOutcome(taskId, null, started.Error));
        }
        finally
        {
            _submitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
        if (_hold is not null)
        {
            await _hold.DisposeAsync();
        }
    }
}
