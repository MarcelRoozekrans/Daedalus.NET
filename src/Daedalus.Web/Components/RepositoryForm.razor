@using Daedalus.Application.DTOs
@inject DialogService DialogService

@if (Repository != null)
{
    <RadzenTemplateForm TItem="RepositoryConfigurationDto" Data="@Repository" Submit="@OnSubmit">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Repository Name" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="Repository.Name" Placeholder="e.g., My Application Repository"/>
            </RadzenFormField>

            <RadzenFormField Text="Repository URL" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="Repository.Url" Placeholder="https://github.com/user/repo"/>
            </RadzenFormField>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Platform" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenDropDown @bind-Value="Repository.Platform" Data="@_platforms"
                                        Disabled="@IsEditing" Style="width: 100%;"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Default Branch" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="Repository.DefaultBranch" Placeholder="main"/>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Authentication Method" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenDropDown @bind-Value="Repository.AuthenticationMethod" Data="@_authMethods"
                                        TextProperty="Text" ValueProperty="Value"
                                        AllowClear="true" Placeholder="None" Style="width: 100%;"/>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Credential Identifier" Variant="Variant.Outlined" Style="width: 100%;">
                        <RadzenTextBox @bind-Value="Repository.CredentialIdentifier"
                                       Placeholder="vault-key or env-var-name"/>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="Description" Variant="Variant.Outlined">
                <RadzenTextArea @bind-Value="Repository.Description" Rows="3"
                                Placeholder="Optional description"/>
            </RadzenFormField>

            @if (IsEditing)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenCheckBox @bind-Value="Repository.IsActive" Name="isActive"/>
                    <RadzenLabel Text="Active" Component="isActive"/>
                </RadzenStack>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem"
                         JustifyContent="JustifyContent.End" class="rz-mt-2">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(() => DialogService.Close(false))"/>
                <RadzenButton Text="@(IsEditing ? "Update" : "Create")" Icon="check"
                              ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit"/>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public RepositoryConfigurationDto? Repository { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    private static readonly string[] _platforms = ["GitHub", "GitLab", "AzureDevOps", "Gitea"];

    private static readonly object[] _authMethods =
    [
        new { Text = "Personal Access Token", Value = "PAT" },
        new { Text = "SSH Key", Value = "SSH" },
        new { Text = "OAuth", Value = "OAuth" }
    ];

    protected override void OnInitialized()
    {
        Repository ??= new RepositoryConfigurationDto
        {
            Id = Guid.NewGuid(),
            Platform = "GitHub",
            DefaultBranch = "main"
        };
    }

    private void OnSubmit()
    {
        DialogService.Close(true);
    }
}
