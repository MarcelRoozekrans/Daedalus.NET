@inherits FluxComponent
@inject IStore<RunsState> Runs
@inject NavigationManager Navigation

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" data-testid="live-indicator">
    @switch (Runs.Value.Hub)
    {
        case HubStatus.Connected:
            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.6; margin: 0;">Live</RadzenText>
            break;
        case HubStatus.Reconnecting:
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-warning); margin: 0;">Reconnecting…</RadzenText>
            break;
        default:
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); margin: 0;">Offline: showing last loaded</RadzenText>
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                          aria-label="Reload" title="Reload" Click="@(() => Navigation.Refresh(forceReload: true))"/>
            break;
    }
</RadzenStack>

@code {
    protected override void SubscribeStores() => Subscribe(Runs);
}
