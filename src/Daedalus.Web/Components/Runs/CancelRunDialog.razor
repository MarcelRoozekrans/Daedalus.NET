@implements IDisposable
@inject RunsEffects Effects
@inject DialogService DialogService

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
        The run stops where it is. A cancelled run cannot be resumed.
    </RadzenText>
    <RadzenFormField Text="Reason (optional)" Style="width: 100%;">
        <RadzenTextArea @bind-Value="@_reason" Rows="3" MaxLength="1000" Disabled="@_submitting" data-testid="cancel-reason"/>
    </RadzenFormField>
    @if (_error is { } error)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="cancel-error">@error</RadzenAlert>
    }
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenButton Text="Keep run" ButtonStyle="ButtonStyle.Light" Disabled="@_submitting" Click="@(() => DialogService.Close(null))"
                      data-testid="cancel-keep"/>
        <RadzenButton Text="Cancel run" ButtonStyle="ButtonStyle.Danger" IsBusy="@_submitting" Disabled="@_submitting" Click="@CancelAsync"
                      data-testid="cancel-confirm"/>
    </RadzenStack>
</RadzenStack>

@code {
    private string? _reason;
    private bool _closed;
    private bool _submitting;
    private string? _error;

    /// <summary>The run to cancel.</summary>
    [Parameter, EditorRequired] public Guid RunId { get; set; }

    /// <summary>The page's token: leaving the page cancels the request, closing the dialog does not.</summary>
    [Parameter] public CancellationToken CancellationToken { get; set; }

    /// <summary>
    ///     Sends the cancel. A refusal stays in the dialog with the server's reason; success closes it with
    ///     <see langword="true"/>, and the page reflects the cancel when the change arrives.
    ///     Closing the dialog never cancels the request: Escape can close it while the request is in flight, and the
    ///     server may already have applied it, so it runs to its end and the run's change reports the outcome. Leaving
    ///     the page does cancel it, through the page's token, so a refused cancel's re-fetch cannot re-open a run
    ///     nobody is looking at. A dialog closed meanwhile does nothing with the result, so it never closes another
    ///     dialog or reports into nothing.
    /// </summary>
    private async Task CancelAsync()
    {
        _submitting = true;
        _error = null;
        var result = await Effects.CancelAsync(RunId, string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(), CancellationToken);
        _submitting = false;
        if (_closed)
        {
            return;
        }

        if (result.IsSuccess)
        {
            DialogService.Close(true);
        }
        else
        {
            _error = result.Error;
        }
    }

    public void Dispose() => _closed = true;
}
