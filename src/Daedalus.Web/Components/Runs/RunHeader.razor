<RadzenStack Gap="0.25rem" class="rz-mb-4" data-testid="run-header">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">Run @Run.Id.ToString()[..8]</RadzenText>
            <RunStatusBadge Status="@Run.Status" AwaitingSignal="@Run.AwaitingSignal"/>
        </RadzenStack>
        <LiveIndicator/>
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
        @Run.Process v@(Run.ProcessVersion) · at @Run.CurrentNode · started by @RunStarter.Name(Run.StartedByName)
        @if (Run.PrUrl is { } pr)
        {
            var text = $"Pull request #{pr.Segments[^1].TrimEnd('/')}";
            <span> · </span>
            <RadzenLink Path="@pr.AbsoluteUri" Target="_blank" rel="noopener" aria-label="@($"{text}, opens in a new tab")"
                        Style="color: var(--rz-primary);" data-testid="run-pr-link">
                @text
                <RadzenIcon Icon="open_in_new" aria-hidden="true" Style="font-size: 1em; vertical-align: text-bottom;"/>
            </RadzenLink>
        }
    </RadzenText>
    @if (Run.UnreadablePullRequestLink is { } unreadable)
    {
        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-warning); margin: 0;">Pull request link could not be read: @unreadable</RadzenText>
    }
    @if (Run.Status == "Failed")
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="run-failure">@(Run.FailureReason ?? NoFailureReason)</RadzenAlert>
    }
    else if (Run.LastError is { } lastError)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" data-testid="run-last-error">@lastError</RadzenAlert>
    }
    @if (CanRetry && Run.Status == "Failed")
    {
        <div>
            <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="@OnRetry"
                          data-testid="run-retry"/>
        </div>
    }
</RadzenStack>

@code {
    /// <summary>The Failed alert's text when the view carries no reason; the failed step's error is in the timeline.</summary>
    private const string NoFailureReason = "The run failed; the reason is in the timeline.";

    /// <summary>The run whose identity, place and failure the header shows.</summary>
    [Parameter, EditorRequired] public WorkflowRunView Run { get; set; } = default!;

    /// <summary>Whether the user holds admin, and so may retry a failed run.</summary>
    [Parameter, EditorRequired] public bool CanRetry { get; set; }

    /// <summary>Asks to retry the failed node; the page confirms first.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }
}
