@inherits FluxComponent
@inject IStore<RunsState> Runs
@inject IDispatcher Dispatcher
@inject RunsEffects Effects

<RadzenCard class="rz-mb-4" data-testid="runs-card">
    @* The two queries are the contract's breakpoints: a column below its breakpoint is not rendered at all. *@
    <RadzenMediaQuery Query="(min-width: 1280px)" Change="@(matches => _desktop = matches)"/>
    <RadzenMediaQuery Query="(min-width: 768px)" Change="@(matches => _tablet = matches)"/>
    @if (Runs.Value.ListError is { } error)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            @error
            <RadzenButton Text="Retry" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ReloadAsync"/>
        </RadzenAlert>
    }
    else if (Runs.Value.List is { Runs.Count: 0 } && !Runs.Value.ListLoading)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
            @(Runs.Value.Query is { Status: not null } or { Process: not null }
                ? "No runs match these filters."
                : "No runs yet. Start one with Manufacture on a board task.")
        </RadzenAlert>
    }
    else
    {
        <div class="runs-grid">
        <RadzenDataGrid TItem="WorkflowRunListItem" Data="@(Runs.Value.List?.Runs ?? [])" AllowSorting="true"
                        IsLoading="@Runs.Value.ListLoading" Style="@($"height: auto; min-width: {MinGridWidth}px;")" data-testid="runs-grid">
            <Columns>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Title="Status" Width="@Px(StatusWidth)">
                    <Template Context="run">
                        <a href="@($"runs/{run.Id}")" aria-label="@($"Open run {run.Id.ToString()[..8]}, {RunStatusLabels.Text(run.Status, run.AwaitingSignal)}")">
                            <RunStatusBadge Status="@run.Status" AwaitingSignal="@run.AwaitingSignal"/>
                        </a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Title="Process" Width="@Px(ProcessWidth)" Visible="@_tablet">
                    <Template Context="run">@run.Process v@(run.ProcessVersion)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Property="CurrentNode" Title="Current node" Width="@Px(NodeWidth)"/>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Title="Task">
                    <Template Context="run">
                        @if (run.TaskTitle is { } title)
                        {
                            <RadzenLink Path="tasks" Text="@($"{run.TaskCode} {title}")"/>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Property="StartedByName" Title="Started by" Width="@Px(StartedByWidth)"
                                      Visible="@_desktop">
                    <Template Context="run">@RunStarter.Name(run.StartedByName)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Property="CreatedAt" Title="Started" Width="@Px(StartedWidth)" Visible="@_tablet">
                    <Template Context="run">@LocalTimes.ShortDateTime(run.CreatedAt.UtcDateTime)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="WorkflowRunListItem" Property="UpdatedAt" Title="Updated" Width="@Px(UpdatedWidth)" Visible="@_desktop">
                    <Template Context="run">@LocalTimes.ShortDateTime(run.UpdatedAt.UtcDateTime)</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem" class="rz-mt-2">
            <RadzenButton Text="Previous" ButtonStyle="ButtonStyle.Light" Disabled="@(Runs.Value.ListLoading || Runs.Value.PreviousCursors.Count == 0)"
                          Click="@PreviousAsync" data-testid="runs-previous"/>
            <RadzenButton Text="Next" ButtonStyle="ButtonStyle.Light" Disabled="@(Runs.Value.ListLoading || Runs.Value.List?.Next is null)"
                          Click="@NextAsync" data-testid="runs-next"/>
        </RadzenStack>
    }
</RadzenCard>

@code {
    // Radzen lays the grid out as a fixed table: each column's width is its <col>, and the Task column, which has none,
    // gets whatever the others leave. The grid is therefore never narrower than the shown columns plus the Task
    // column's minimum, and scrolls inside its card when the card is narrower than that.
    private const int StatusWidth = 170;
    private const int ProcessWidth = 170;
    private const int NodeWidth = 140;
    private const int TaskMinWidth = 200;
    private const int StartedByWidth = 140;
    private const int StartedWidth = 150;
    private const int UpdatedWidth = 150;

    /// <summary>Whether the viewport is desktop width, 1280px or more: started by and updated are shown.</summary>
    private bool _desktop = true;

    /// <summary>Whether the viewport is tablet width or more, 768px or more: process and started are shown.</summary>
    private bool _tablet = true;

    [Parameter] public CancellationToken CancellationToken { get; set; }

    /// <summary>The widths of the columns shown at this breakpoint, with the Task column at its minimum.</summary>
    private int MinGridWidth =>
        StatusWidth + NodeWidth + TaskMinWidth
        + (_tablet ? ProcessWidth + StartedWidth : 0)
        + (_desktop ? StartedByWidth + UpdatedWidth : 0);

    private static string Px(int width) => string.Create(CultureInfo.InvariantCulture, $"{width}px");

    protected override void SubscribeStores() => Subscribe(Runs);

    private Task ReloadAsync() => Effects.LoadListAsync(Runs.Value.Query, CancellationToken);

    private async Task NextAsync()
    {
        if (Runs.Value.List?.Next is { } next)
        {
            await Dispatcher.DispatchAsync(new RunListPagedForward(next));
            await Effects.LoadListAsync(Runs.Value.Query, CancellationToken);
        }
    }

    private async Task PreviousAsync()
    {
        await Dispatcher.DispatchAsync(new RunListPagedBack());
        await Effects.LoadListAsync(Runs.Value.Query, CancellationToken);
    }
}
