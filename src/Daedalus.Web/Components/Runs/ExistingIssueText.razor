@if (Finding.ExistingIssue is { } issue)
{
    <span> · existing issue </span>
    @if (Finding.ExistingIssueUrl is { } url)
    {
        <RadzenLink Path="@url.AbsoluteUri" Target="_blank" rel="noopener" Text="@($"#{issue}")" data-testid="existing-issue-link"/>
    }
    else
    {
        <span>#@issue</span>
    }
}

@code {
    /// <summary>
    ///     The deferred finding whose existing issue to show: a link when the server could place it in the pull
    ///     request's repository, else the number alone.
    /// </summary>
    [Parameter, EditorRequired] public DeferredFindingView Finding { get; set; } = default!;
}
