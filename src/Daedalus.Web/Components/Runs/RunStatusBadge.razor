@* The one status badge, solid and pill-shaped, on Runs and Tasks alike, mapped by RunStatusLabels. A board task passes
   its run's status and signal, or TaskStatusLabels.NotStarted when it has no run. *@
<RadzenBadge Text="@RunStatusLabels.Text(Status, AwaitingSignal)" BadgeStyle="@RunStatusLabels.Style(Status, AwaitingSignal)"
             IsPill="true" data-testid="run-status"/>

@code {
    /// <summary>A run's status, as the runs API names it.</summary>
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    /// <summary>The signal a parked run awaits.</summary>
    [Parameter] public string? AwaitingSignal { get; set; }
}
