@inherits LayoutComponentBase
@implements IDisposable
@inject SessionExpiry Expiry
@inject NotificationService Notifications

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0"
                     JustifyContent="JustifyContent.SpaceBetween" Style="padding: 0 1rem; width: 100%;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                @* Signed out, the header holds only the logo and Sign in: no menu, so no toggle. *@
                @if (_chrome == Chrome.SignedIn)
                {
                    <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)"/>
                }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="hub" Style="font-size: 1.5rem; color: var(--rz-primary);"/>
                    <RadzenText Text="Daedalus" TextStyle="TextStyle.H5"
                                Style="margin: 0; font-weight: 700; letter-spacing: -0.025em;"/>
                </RadzenStack>
            </RadzenStack>
            @* While the sign-in is still being read, neither the user nor Sign in: either could be wrong. *@
            @if (_chrome != Chrome.Unknown)
            {
                <LoginDisplay User="@(_chrome == Chrome.SignedIn ? _signedIn : null)"/>
            }
        </RadzenStack>
    </RadzenHeader>

    @* Signed out, or not yet known, no menu at all: nothing in it is open to a visitor. *@
    @if (_chrome == Chrome.SignedIn)
    {
        <RadzenSidebar @bind-Expanded="@_sidebarExpanded" Style="width: 260px;">
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/"/>
            </RadzenPanelMenu>

            <div class="sidebar-section-divider">Operations</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Tasks" Icon="task_alt" Path="tasks"/>
                <RunsMenuItem/>
                <RadzenPanelMenuItem Text="Projects" Icon="folder_special" Path="projects"/>
                <RadzenPanelMenuItem Text="Executions" Icon="receipt_long" Path="executions"/>
                <RadzenPanelMenuItem Text="Schedules" Icon="schedule" Path="schedules"/>
                <RadzenPanelMenuItem Text="Costs" Icon="attach_money" Path="costs"/>
                <RadzenPanelMenuItem Text="Agent" Icon="smart_toy" Path="agent"/>
            </RadzenPanelMenu>

            @* Admins only: every /api/repositories action needs the API's Admin policy, the admin role. The section holds
               nothing else, so its heading goes with it. *@
            <AuthorizeView Roles="admin">
                <div class="sidebar-section-divider">Configuration</div>
                <RadzenPanelMenu>
                    <RadzenPanelMenuItem Text="Git Repositories" Icon="source" Path="repositories"/>
                </RadzenPanelMenu>
            </AuthorizeView>

            <div class="sidebar-section-divider">AI Tools</div>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="PRD Generator" Icon="description" Path="prd-generator"/>
            </RadzenPanelMenu>
        </RadzenSidebar>
    }

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.6;">
                Daedalus &bull; Autonomous Code Analysis Platform
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; opacity: 0.4;">
                v1.0.0
            </RadzenText>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

<RadzenDialog/>
<RadzenNotification/>
<RadzenTooltip/>
<RadzenContextMenu/>

@code {
    bool _sidebarExpanded = true;

    private Task<AuthenticationState>? _evaluated;

    /// <summary>The user the authentication state last named, signed in or not.</summary>
    private ClaimsPrincipal? _signedIn;

    /// <summary>Which chrome the layout shows: unknown until the authentication state is read.</summary>
    private Chrome _chrome = Chrome.Unknown;

    /// <summary>
    ///     The signed-in user, replaced whenever the authentication state changes, so the chrome follows a sign-in that
    ///     completes after the layout rendered.
    /// </summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override void OnInitialized() => Expiry.Changed += OnExpiryChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is not { } state || ReferenceEquals(state, _evaluated))
        {
            return;
        }

        if (_evaluated is not null)
        {
            // A new authentication state, as after a sign-in that completes in place: it decides, not the session
            // that ended before it.
            Expiry.Reset();
        }

        _evaluated = state;
        _chrome = Chrome.Unknown;
        var user = (await state).User;
        if (ReferenceEquals(state, _evaluated))
        {
            _signedIn = user;
            Apply();
        }
    }

    public void Dispose() => Expiry.Changed -= OnExpiryChanged;

    private void Apply() =>
        _chrome = _signedIn?.Identity?.IsAuthenticated == true && !Expiry.Expired ? Chrome.SignedIn : Chrome.SignedOut;

    /// <summary>
    ///     A session that ended is shown once, here, as information: the pages show no error of their own for the
    ///     requests it failed.
    /// </summary>
    private void OnExpiryChanged(object? sender, EventArgs e)
    {
        if (_signedIn is not null)
        {
            Apply();
        }

        if (Expiry.Expired)
        {
            Notifications.Notify(NotificationSeverity.Info, SessionExpiry.SigningInAgain);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>The three states of the chrome.</summary>
    private enum Chrome
    {
        /// <summary>The authentication state is still being read: the header shows the logo only.</summary>
        Unknown,

        /// <summary>Someone is signed in: menu, toggle, the user and Log out.</summary>
        SignedIn,

        /// <summary>No one is, or the session ended: the logo and Sign in.</summary>
        SignedOut,
    }
}
