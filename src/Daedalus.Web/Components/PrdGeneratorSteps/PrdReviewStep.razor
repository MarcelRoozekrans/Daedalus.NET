@using Daedalus.Application.DTOs

<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
            <RadzenIcon Icon="fact_check" Style="vertical-align: middle; margin-right: 0.25rem;"/>
            Review Generated PRD
        </RadzenText>

        @if (Prd == null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
                No PRD data available
            </RadzenAlert>
        }
        else
        {
            @* ── Product Overview ──────────────────────── *@
            <RadzenCard Variant="Variant.Text">
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0 0 0.5rem;">
                    <RadzenIcon Icon="description" Style="vertical-align: middle; font-size: 1.1rem; margin-right: 0.25rem;"/>
                    Product Overview
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@Prd.ProductOverview</RadzenText>
            </RadzenCard>

            @* ── Goals ─────────────────────────────────── *@
            @if (Prd.Goals.Count > 0)
            {
                <RadzenCard Variant="Variant.Text">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0 0 0.5rem;">
                        <RadzenIcon Icon="flag" Style="vertical-align: middle; font-size: 1.1rem; margin-right: 0.25rem;"/>
                        Goals
                    </RadzenText>
                    <RadzenStack Gap="0.25rem">
                        @foreach (var goal in Prd.Goals)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">
                                &bull; @goal
                            </RadzenText>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @* ── Assumptions ──────────────────────────── *@
            @if (Prd.Assumptions.Count > 0)
            {
                <RadzenCard Variant="Variant.Text">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0 0 0.5rem;">
                        <RadzenIcon Icon="lightbulb" Style="vertical-align: middle; font-size: 1.1rem; margin-right: 0.25rem;"/>
                        Assumptions
                    </RadzenText>
                    <RadzenStack Gap="0.25rem">
                        @foreach (var assumption in Prd.Assumptions)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">
                                &bull; @assumption
                            </RadzenText>
                        }
                    </RadzenStack>
                </RadzenCard>
            }

            @* ── Items to Convert ─────────────────────── *@
            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">
                <RadzenIcon Icon="checklist" Style="vertical-align: middle; font-size: 1.1rem; margin-right: 0.25rem;"/>
                Items to Convert to Tasks (@Prd.AllItems.Count)
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">
                Select the items you want to convert into executable tasks.
            </RadzenText>

            <RadzenRow Gap="1rem">
                @foreach (var item in Prd.AllItems)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard>
                            <RadzenStack Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox TValue="bool" Value="@_selectedItems.Contains(item)"
                                                    Change="@(val => HandleItemToggled(item, val))"
                                                    Disabled="@IsConverting" Name="@($"item_{item.GetHashCode()}")"/>
                                    <RadzenLabel Text="@item.Title" Component="@($"item_{item.GetHashCode()}")"
                                                 Style="font-weight: 600;"/>
                                </RadzenStack>

                                <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.6;">
                                    @item.Description
                                </RadzenText>

                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                    <RadzenBadge Text="@item.Priority.ToString()" BadgeStyle="BadgeStyle.Secondary"/>
                                    <RadzenBadge Text="@item.EstimatedComplexity.ToString()" BadgeStyle="BadgeStyle.Info"/>
                                    @if (item.DependenciesCount > 0)
                                    {
                                        <RadzenBadge Text="@($"{item.DependenciesCount} deps")" BadgeStyle="BadgeStyle.Warning"/>
                                    }
                                </RadzenStack>

                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">
                                    <strong>Acceptance Criteria:</strong> @item.AcceptanceCriteria
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>

            @* ── Action Buttons ───────────────────────── *@
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                <RadzenButton Text="@(IsConverting ? "Converting..." : $"Convert {_selectedItems.Count} Items to Tasks")"
                              Icon="transform" ButtonStyle="ButtonStyle.Success"
                              IsBusy="@IsConverting"
                              Disabled="@(_selectedItems.Count == 0)"
                              Click="@HandleConvert"/>
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Click="@(() => OnCancel.InvokeAsync())" Disabled="@IsConverting"/>
            </RadzenStack>
        }
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public PrdResponseDto? Prd { get; set; }

    [Parameter] public EventCallback<List<PrdItemForConversionDto>> OnItemsSelected { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public bool IsConverting { get; set; }

    private readonly HashSet<PrdItemDto> _selectedItems = [];

    private void HandleItemToggled(PrdItemDto item, bool isSelected)
    {
        if (isSelected)
        {
            _selectedItems.Add(item);
        }
        else
        {
            _selectedItems.Remove(item);
        }

        StateHasChanged();
    }

    private async Task HandleConvert()
    {
        var itemsForConversion = _selectedItems
            .Select(item => new PrdItemForConversionDto(
                item.Title,
                item.Description,
                item.AcceptanceCriteria,
                item.Priority,
                item.EstimatedComplexity,
                item.Dependencies ?? [],
                item.Phase,
                item.ParallelGroup))
            .ToList();

        await OnItemsSelected.InvokeAsync(itemsForConversion);
    }

}
