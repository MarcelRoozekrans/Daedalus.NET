
<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
            <RadzenIcon Icon="edit_note" Style="vertical-align: middle; margin-right: 0.25rem;"/>
            Enter Requirements
        </RadzenText>

        <RadzenFormField Text="What needs to be implemented?" Variant="Variant.Outlined">
            <ChildContent>
                <RadzenTextArea @bind-Value="Requirements" Rows="6"
                                Placeholder="Describe your requirements in detail. Example: Create a user authentication system with email verification, password reset functionality, and 2FA support..."
                                Disabled="@IsLoading" Style="width: 100%;"/>
            </ChildContent>
            <Helper>
                <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">
                    Be as detailed as possible. The more information you provide, the better the PRD will be.
                </RadzenText>
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="Additional Context (Optional)" Variant="Variant.Outlined">
            <ChildContent>
                <RadzenTextArea @bind-Value="Context" Rows="3"
                                Placeholder="Any additional context, constraints, or notes..."
                                Disabled="@IsLoading" Style="width: 100%;"/>
            </ChildContent>
            <Helper>
                <RadzenText TextStyle="TextStyle.Caption" Style="opacity: 0.5;">
                    Technical constraints, timeline, budget, or any other relevant information.
                </RadzenText>
            </Helper>
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="@(IsLoading ? "Generating PRD..." : "Generate PRD")" Icon="auto_awesome"
                          ButtonStyle="ButtonStyle.Primary" IsBusy="@IsLoading"
                          Click="@HandleSubmit" Disabled="@(string.IsNullOrWhiteSpace(Requirements))"/>
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@(() => OnCancel.InvokeAsync())" Disabled="@IsLoading"/>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    [Parameter] public EventCallback<RequirementsData> OnRequirementsSubmitted { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public bool IsLoading { get; set; }

    private string Requirements = string.Empty;
    private string? Context;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Requirements))
        {
            return;
        }

        var data = new RequirementsData(Requirements, Context);
        await OnRequirementsSubmitted.InvokeAsync(data);
    }

    public record RequirementsData(string Requirements, string? Context = null);

}
