@inherits FluxComponent
@implements IAsyncDisposable
@inject IStore<ProjectsState> ProjectStore
@inject ProjectsEffects ProjectsEffects

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
            <RadzenIcon Icon="folder_open" Style="vertical-align: middle; margin-right: 0.25rem;"/>
            Select Project
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin: 0;">
            Choose a project to associate with your PRD generation.
        </RadzenText>

        @if (Shown is not { } projects)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Style="display: block; margin: 1rem auto;"/>
        }
        else if (projects.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat">
                No projects found. Please create a project first.
            </RadzenAlert>
        }
        else
        {
            <RadzenRow Gap="1rem">
                @foreach (var project in projects)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Style="cursor: pointer;" @onclick="() => OnProjectSelected.InvokeAsync(project.Id)">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0 0 0.25rem;">
                                @project.ProjectName
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin: 0;">
                                @(string.IsNullOrEmpty(project.Description) ? "No description" : project.Description)
                            </RadzenText>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenStack>
</RadzenCard>

@code {
    private readonly CancellationTokenSource _cts = new();

    [Parameter] public EventCallback<Guid> OnProjectSelected { get; set; }

    /// <summary>Whether the load this step started is in flight; only that shows the spinner.</summary>
    private bool _loading = true;

    /// <summary>
    ///     The projects the step shows, or <see langword="null"/> for the spinner: while its own load is in flight, and
    ///     after a session being renewed, as the layout says so and the browser is on its way to sign in. A failed load
    ///     shows as no projects, as the step always showed it; a background refresh, such as a reconnect's, keeps the
    ///     cards showing.
    /// </summary>
    private IReadOnlyList<ProjectDto>? Shown
    {
        get
        {
            if (_loading)
            {
                return null;
            }

            return ProjectStore.Value.Current ?? (ProjectStore.Value.Error is not null ? [] : null);
        }
    }

    protected override void SubscribeStores() => Subscribe(ProjectStore);

    /// <summary>The projects are shared and never cleared, so the step re-reads them on every open.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ProjectsEffects.LoadAsync(_cts.Token);
        }
        finally
        {
            _loading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
