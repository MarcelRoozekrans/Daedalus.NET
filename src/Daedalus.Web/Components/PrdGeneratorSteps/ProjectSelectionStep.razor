@using ProjectDto = Daedalus.Application.DTOs.ProjectDto
@inject HttpClient Http
@inject ILogger<ProjectSelectionStep> Logger

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
            <RadzenIcon Icon="folder_open" Style="vertical-align: middle; margin-right: 0.25rem;"/>
            Select Project
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin: 0;">
            Choose a project to associate with your PRD generation.
        </RadzenText>

        @if (_projects == null)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Style="display: block; margin: 1rem auto;"/>
        }
        else if (_projects.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat">
                No projects found. Please create a project first.
            </RadzenAlert>
        }
        else
        {
            <RadzenRow Gap="1rem">
                @foreach (var project in _projects)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Style="cursor: pointer;" @onclick="() => OnProjectSelected.InvokeAsync(project.Id)">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0 0 0.25rem;">
                                @project.ProjectName
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="opacity: 0.5; margin: 0;">
                                @(string.IsNullOrEmpty(project.Description) ? "No description" : project.Description)
                            </RadzenText>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public EventCallback<Guid> OnProjectSelected { get; set; }

    private List<ProjectDto>? _projects;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        try
        {
            // The API returns a paged envelope, not a bare list (regression found by the PRD generator browser tests).
            var page = await Http.GetFromJsonAsync<PagedResultDto<ProjectDto>>("api/projects?page=1&pageSize=100");
            _projects = page?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading projects");
            _projects = [];
        }
    }
}
