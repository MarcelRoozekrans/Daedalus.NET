@using TaskDto = Daedalus.Application.DTOs.TaskDto
@inject NavigationManager Nav

<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
            <RadzenIcon Icon="check_circle" Style="vertical-align: middle; margin-right: 0.25rem; color: var(--rz-success);"/>
            Tasks Created Successfully!
        </RadzenText>

        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat">
            @CreatedTasks.Count tasks have been created and are ready to execute.
        </RadzenAlert>

        <RadzenDataGrid Data="@CreatedTasks" TItem="TaskDto" AllowSorting="true"
                         Style="margin-bottom: 1rem;">
            <Columns>
                <RadzenDataGridColumn TItem="TaskDto" Property="Id" Title="Task ID" Width="120px">
                    <Template Context="task">
                        <RadzenBadge Text="@task.Id.ToString()[..8]" BadgeStyle="BadgeStyle.Primary"/>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskDto" Property="Prompt" Title="Prompt"/>
                <RadzenDataGridColumn TItem="TaskDto" Property="MaxIterations" Title="Max Iter." Width="100px" TextAlign="TextAlign.Center"/>
                <RadzenDataGridColumn TItem="TaskDto" Property="IterationCount" Title="Current" Width="100px" TextAlign="TextAlign.Center"/>
                <RadzenDataGridColumn TItem="TaskDto" Property="CreatedAt" Title="Created" Width="120px">
                    <Template Context="task">
                        @task.CreatedAt.ToShortDateString()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TaskDto" Property="Status" Title="Status" Width="110px">
                    <Template Context="task">
                        <RadzenBadge Text="@task.Status.ToString()" BadgeStyle="BadgeStyle.Warning"/>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <RadzenCard Variant="Variant.Text" Style="background: var(--rz-base-100);">
            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0 0 0.5rem;">Next Steps</RadzenText>
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Body2">1. Review the created tasks in the Tasks page</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">2. Configure execution sessions if needed</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">3. Execute tasks to implement the requirements</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">4. Monitor execution progress and results</RadzenText>
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="View Tasks" Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo("/tasks"))"/>
            <RadzenButton Text="Create Another PRD" Icon="add_circle_outline"
                          ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined"
                          Click="@(() => OnDone.InvokeAsync())"/>
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter] public List<TaskDto> CreatedTasks { get; set; } = [];

    [Parameter] public EventCallback OnDone { get; set; }
}
