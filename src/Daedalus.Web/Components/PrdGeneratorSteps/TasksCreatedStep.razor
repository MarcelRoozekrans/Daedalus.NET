@using TaskDto = Daedalus.Application.DTOs.TaskDto
<div class="card border-success">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="bi bi-check-circle"></i>
            Tasks Created Successfully!
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-success">
            <strong>Great!</strong> @CreatedTasks.Count tasks have been created and are ready to execute.
        </div>

        <h6 class="text-primary fw-bold mb-3">
            <i class="bi bi-list-ul"></i>
            Created Tasks
        </h6>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                <tr>
                    <th>Task ID</th>
                    <th>Prompt</th>
                    <th>Max Iterations</th>
                    <th>Current Iteration</th>
                    <th>Created Date</th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var task in CreatedTasks)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary">@task.Id</span>
                        </td>
                        <td>@task.Prompt</td>
                        <td>
                            <span class="badge bg-secondary">@task.MaxIterations</span>
                        </td>
                        <td>
                            <span class="badge bg-info">@task.IterationCount</span>
                        </td>
                        <td>@task.CreatedAt.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-warning">@task.Status</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mt-4 p-3 bg-light rounded">
            <h6 class="fw-bold mb-2">Next Steps:</h6>
            <ol class="mb-0">
                <li>Review the created tasks in the Tasks page</li>
                <li>Configure execution sessions if needed</li>
                <li>Execute tasks to implement the requirements</li>
                <li>Monitor execution progress and results</li>
            </ol>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a href="/tasks" class="btn btn-primary">
                <i class="bi bi-arrow-right"></i>
                View Tasks
            </a>
            <button type="button" class="btn btn-outline-primary" @onclick="() => OnDone.InvokeAsync()">
                <i class="bi bi-plus-circle"></i>
                Create Another PRD
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<TaskDto> CreatedTasks { get; set; } = [];

    [Parameter] public EventCallback OnDone { get; set; }
}
