{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=daedalus;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  },
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5
  },
  "ExternalServices": {
    "Llm": {
      "Provider": "claude",
      "ApiKey": null,
      "Timeout": 30000,
      "Settings": {}
    },
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        }
      }
    }
  }
}
