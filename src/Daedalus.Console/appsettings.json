{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=daedalus;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  },
  "Copilot": {
    "Model": "gpt-4",
    "CliPath": null,
    "LogLevel": "warning"
  },
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "http",
          "Url": "https://context7.com/api",
          "Tools": [
            "*"
          ],
          "Timeout": 10000,
          "Headers": {}
        },
        "awesome-copilot": {
          "Type": "stdio",
          "Command": "docker",
          "Args": [
            "run",
            "-i",
            "--rm",
            "ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:latest"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 30000
        }
      }
    },
    "Context7": {
      "Enabled": true,
      "Timeout": 10000,
      "ApiKey": null
    }
  }
}
