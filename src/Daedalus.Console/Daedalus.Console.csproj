<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Console</RootNamespace>
        <AssemblyName>Daedalus.Console</AssemblyName>
        <!-- AOT disabled: EF Core's ApplyConfigurationsFromAssembly requires reflection/dynamic code -->
        <PublishAot>false</PublishAot>
        <TrimMode>none</TrimMode>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <InvariantGlobalization>false</InvariantGlobalization>
      <UserSecretsId>35699014-8ca3-4d01-912a-c77ed9f616e8</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Domain\Daedalus.Domain.csproj" />
        <ProjectReference Include="..\Daedalus.Application\Daedalus.Application.csproj" />
        <ProjectReference Include="..\Daedalus.Infrastructure\Daedalus.Infrastructure.csproj" />
        <ProjectReference Include="..\Daedalus.Agents\Daedalus.Agents.csproj" />
        <ProjectReference Include="..\Daedalus.ServiceDefaults\Daedalus.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="CSharpFunctionalExtensions" />
        <PackageReference Include="OllamaSharp" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    </ItemGroup>

</Project>