<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Cli</RootNamespace>
        <AssemblyName>Daedalus.Cli</AssemblyName>
        <!-- AOT disabled, like Daedalus.Console and Daedalus.Api: EF Core's ApplyConfigurationsFromAssembly and the
             Thalos agent stack need reflection/dynamic code. -->
        <PublishAot>false</PublishAot>
        <TrimMode>none</TrimMode>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <InvariantGlobalization>false</InvariantGlobalization>
        <UserSecretsId>3924b3b3-246a-4073-bba7-9f588e8801d5</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Domain\Daedalus.Domain.csproj" />
        <ProjectReference Include="..\Daedalus.Application\Daedalus.Application.csproj" />
        <ProjectReference Include="..\Daedalus.Infrastructure\Daedalus.Infrastructure.csproj" />
        <ProjectReference Include="..\Daedalus.Agents\Daedalus.Agents.csproj" />
        <ProjectReference Include="..\Daedalus.ServiceDefaults\Daedalus.ServiceDefaults.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="CSharpFunctionalExtensions" />
        <PackageReference Include="OllamaSharp" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    </ItemGroup>

    <ItemGroup>
        <!-- MCP servers for the Thalos agents; resolved relative to the content root (Thalos:McpConfigPath) -->
        <Content Update=".mcp.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Agent skills (Thalos:Skills:Roots) are authored at the repo root so git is the source of truth. Copied
             next to this host, same mechanism as Daedalus.Api. -->
        <Content Include="..\..\skills\**\SKILL.md" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
