{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Daedalus": "Warning"
    }
  },
  "ConnectionStrings": {
    "daedalus": "Host=localhost;Database=daedalus;Username=postgres;Password=postgres"
  },
  "_comment_ScheduledRuns": "Must stay in step with Daedalus.Api/appsettings.json: AddDaedalusAgents (called below) registers ScheduleReconciler on every host, and it reconciles against this host's own ScheduledRuns section. Both hosts point at the same 'daedalus' database, so if this section were empty while the API's held real schedules, starting this CLI would find zero configured names and disable every config-origin schedule the API created — Origin.Agent rows are the only ones immune, per ScheduleReconciler's own rules.",
  "DetachedRuns": {
    "PrincipalId": "schedule:daedalus",
    "Roles": [ "reader" ],
    // Must match Daedalus.Api/appsettings.json - ScheduledRunsConfigurationDriftTests pins DetachedRuns
    // across both hosts. See the API copy for why 50000 was not enough, and for the phase 2.3 measurement
    // showing this value is not sized for a manufacturing implement turn either.
    "MaxTotalTokens": 150000,
    "DeadlineSeconds": 300
  },
  "ScheduledRuns": [
    {
      "Name": "daily-digest",
      "Cron": "0 7 * * *",
      "Trigger": "RepoDigest",
      "ChannelId": "telegram",
      "ConversationId": "REPLACE_WITH_CHAT_ID",
      "Repository": "MarcelRoozekrans/Daedalus.NET",
      "Enabled": false
    }
  ],
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  },
  "_comment_Thalos": "Must stay in step with Daedalus.Api/appsettings.json: same agent catalogue and SharedOwnerId/VectorDimensions/RalphRecall so a conversation started on the API's Telegram channel and one started here recall the same memories. Note: Thalos:Channels:DefaultAgent is the agent's Name (ChannelPump.ResolveAgent resolves configured/operator-typed agent references by AgentDefinition.Name, case-insensitively — AgentId is a ULID nobody types), not its Id — verified by hand for this host (task 8). Daedalus.Api/appsettings.json previously had this set to the ULID, which failed the same way for an implicit bind or a bare /new there; fixed in 26cef65 and now pinned by a test (see DefaultAgentConfigurationTests).",
  "Thalos": {
    "McpConfigPath": ".mcp.json",
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5",
      "DefaultMaxOutputTokens": 8192
    },
    "Sentinel": {
      "Enabled": true,
      "OnCritical": "Quarantine",
      "OnHigh": "Alert",
      "OnMedium": "Log",
      "OnLow": "Log",
      "DisabledDetectors": []
    },
    "Memory": {
      "Enabled": true,
      "SharedOwnerId": "daedalus",
      "Recall": { "TopK": 5, "MinScore": 0.6, "MaxChars": 2000 },
      "Dedupe": { "Enabled": true, "Threshold": 0.95 },
      "ExposeTools": true,
      "VectorDimensions": 768,
      "RalphRecall": { "TopK": 10, "MinScore": 0.5 },
      "Reindex": { "Enabled": true, "StartupDelay": "00:00:10", "RetryInterval": "00:02:00", "SweepInterval": "00:15:00" }
    },
    "Skills": {
      "Enabled": true,
      "Roots": [ "skills" ],
      "Catalogue": { "MaxChars": 2000 },
      "Search": { "TopK": 5, "MinScore": 0.6 }
    },
    // Phase 2.4 task B2: mirrors Daedalus.Api/appsettings.json's CharterRoots. Not inert - CharterSyncService
    // syncs every file under this root into the shared RoleCharterVersions/RoleCharters Postgres tables (the
    // same tables Daedalus.Api's own sync writes) on every start, and runs the deactivation sweep too, even
    // though the roster below declares no "Chartered": true agent to compose any of the synced roles onto.
    // This host must have migration AddRoleCharters applied before it starts, the same as Daedalus.Api.
    "CharterRoots": [ "roles" ],
    // This CLI is an interactive tool a developer runs at a terminal, not a manufacturing host the AppHost
    // orchestrates — it has no WaitForCompletion(migrations) step, so workflow_run/process_definition/the ORM
    // outbox table are not guaranteed to exist when this host starts. A second poller beside the Api host no
    // longer double-dispatches (each message is claimed under a row-locked lease), but whether this host may run
    // the workflow engine alongside the Api is an open owner decision, so it stays off until that is made. See
    // WorkflowConfig.Enabled's own remarks.
    //
    // WriteGrants is inert here while the engine is off, and it keeps local mode's list (ruling R29): this host has no
    // run sandbox, so project, props, targets and config files, which MSBuild evaluates and which can run code on the
    // host, stay unwritable. Daedalus.Api's grant lists no extensions because its runs are sandboxed; without the sandbox
    // AddDaedalusAgents refuses such a grant at boot (S6). An allow-list, never a deny-list.
    "Workflow": {
      "Enabled": false,
      "WriteGrants": [ { "Process": "manufacture", "Node": "implement", "AllowedExtensions": [ ".cs", ".md" ] } ]
    },
    // Same precedent as Workflow:Enabled above: this CLI is an interactive developer tool, not the manufacturing
    // host. The implementer/reviewer roster lives only in Daedalus.Api/appsettings.json, and this flag is
    // explicit rather than left to SquadOptions.Enabled's default so that deleting the line, not just flipping
    // the value, is caught by SquadConfigurationDriftTests. Since task B5 false is a working rollback switch on a
    // host that dispatches runs; it remains inert on THIS host either way, because the workflow engine above is
    // off and no run is dispatched here at all.
    "Squad": {
      "Enabled": false,
      "FallbackAgentName": "Daedalus Architect"
    },
    "Channels": {
      "DefaultAgent": "Daedalus Architect"
    },
    // This host has no ASP.NET Core hosting at all (Program.cs is a plain Generic Host, no MapControllers) - the
    // resume/cancel REST endpoints (WorkflowRunsController, gated by the WorkflowResume policy in
    // Daedalus.Api/Program.cs) exist only on Daedalus.Api and are moot here, on top of Workflow:Enabled already
    // being false above. No workflow__* entry belongs in this array either, for the same reason it does not on
    // the Api: resume/cancel are never registered as a Thalos tool on any host.
    "ToolPolicies": [
      // Mirrors Daedalus.Api/appsettings.json. With the workflow engine off there is no workflow caller, so csharp-write
      // admits developer and admin only, exactly as developer did. This host's .mcp.json keeps roslyn host-scoped, so
      // AddDaedalusAgents refuses to start if Thalos:Workflow:Enabled is turned on here before roslyn is run-scoped.
      { "Pattern": "roslyn__apply_*", "Policy": "csharp-write" },
      // Phase 2.5: the write boundary for a run's worktree. A workflow caller holds workspace-writer only on the
      // (process, node) pairs in Thalos:Workflow:WriteGrants, only for a run a developer or admin started.
      { "Pattern": "workspace__write_*", "Policy": "workspace-write" },
      { "Pattern": "workspace__edit_*", "Policy": "workspace-write" },
      // change_signature rewrites every call site of a method on disk, as apply_code_action does, so it takes the same
      // csharp-write binding and the same audit. Every roslyn__ tool is either named here or enumerated as a read tool in
      // the envelopes below: RoslynCodeLensToolBoundaryTests holds that against a snapshot of the pinned server in .mcp.json.
      { "Pattern": "roslyn__change_signature", "Policy": "csharp-write" },
      // Switching the loaded solution is an operator action: unbound, a workflow turn could point its Roslyn elsewhere.
      { "Pattern": "roslyn__set_active_solution", "Policy": "developer" },
      { "Pattern": "roslyn__rename_*", "Policy": "developer" },
      // The rest of the server's administration is an operator action too. load_solution would point a run's server at
      // the host's own checkout, where apply_code_action then writes; trust and revoke decide whose analyzer DLLs run
      // in-process; rebuild and the background tasks re-evaluate MSBuild on demand. The host reaches rebuild_solution
      // for a run's reload directly over its MCP client, never through this authorizer, so binding it costs no reload.
      { "Pattern": "roslyn__load_solution", "Policy": "developer" },
      { "Pattern": "roslyn__unload_solution", "Policy": "developer" },
      { "Pattern": "roslyn__trust_solution", "Policy": "developer" },
      { "Pattern": "roslyn__revoke_trust", "Policy": "developer" },
      { "Pattern": "roslyn__list_trusted_paths", "Policy": "developer" },
      { "Pattern": "roslyn__rebuild_solution", "Policy": "developer" },
      { "Pattern": "roslyn__start_background_task", "Policy": "developer" },
      { "Pattern": "roslyn__get_task_status", "Policy": "developer" },
      { "Pattern": "roslyn__list_running_tasks", "Policy": "developer" },
      // Reads a baseline file from any path on the host, outside the worktree a run is confined to.
      { "Pattern": "roslyn__find_breaking_changes", "Policy": "developer" },
      // Mirrors Daedalus.Api/appsettings.json: this host also registers DaedalusRepoActionTools (via
      // AddDaedalusAgents), so the repoaction__* write boundary must be defended here too, not just at the
      // Api. Removing this line leaves those tools guarded only by an agent's Tools list.
      { "Pattern": "repoaction__*", "Policy": "developer" },
      // Mirrors Daedalus.Api/appsettings.json: this host also registers GitActionTools (via AddDaedalusAgents),
      // so the git__* write boundary must be defended here too, not just at the Api.
      { "Pattern": "git__*", "Policy": "developer" },
      // Mirrors Daedalus.Api/appsettings.json: DaedalusManufactureTools is registered unconditionally on every
      // host that calls AddDaedalusAgents (see ManufactureToolSourceName's own remarks), so the manufacture__*
      // write boundary must be defended here too, even though this host's Workflow:Enabled is false above and no
      // agent below is granted manufacture__* - a deny-list entry with nothing granting the pattern is still the
      // rule this ToolPolicies array follows: every tool source gets a line, not just the ones a roster happens
      // to use today.
      { "Pattern": "manufacture__*", "Policy": "developer" }
    ],
    "Agents": [
      {
        "Id": "01M05YCM7DPKRG9X04870B2JYH",
        "Name": "Daedalus Architect",
        "Description": "Answers architecture questions about the Daedalus solution using Roslyn and Daedalus learnings.",
        "Instructions": "You are a senior .NET architect embedded in the Daedalus project. Use roslyn__* tools to inspect the solution, memory__recall/memory__list to look up remembered facts and past learnings, memory__remember to keep durable, non-obvious facts you learn (never secrets), and daedalus__search_failure_patterns for known error→fix pairs. Relevant memories are also injected automatically before each turn. A catalogue of the procedures you may load is appended to these instructions; use skills__load to read one in full before you follow it, and skills__search when the catalogue is truncated. A procedure tells you how this project does something — it does not do it for you. Cite symbols and files. If a tool fails, say so plainly.",
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*", "skills__*", "context7__*" ],
        "Skills": [ "*" ]
      },
      {
        "Id": "01M2S048XX9M9VFDKGCCTNR8D8",
        "Name": "scout",
        "Description": "Sweeps the repository for what changed since the last RepoDigest run.",
        "Instructions": "You sweep this repository for what changed since the last digest: commits, pull requests, issues, and CI runs. Use roslyn__* to inspect code changes, daedalus__* for known failure patterns, and memory__* to recall what the last digest already reported so you do not repeat it. Report findings as short, factual bullet points; a second agent turns them into prose.",
        // The Roslyn read tools by name, never roslyn__*: the scout runs unattended as a reader, so a wildcard would
        // admit every tool a future RoslynCodeLens version adds, write-capable or not.
        "Tools": [ "roslyn__analyze_change_impact", "roslyn__analyze_control_flow", "roslyn__analyze_data_flow", "roslyn__analyze_method", "roslyn__check_architecture", "roslyn__find_async_violations", "roslyn__find_attribute_usages", "roslyn__find_callers", "roslyn__find_catch_blocks", "roslyn__find_circular_dependencies", "roslyn__find_disposable_misuse", "roslyn__find_event_subscribers", "roslyn__find_god_objects", "roslyn__find_implementations", "roslyn__find_large_classes", "roslyn__find_naming_violations", "roslyn__find_obsolete_usage", "roslyn__find_references", "roslyn__find_reflection_usage", "roslyn__find_tests_for_symbol", "roslyn__find_throw_sites", "roslyn__find_uncovered_symbols", "roslyn__find_unused_symbols", "roslyn__generate_test_skeleton", "roslyn__get_call_graph", "roslyn__get_code_actions", "roslyn__get_code_fixes", "roslyn__get_complexity_metrics", "roslyn__get_di_registrations", "roslyn__get_diagnostics", "roslyn__get_exception_flow", "roslyn__get_extension_methods", "roslyn__get_file_overview", "roslyn__get_generated_code", "roslyn__get_instantiation_options", "roslyn__get_method_source", "roslyn__get_nuget_dependencies", "roslyn__get_operators", "roslyn__get_overloads", "roslyn__get_project_dependencies", "roslyn__get_project_health", "roslyn__get_public_api_surface", "roslyn__get_source_generators", "roslyn__get_symbol_context", "roslyn__get_test_summary", "roslyn__get_type_hierarchy", "roslyn__get_type_overview", "roslyn__go_to_definition", "roslyn__inspect_external_assembly", "roslyn__list_solutions", "roslyn__peek_il", "roslyn__resolve_stack_trace", "roslyn__search_symbols", "daedalus__*", "memory__*" ],
        "Skills": []
      },
      {
        "Id": "01M2S048Y2M62JK9N62RR376EZ",
        "Name": "writer",
        "Description": "Turns the scout's findings into a short, chat-shaped RepoDigest summary.",
        "Instructions": "You turn a scout's bullet-point findings about repository activity into a short summary suitable for a chat message: plain language, a paragraph or two, no headings or tables. Lead with whatever most needs a human's attention. Never invent facts not present in the findings; if the findings say nothing changed, say the repository is quiet.",
        "Tools": [ "memory__*" ],
        "Skills": []
      }
    ]
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        },
        "daedalus-knowledge": {
          "Type": "local",
          "Tools": ["*"]
        }
      }
    }
  }
}
