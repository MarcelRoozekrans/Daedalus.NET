<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>13</LangVersion>
        <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
        <!-- Native AOT disabled, like Daedalus.Console: MVC controllers, EF Core (ApplyConfigurationsFromAssembly),
             Aspire, the Anthropic SDK and AI.Sentinel all need reflection/dynamic code — a
             Release publish with PublishAot=true fails on IL2026/IL2104 (this is what kept the API container image
             from ever building). Reflection-based System.Text.Json stays enabled in every configuration for the
             same reason: MVC and the agent session store serialize without source-generated contexts. -->
        <PublishAot>false</PublishAot>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- Lets `dotnet user-secrets set Thalos:Channels:Telegram:BotToken ...` (etc.) reach this host in
             Development, the same mechanism Daedalus.Console already uses for its own secrets. -->
        <UserSecretsId>0c04d16b-eee6-4e74-85c9-fcbe77850b42</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="OllamaSharp" />
        <PackageReference Include="ZeroAlloc.Results" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="ZeroAlloc.Validation" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Daedalus.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <!-- MCP servers for the Thalos agents; resolved relative to the content root (Thalos:McpConfigPath) -->
        <Content Update=".mcp.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Agent skills (Thalos:Skills:Roots) are authored at the repo root so git is the source of truth. Copied next
             to the API and, through the project reference, into every test host that calls AddDaedalusAgents - the same
             mechanism as .mcp.json. Content items flow transitively to referencing projects; None items do not. -->
        <Content Include="..\..\skills\**\SKILL.md" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Squad role charters (Thalos:CharterRoots) - same authoring story as skills above: authored at the
             repo root so git is the source of truth, copied next to the API and, through the project reference,
             into every test host that calls AddDaedalusAgents. roles/README.md is excluded: it carries no
             frontmatter (it documents the folder, not a role), and copying it would only have CharterSyncService
             scan and skip it - and log a warning - on every start. -->
        <Content Include="..\..\roles\**\*.md" Exclude="..\..\roles\README.md" Link="roles\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Process definitions (Thalos:Workflow:ProcessesRoot) - same authoring story as skills above: authored
             at the repo root so git is the source of truth, copied next to the API so ResolveContentRoot's
             assembly-directory fallback finds them under `dotnet run`/Aspire, where the content root is the
             project directory rather than the repo root (see ResolveContentRoot's remarks). Task 11 is this
             folder's first real consumer: f3f7fca created processes/ with only a .gitkeep in it and no build
             item of any kind here, so Thalos:Workflow:ProcessesRoot could never have resolved a real file on
             any host. manufacture.yaml replaced the .gitkeep, and this Content Include is what deploys it.

             This glob is recursive and preserves %(RecursiveDir), and FileSystemProcessDefinitionSource
             enumerates with SearchOption.AllDirectories to match. The two must stay in agreement - a file this
             copies but that source does not read deploys correctly and never loads, with nothing logged. See
             that type's remarks for why recursion is the side the agreement was settled on. -->
        <Content Include="..\..\processes\**\*.yaml" Link="processes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Daedalus.Domain/Daedalus.Domain.csproj" />
        <ProjectReference Include="../Daedalus.Application/Daedalus.Application.csproj" />
        <ProjectReference Include="../Daedalus.Infrastructure/Daedalus.Infrastructure.csproj" />
        <ProjectReference Include="../Daedalus.Agents/Daedalus.Agents.csproj" />
        <ProjectReference Include="../Daedalus.ServiceDefaults/Daedalus.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
