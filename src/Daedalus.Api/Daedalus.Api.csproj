<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>13</LangVersion>
        <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
        <!-- Native AOT disabled, like Daedalus.Console: MVC controllers, EF Core (ApplyConfigurationsFromAssembly),
             Aspire, FluentValidation, the Anthropic SDK and AI.Sentinel all need reflection/dynamic code — a
             Release publish with PublishAot=true fails on IL2026/IL2104 (this is what kept the API container image
             from ever building). Reflection-based System.Text.Json stays enabled in every configuration for the
             same reason: MVC and the agent session store serialize without source-generated contexts. -->
        <PublishAot>false</PublishAot>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="OllamaSharp" />
        <PackageReference Include="CSharpFunctionalExtensions" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Daedalus.Tests.Unit" />
    </ItemGroup>

    <ItemGroup>
        <!-- MCP servers for the Thalos agents; resolved relative to the content root (Thalos:McpConfigPath) -->
        <Content Update=".mcp.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Daedalus.Domain/Daedalus.Domain.csproj" />
        <ProjectReference Include="../Daedalus.Application/Daedalus.Application.csproj" />
        <ProjectReference Include="../Daedalus.Infrastructure/Daedalus.Infrastructure.csproj" />
        <ProjectReference Include="../Daedalus.Agents/Daedalus.Agents.csproj" />
        <ProjectReference Include="../Daedalus.ServiceDefaults/Daedalus.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
