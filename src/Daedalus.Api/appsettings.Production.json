{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "daedalus": ""
  },
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5,
    "MaxIterations": 0,
    "RequestTimeoutSeconds": 300,
    "EnableDetailedLogging": false
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "AwesomeCopilot": {
        "Url": "",
        "Timeout": 30000,
        "Enabled": true,
        "ApiKey": "",
        "Headers": {}
      },
      "Servers": {}
    },
    "Context7": {
      "Enabled": true,
      "ApiUrl": "",
      "Timeout": 10000,
      "ApiKey": ""
    },
    "Platforms": {
      "GitHub": {
        "BaseUrl": "https://github.com",
        "ApiUrl": "https://api.github.com",
        "SshHost": "git@github.com",
        "Enabled": true,
        "AuthToken": ""
      },
      "GitLab": {
        "BaseUrl": "https://gitlab.com",
        "ApiUrl": "https://gitlab.com/api/v4",
        "SshHost": "git@gitlab.com",
        "Enabled": true,
        "AuthToken": ""
      },
      "AzureDevOps": {
        "BaseUrl": "https://dev.azure.com",
        "ApiUrl": "https://dev.azure.com",
        "SshHost": "git@ssh.dev.azure.com",
        "Enabled": true,
        "AuthToken": ""
      },
      "Custom": {}
    },
    "Llm": {
      "Provider": "",
      "Endpoint": "",
      "ApiKey": "",
      "Timeout": 30000,
      "Settings": {}
    }
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": ""
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": ""
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": ""
    }
  }
}
