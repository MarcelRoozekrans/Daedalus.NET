{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "daedalus": ""
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        }
      }
    },
    "Platforms": {
      "GitHub": {
        "ApiUrl": "https://api.github.com"
      }
    }
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": ""
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": ""
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": ""
    }
  }
}
