{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8082",
      "http://keycloak:8082",
      "http://localhost:8081",
      "http://daedalus-web:8080"
    ]
  },
  "Authentication": {
    "Authority": "http://keycloak:8082/realms/daedalus",
    "Audience": "daedalus-api"
  },
  "ConnectionStrings": {
    "daedalus": "Host=localhost;Database=daedalus;Username=postgres;Password=postgres"
  },
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5,
    "MaxIterations": 0,
    "RequestTimeoutSeconds": 300,
    "EnableDetailedLogging": false
  },
  "ModelPricing": {
    "Models": {
      "claude-sonnet-4-20250514": {
        "DisplayName": "Claude Sonnet 4",
        "InputTokenPricePerMillion": 3.00,
        "OutputTokenPricePerMillion": 15.00
      },
      "claude-haiku-4-5-20251001": {
        "DisplayName": "Claude Haiku 4.5",
        "InputTokenPricePerMillion": 0.80,
        "OutputTokenPricePerMillion": 4.00
      },
      "claude-opus-4-20250514": {
        "DisplayName": "Claude Opus 4",
        "InputTokenPricePerMillion": 15.00,
        "OutputTokenPricePerMillion": 75.00
      }
    }
  },
  "Thalos": {
    "McpConfigPath": ".mcp.json",
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5",
      "DefaultMaxOutputTokens": 8192
    },
    "Sentinel": {
      "Enabled": true,
      "OnCritical": "Quarantine",
      "OnHigh": "Alert",
      "OnMedium": "Log",
      "OnLow": "Log",
      "DisabledDetectors": []
    },
    "Memory": {
      "Enabled": true,
      "SharedOwnerId": "daedalus",
      "Recall": { "TopK": 5, "MinScore": 0.6, "MaxChars": 2000 },
      "Dedupe": { "Enabled": true, "Threshold": 0.95 },
      "ExposeTools": true,
      "VectorDimensions": 768,
      "RalphRecall": { "TopK": 10, "MinScore": 0.5 },
      "Reindex": { "Enabled": true, "StartupDelay": "00:00:10", "RetryInterval": "00:02:00", "SweepInterval": "00:15:00" }
    },
    "Skills": {
      "Enabled": true,
      "Roots": [ "skills" ],
      "Catalogue": { "MaxChars": 2000 },
      "Search": { "TopK": 5, "MinScore": 0.6 }
    },
    "ToolPolicies": [
      { "Pattern": "roslyn__apply_*", "Policy": "developer" },
      { "Pattern": "roslyn__rename_*", "Policy": "developer" }
    ],
    "Agents": [
      {
        "Id": "01M05YCM7DPKRG9X04870B2JYH",
        "Name": "Daedalus Architect",
        "Description": "Answers architecture questions about the Daedalus solution using Roslyn and Daedalus learnings.",
        "Instructions": "You are a senior .NET architect embedded in the Daedalus project. Use roslyn__* tools to inspect the solution, memory__recall/memory__list to look up remembered facts and past learnings, memory__remember to keep durable, non-obvious facts you learn (never secrets), and daedalus__search_failure_patterns for known error→fix pairs. Relevant memories are also injected automatically before each turn. A catalogue of the procedures you may load is appended to these instructions; use skills__load to read one in full before you follow it, and skills__search when the catalogue is truncated. A procedure tells you how this project does something — it does not do it for you. Cite symbols and files. If a tool fails, say so plainly.",
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*", "skills__*", "context7__*" ],
        "Skills": [ "*" ]
      }
    ]
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        },
        "daedalus-knowledge": {
          "Type": "local",
          "Tools": ["*"]
        }
      }
    },
    "Platforms": {
      "GitHub": {
        "BaseUrl": "https://github.com",
        "ApiUrl": "https://api.github.com",
        "SshHost": "git@github.com",
        "Enabled": true,
        "AuthToken": null
      },
      "GitLab": {
        "BaseUrl": "https://gitlab.com",
        "ApiUrl": "https://gitlab.com/api/v4",
        "SshHost": "git@gitlab.com",
        "Enabled": true,
        "AuthToken": null
      },
      "AzureDevOps": {
        "BaseUrl": "https://dev.azure.com",
        "ApiUrl": "https://dev.azure.com",
        "SshHost": "git@ssh.dev.azure.com",
        "Enabled": true,
        "AuthToken": null
      },
      "Custom": {}
    },
    "Llm": {
      "Provider": "copilot",
      "Endpoint": "",
      "ApiKey": null,
      "Timeout": 30000,
      "Settings": {}
    }
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  }
}
