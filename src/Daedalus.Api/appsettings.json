{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8082",
      "http://keycloak:8082",
      "http://localhost:8081",
      "http://daedalus-web:8080"
    ]
  },
  "Authentication": {
    "Authority": "http://keycloak:8082/realms/daedalus",
    "Audience": "daedalus-api"
  },
  "ConnectionStrings": {
    "daedalus": "Host=localhost;Database=daedalus;Username=postgres;Password=postgres"
  },
  "DetachedRuns": {
    "PrincipalId": "schedule:daedalus",
    "Roles": [ "reader" ],
    // Per subagent run, so the scout and the writer each get this much. 50000 was not enough and the first
    // real digest failed with SubagentBudgetExceeded at the Scout step: the scout carries roslyn__*, daedalus__*
    // and memory__* tool schemas before it fetches anything, then pulls five categories of repository activity
    // on top. Raised deliberately rather than trimming the scout's tools, which would cost it the ability to
    // describe what actually changed in the code.
    //
    // DeadlineSeconds is the other half of the ceiling and is unchanged: a runaway agent stays bounded by time
    // even when it is bounded generously by tokens.
    "MaxTotalTokens": 150000,
    "DeadlineSeconds": 300
  },
  "ScheduledRuns": [
    {
      "Name": "daily-digest",
      "Cron": "0 7 * * *",
      "Trigger": "RepoDigest",
      "ChannelId": "telegram",
      "ConversationId": "REPLACE_WITH_CHAT_ID",
      "Repository": "MarcelRoozekrans/Daedalus.NET",
      "Enabled": false
    }
  ],
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5,
    "MaxIterations": 0,
    "RequestTimeoutSeconds": 300,
    "EnableDetailedLogging": false
  },
  "ModelPricing": {
    "Models": {
      "claude-sonnet-4-20250514": {
        "DisplayName": "Claude Sonnet 4",
        "InputTokenPricePerMillion": 3.00,
        "OutputTokenPricePerMillion": 15.00
      },
      // 1.00 / 5.00 per million, verified against Anthropic's published pricing table on 2026-09-23.
      // This entry previously carried 0.80 / 4.00, which are Claude Haiku 3.5's rates, not 4.5's.
      "claude-haiku-4-5-20251001": {
        "DisplayName": "Claude Haiku 4.5",
        "InputTokenPricePerMillion": 1.00,
        "OutputTokenPricePerMillion": 5.00
      },
      "claude-opus-4-20250514": {
        "DisplayName": "Claude Opus 4",
        "InputTokenPricePerMillion": 15.00,
        "OutputTokenPricePerMillion": 75.00
      },
      // 5.00 / 25.00 per million, verified against Anthropic's published pricing table on 2026-09-23. Priced here
      // because the reviewer agent below (Thalos:Agents) is configured on this model — the
      // Every_model_configured_on_an_agent_has_a_price drift guard (CostAnalyticsPricingDriftTests) goes red on any
      // configured model with no entry here.
      "claude-opus-5": {
        "DisplayName": "Claude Opus 5",
        "InputTokenPricePerMillion": 5.00,
        "OutputTokenPricePerMillion": 25.00
      },
      // Thalos:Anthropic:DefaultModel (below) is claude-sonnet-5, so it must be priced here too - see
      // the Every_model_configured_on_an_agent_has_a_price drift guard in CostAnalyticsPricingDriftTests.
      // 2.00 / 10.00 per million, verified against Anthropic's published pricing table on 2026-09-23.
      // Launch pricing of 2/10 was scheduled to rise to 3/15 on 2026-09-01; that increase was
      // cancelled and 2/10 is now the standard price. A dated secondary source recording the
      // scheduled rise is how this entry first landed at 3/15.
      "claude-sonnet-5": {
        "DisplayName": "Claude Sonnet 5",
        "InputTokenPricePerMillion": 2.00,
        "OutputTokenPricePerMillion": 10.00
      }
    }
  },
  "Thalos": {
    "McpConfigPath": ".mcp.json",
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5",
      "DefaultMaxOutputTokens": 8192
    },
    "Sentinel": {
      "Enabled": true,
      "OnCritical": "Quarantine",
      "OnHigh": "Alert",
      "OnMedium": "Log",
      "OnLow": "Log",
      "DisabledDetectors": []
    },
    "Memory": {
      "Enabled": true,
      "SharedOwnerId": "daedalus",
      "Recall": { "TopK": 5, "MinScore": 0.6, "MaxChars": 2000 },
      "Dedupe": { "Enabled": true, "Threshold": 0.95 },
      "ExposeTools": true,
      "VectorDimensions": 768,
      "RalphRecall": { "TopK": 10, "MinScore": 0.5 },
      "Reindex": { "Enabled": true, "StartupDelay": "00:00:10", "RetryInterval": "00:02:00", "SweepInterval": "00:15:00" }
    },
    "Skills": {
      "Enabled": true,
      "Roots": [ "skills" ],
      "Catalogue": { "MaxChars": 2000 },
      "Search": { "TopK": 5, "MinScore": 0.6 }
    },
    // Phase 2.3 Task B2: the roster (below, in Thalos:Agents) declares "implementer" and "reviewer", but this
    // flag is what actually lets a process node resolve to either of them (SquadAgentResolver.Resolve) instead
    // of collapsing every role onto FallbackAgentName. The API is the host that runs manufacturing, so it is
    // enabled here; Daedalus.Cli/appsettings.json disables it, matching the Thalos:Workflow:Enabled precedent
    // from the preceding phase. Wiring a process node's role through SquadAgentResolver at all is Task B4, not
    // this one — processes/manufacture.yaml is untouched here.
    // Stated explicitly rather than left to the code default of true. Daedalus.Tests.Integration
    // references Api, Cli and Console, each shipping a generically-named appsettings.json; MSBuild
    // copies all three toward the test output and only one survives. Daedalus.Cli's sets this key
    // to false, so when its copy wins the collision a host that adds Daedalus.Api.appsettings.json
    // afterwards has nothing to override with and the engine stays off. Setting it here means the
    // explicit Api source always wins. Found by the phase 2.3 task B3 review.
    "Workflow": {
      "Enabled": true
    },
    "Squad": {
      "Enabled": true,
      "FallbackAgentName": "Daedalus Architect"
    },
    "Channels": {
      "DefaultAgent": "Daedalus Architect",
      "Telegram": {
        // SINGLE-INSTANCE TRAP: Telegram's getUpdates long-poll refuses concurrent pollers for one bot token.
        // If this API host is ever scaled to more than one replica, Enabled must be true on exactly one replica
        // and false on every other one - two replicas polling the same bot will fight over getUpdates and
        // silently drop messages. This is an operational trap, not something any test here can catch.
        //
        // BotToken is deliberately empty and must NEVER be filled in here or anywhere else in the repo. Supply
        // the real value locally via `dotnet user-secrets set Thalos:Channels:Telegram:BotToken <token>
        // --project src/Daedalus.Api`, and in the container via the `telegram-bot-token` Aspire parameter
        // (src/Daedalus.AppHost/Program.cs), which the AppHost forwards as the
        // Thalos__Channels__Telegram__BotToken environment variable. Until BotToken is set, Telegram is not
        // registered at all (see AddDaedalusChannels.IsTelegramConfigured), so this section is otherwise inert.
        //
        // AllowedUserIds is rejected empty at startup by design (TelegramOptions.Describe) - an empty allow-list
        // would open the bot, and the agent it talks to, to anyone who finds it. Set it via user-secrets too,
        // to a real Telegram user id, together with PrincipalId, before flipping Enabled to true locally.
        "Enabled": false,
        "BotToken": "",
        "PrincipalId": "",
        "AllowedUserIds": []
      }
    },
    // No workflow__* entry belongs here. Resuming or cancelling a run is POST /api/workflow-runs/{id}/resume|cancel
    // (WorkflowRunsController), never a Thalos tool - DefaultToolAuthorizer only ever evaluates a qualified tool
    // name against this array, and resume/cancel are not registered as a local tool source at all, so no run can
    // reach them through an agent's Tools list. Those two endpoints require the WorkflowResume policy instead
    // (Program.cs), the ASP.NET Core role check equivalent of the developer binding below.
    // This list is a deny-list, not an allow-list: DefaultToolAuthorizer allows any tool no binding matches, so
    // every tool source added without a line here is granted to every caller - including WorkflowCaller, which
    // loops unattended with no human in the turn. Adding a write-capable tool source and its ToolPolicies line
    // is one change, not two.
    "ToolPolicies": [
      { "Pattern": "roslyn__apply_*", "Policy": "developer" },
      { "Pattern": "roslyn__rename_*", "Policy": "developer" },
      // THE write boundary for repository actions, not a second opinion on one. Commenting, labelling and closing
      // are visible actions against a real repository, and a scheduled run authenticates as schedule:daedalus with
      // roles ["reader"] - so DefaultToolAuthorizer denies every repoaction__* tool to it no matter what any
      // agent's Tools list says. Removing this line does not merely relax a check; it makes an unattended 07:00
      // run able to close a pull request a human only finds out about at 09:00.
      { "Pattern": "repoaction__*", "Policy": "developer" },
      // Same boundary, owned by Thalos.NET.Git instead of Daedalus: git__* is GitActionTools (branch, commit,
      // push, open pull request) over a real local working tree. A scheduled run's roles ["reader"] fail this
      // policy the same way they fail repoaction__* above - removing this line lets an unattended run push and
      // open a pull request unsupervised.
      { "Pattern": "git__*", "Policy": "developer" }
    ],
    "Agents": [
      {
        "Id": "01M05YCM7DPKRG9X04870B2JYH",
        "Name": "Daedalus Architect",
        "Description": "Answers architecture questions about the Daedalus solution using Roslyn and Daedalus learnings.",
        "Instructions": "You are a senior .NET architect embedded in the Daedalus project. Use roslyn__* tools to inspect the solution, memory__recall/memory__list to look up remembered facts and past learnings, memory__remember to keep durable, non-obvious facts you learn (never secrets), and daedalus__search_failure_patterns for known error→fix pairs. Relevant memories are also injected automatically before each turn. A catalogue of the procedures you may load is appended to these instructions; use skills__load to read one in full before you follow it, and skills__search when the catalogue is truncated. A procedure tells you how this project does something — it does not do it for you. Use repoaction__* to comment, label or close only when the person you are talking to has actually asked for that action against a real repository — these are not read tools, and the change is one other people will see. Cite symbols and files. If a tool fails, say so plainly.",
        // repoaction__* is granted here and nowhere else: the Architect is interactive, so a human sees and can
        // stop a comment, label or close. The scout is unattended and must never hold it. Granting it still does
        // not bypass the repoaction__* tool policy above - the caller has to carry the developer or admin role too.
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*", "skills__*", "context7__*", "repoaction__*" ],
        "Skills": [ "*" ]
      },
      {
        "Id": "01M2S048XX9M9VFDKGCCTNR8D8",
        "Name": "scout",
        "Description": "Sweeps the repository for what changed since the last RepoDigest run.",
        "Instructions": "You sweep this repository for what changed since the last digest: commits, pull requests, issues, and CI runs. Use roslyn__* to inspect code changes, daedalus__* for known failure patterns, and memory__* to recall what the last digest already reported so you do not repeat it. Report findings as short, factual bullet points; a second agent turns them into prose.",
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*" ],
        "Skills": []
      },
      {
        "Id": "01M2S048Y2M62JK9N62RR376EZ",
        "Name": "writer",
        "Description": "Turns the scout's findings into a short, chat-shaped RepoDigest summary.",
        "Instructions": "You turn a scout's bullet-point findings about repository activity into a short summary suitable for a chat message: plain language, a paragraph or two, no headings or tables. Lead with whatever most needs a human's attention. Never invent facts not present in the findings; if the findings say nothing changed, say the repository is quiet.",
        "Tools": [ "memory__*" ],
        "Skills": []
      },
      // Phase 2.3 Task B2: the two manufacturing-pipeline roles. Neither is wired into processes/manufacture.yaml
      // yet (Task B4) - declaring them here only makes them resolvable by name (see SquadAgentResolver and
      // DaedalusAgentsRegistrationTests-style catalog checks), not part of any running process node.
      {
        "Id": "d689abd7-72dd-4cd7-8a17-611bf5530213",
        "Name": "implementer",
        "Description": "Implements one manufacturing pipeline task node.",
        "Instructions": "You implement a task node handed to you by the manufacturing workflow: make the change the node describes and report what you did. Use roslyn__* to inspect and edit the solution, daedalus__* for known failure patterns, memory__* to recall and record durable facts, skills__* to load the procedures this project expects, and context7__* for library documentation. You hold no git__* or repoaction__* tool - committing, pushing and opening a pull request are not offered to this role.",
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*", "skills__*", "context7__*" ],
        "Skills": [ "manufacture-implement" ]
      },
      {
        "Id": "6221a3bd-4f5c-483b-b2ff-36a2aba07aef",
        "Name": "reviewer",
        "Description": "Reviews a manufacturing pipeline task node's work, independently of the agent that implemented it.",
        "Instructions": "You review a task node's work with no access to the implementer's own reasoning: read the code, run analyses, and report an honest verdict. You hold no write-capable roslyn__* tool - you cannot apply a code action or edit anything the implementer touched, only inspect what is actually on disk.",
        // The tool list is a positive read-only enumeration, never "roslyn__*". A reviewer that can edit the code
        // it judges can make its own verdict true, and no instruction prevents that - only the absent tool does.
        // Enumerating positively means a future roslyn__apply_something is absent by default rather than admitted
        // by a wildcard. Verified against the real RoslynCodeLens.Mcp tool surface behind the "roslyn" server in
        // .mcp.json: find_*, get_*, analyze_* and go_to_definition are real, non-empty groups, and list_solutions
        // and search_symbols are two more read tools outside those four prefixes - all six are granted below.
        // apply_code_action is the one write-shaped tool in the whole 32-tool surface and is correctly excluded;
        // admitting the other two read tools does not weaken the isolation, which rests on apply being absent,
        // not on the list being short. (roslyn__rename_* is bound to the developer policy in Thalos:ToolPolicies
        // below, same as apply_*, but no rename_* tool exists in this surface today - that binding matches
        // nothing yet and protects nothing yet; it is harmless to leave in place for if such a tool ever ships.)
        "Tools": [ "roslyn__find_*", "roslyn__get_*", "roslyn__analyze_*", "roslyn__go_to_definition", "roslyn__list_solutions", "roslyn__search_symbols", "daedalus__*", "memory__*", "skills__*", "context7__*" ],
        // Design decision D12 asks for a peer-strength model from a different family so the reviewer does not
        // share the implementer's blind spots. Only one chat provider is configured in this repo (the
        // second-provider work is deliberately parked, see docs/planning/parked-ideas.md), so a different vendor
        // is not available today - every option shares training lineage. claude-opus-5 is the best available
        // approximation: a different model line from Sonnet 5, not a point release of it, and peer-or-better
        // strength. This is a different model line, not a different provider, so the uncorrelated-blind-spots
        // argument is weakened, not satisfied.
        "Model": "claude-opus-5",
        // Task B2 left this empty deliberately - the skill it needed did not exist yet - and added
        // ProcessNodeSkillAllowlistTests to make that omission fail loudly the moment a process node pinned
        // manufacture-review to this agent. Task B4 rewired review to the reviewer, that guard went red naming
        // this exact line, and this is the fix it asked for. Enumerated rather than "*": the Architect is the
        // only agent that loads any procedure, and a reviewer that can load manufacture-implement could read the
        // instructions the work it judges was produced from.
        "Skills": [ "manufacture-review" ]
      }
    ]
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        },
        "daedalus-knowledge": {
          "Type": "local",
          "Tools": ["*"]
        }
      }
    },
    "Platforms": {
      "GitHub": {
        "BaseUrl": "https://github.com",
        "ApiUrl": "https://api.github.com",
        "SshHost": "git@github.com",
        "Enabled": true,
        // AuthToken stays null and must never be filled in here. The agent-facing GitHubOptions does not even
        // bind it: GitHubTokenSource reads the GITHUB_TOKEN environment variable, so no token can be committed.
        "AuthToken": null,
        // Sent on every request; GitHub rejects requests without a User-Agent.
        "UserAgent": "Daedalus",
        // Per-category ceiling for repo_activity. A category that hits it says it was truncated rather than
        // quietly reporting a short list as the whole story.
        "MaxItemsPerCategory": 50,
        // Window repo_activity covers when the caller passes no `since` and the run has no previous occurrence.
        "DefaultLookback": "1.00:00:00"
      },
      "GitLab": {
        "BaseUrl": "https://gitlab.com",
        "ApiUrl": "https://gitlab.com/api/v4",
        "SshHost": "git@gitlab.com",
        "Enabled": true,
        "AuthToken": null
      },
      "AzureDevOps": {
        "BaseUrl": "https://dev.azure.com",
        "ApiUrl": "https://dev.azure.com",
        "SshHost": "git@ssh.dev.azure.com",
        "Enabled": true,
        "AuthToken": null
      },
      "Custom": {}
    },
    "Llm": {
      "Provider": "copilot",
      "Endpoint": "",
      "ApiKey": null,
      "Timeout": 30000,
      "Settings": {}
    }
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
      "ExporterOtlpProtocol": "http/protobuf",
      "Endpoint": "http://localhost:4317"
    },
    "Traces": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    },
    "Metrics": {
      "Exporter": "otlp",
      "Endpoint": "http://localhost:4317"
    }
  }
}
