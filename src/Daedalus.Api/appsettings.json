{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Daedalus": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8082",
      "http://keycloak:8082",
      "http://localhost:8081",
      "http://daedalus-web:8080"
    ]
  },
  "Authentication": {
    "Authority": "http://keycloak:8082/realms/daedalus",
    "Audience": "daedalus-api"
  },
  "ConnectionStrings": {
    "daedalus": "Host=localhost;Database=daedalus;Username=postgres;Password=postgres"
  },
  "DetachedRuns": {
    "PrincipalId": "schedule:daedalus",
    "Roles": [ "reader" ],
    // Per subagent run, so the scout and the writer each get this much. 50000 was not enough and the first
    // real digest failed with SubagentBudgetExceeded at the Scout step: the scout carries roslyn__*, daedalus__*
    // and memory__* tool schemas before it fetches anything, then pulls five categories of repository activity
    // on top. Raised deliberately rather than trimming the scout's tools, which would cost it the ability to
    // describe what actually changed in the code.
    //
    // DeadlineSeconds is the other half of the ceiling and is unchanged: a runaway agent stays bounded by time
    // even when it is bounded generously by tokens.
    //
    // NOT SIZED FOR A MANUFACTURING IMPLEMENT TURN, measured in phase 2.3. The paragraph above explains the
    // SCOUT's sizing and nothing else. BudgetedSubagentRunner stamps this same value onto every workflow-run
    // turn, and one measured `implement` turn used 358703 input tokens - more than twice this ceiling. So for
    // that node the budget decorator is not a cost control, it is a guaranteed SubagentBudgetExceeded on the
    // first turn. Deliberately NOT raised here: a ceiling moved to make one observed turn pass is a number
    // picked, not a sizing, and what the right value is has not been worked out. See section 12 of
    // docs/plans/2026-09-23-phase-2.3-manufacturing-squad-design.md.
    "MaxTotalTokens": 150000,
    "DeadlineSeconds": 300
  },
  "ScheduledRuns": [
    {
      "Name": "daily-digest",
      "Cron": "0 7 * * *",
      "Trigger": "RepoDigest",
      "ChannelId": "telegram",
      "ConversationId": "REPLACE_WITH_CHAT_ID",
      "Repository": "MarcelRoozekrans/Daedalus.NET",
      "Enabled": false
    }
  ],
  "RalphLoop": {
    "IterationDelayMs": 100,
    "MaxConsecutiveFailures": 5,
    "MaxIterations": 0,
    "RequestTimeoutSeconds": 300,
    "EnableDetailedLogging": false
  },
  "ModelPricing": {
    "Models": {
      "claude-sonnet-4-20250514": {
        "DisplayName": "Claude Sonnet 4",
        "InputTokenPricePerMillion": 3.00,
        "OutputTokenPricePerMillion": 15.00
      },
      // 1.00 / 5.00 per million, verified against Anthropic's published pricing table on 2026-09-23.
      // This entry previously carried 0.80 / 4.00, which are Claude Haiku 3.5's rates, not 4.5's.
      "claude-haiku-4-5-20251001": {
        "DisplayName": "Claude Haiku 4.5",
        "InputTokenPricePerMillion": 1.00,
        "OutputTokenPricePerMillion": 5.00
      },
      "claude-opus-4-20250514": {
        "DisplayName": "Claude Opus 4",
        "InputTokenPricePerMillion": 15.00,
        "OutputTokenPricePerMillion": 75.00
      },
      // 5.00 / 25.00 per million, verified against Anthropic's published pricing table on 2026-09-23. Priced here
      // because the reviewer agent runs this model - since phase 2.4 task B2 the model comes from
      // roles/reviewer.md (a charter) rather than a "Model" key on the reviewer's Thalos:Agents entry, and
      // CostAnalyticsPricingDriftTests' Every_model_configured_on_an_agent_has_a_price guard was fixed (round
      // 1) to read the composed, synced agent catalog for exactly this reason - it still goes red on any
      // agent's effective model with no entry here, chartered or not.
      "claude-opus-5": {
        "DisplayName": "Claude Opus 5",
        "InputTokenPricePerMillion": 5.00,
        "OutputTokenPricePerMillion": 25.00
      },
      // Thalos:Anthropic:DefaultModel (below) is claude-sonnet-5, so it must be priced here too - see
      // the Every_model_configured_on_an_agent_has_a_price drift guard in CostAnalyticsPricingDriftTests.
      // 2.00 / 10.00 per million, verified against Anthropic's published pricing table on 2026-09-23.
      // Launch pricing of 2/10 was scheduled to rise to 3/15 on 2026-09-01; that increase was
      // cancelled and 2/10 is now the standard price. A dated secondary source recording the
      // scheduled rise is how this entry first landed at 3/15.
      "claude-sonnet-5": {
        "DisplayName": "Claude Sonnet 5",
        "InputTokenPricePerMillion": 2.00,
        "OutputTokenPricePerMillion": 10.00
      }
    }
  },
  "Thalos": {
    "McpConfigPath": ".mcp.json",
    "Anthropic": {
      "DefaultModel": "claude-sonnet-5",
      "DefaultMaxOutputTokens": 8192
    },
    "Sentinel": {
      "Enabled": true,
      "OnCritical": "Quarantine",
      "OnHigh": "Alert",
      "OnMedium": "Log",
      "OnLow": "Log",
      "DisabledDetectors": []
    },
    "Memory": {
      "Enabled": true,
      "SharedOwnerId": "daedalus",
      "Recall": { "TopK": 5, "MinScore": 0.6, "MaxChars": 2000 },
      "Dedupe": { "Enabled": true, "Threshold": 0.95 },
      "ExposeTools": true,
      "VectorDimensions": 768,
      "RalphRecall": { "TopK": 10, "MinScore": 0.5 },
      "Reindex": { "Enabled": true, "StartupDelay": "00:00:10", "RetryInterval": "00:02:00", "SweepInterval": "00:15:00" }
    },
    "Skills": {
      "Enabled": true,
      "Roots": [ "skills" ],
      "Catalogue": { "MaxChars": 2000 },
      "Search": { "TopK": 5, "MinScore": 0.6 }
    },
    // Phase 2.4 task B2: where a "Chartered": true agent below reads its prose, model and skills from -
    // roles/<Name>.md, synced by Thalos' CharterSyncService the same way Thalos:Skills:Roots is synced. Stated
    // explicitly rather than left to the code default (also "roles") so a stray appsettings.json from another
    // project cannot silently point this host at a folder with no charters in it.
    "CharterRoots": [ "roles" ],
    // Enabled is stated explicitly rather than left to the code default of true. Daedalus.Tests.Integration
    // references Api, Cli and Console, each shipping a generically-named appsettings.json; MSBuild
    // copies all three toward the test output and only one survives. Daedalus.Cli's sets this key
    // to false, so when its copy wins the collision a host that adds Daedalus.Api.appsettings.json
    // afterwards has nothing to override with and the engine stays off. Setting it here means the
    // explicit Api source always wins. Found by the phase 2.3 task B3 review.
    "Workflow": {
      "Enabled": true,
      // Phase 2.5: the only repositories a manufacture run may target. A start naming anything else is 400.
      // Each run works on branch manufacture/<run-id>: in sandbox mode inside its own container, in local mode in a git
      // worktree of <Remote> at <DataRoot>/runs/<run-id>.
      "Repositories": [
        { "Name": "sandbox", "Remote": "https://github.com/MarcelRoozekrans/daedalus-sandbox.git", "DefaultBranch": "main", "Solution": "Sandbox.sln" }
      ],
      // Blank: %LOCALAPPDATA%/Daedalus/workflow-data. Set it to an absolute path to move the mirrors and worktrees.
      "DataRoot": "",
      "CommitAuthor": { "Name": "Daedalus", "Email": "daedalus@roozekrans.nl" },
      // Deploy-reviewed on purpose: a grant in the process YAML would widen a capability live under interval resync.
      // Phase 2.6: implement lists no AllowedExtensions, so it may write any file a run needs, project, props and targets
      // files included. That is safe only because every run is sandboxed (Sandbox below): MSBuild evaluates those files
      // inside the run's own container, never on this host, and the host only applies the run's exported patch to its
      // own clean worktree. AddDaedalusAgents refuses to boot a grant without AllowedExtensions while the sandbox is off
      // (S6). Protected paths, .git/ and .github/ among them, stay unwritable either way.
      "WriteGrants": [ { "Process": "manufacture", "Node": "implement" } ],
      // Phase 2.6: every run gets its own Docker container from Image (the Daedalus.Sandbox project; the AppHost builds
      // and tags daedalus-sandbox:dev). The gateway and egress images are pinned by their multi-platform index digest,
      // resolved with `docker buildx imagetools inspect` on 2026-10-02; the tag before the digest is for the reader only.
      "Sandbox": {
        "Enabled": true,
        "Image": "daedalus-sandbox:dev",
        "Docker": {
          "GatewayImage": "nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10",
          "EgressImage": "ubuntu/squid:6.6-24.04_beta@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029"
        }
      }
    },
    // Phase 2.3: the roster below, in Thalos:Agents, declares "implementer" and "reviewer". The API is the host
    // that runs manufacturing, so the squad is enabled here; Daedalus.Cli/appsettings.json disables it, matching
    // the Thalos:Workflow:Enabled precedent from the preceding phase.
    //
    // WIRED IN TASK B5. Task B2 declared these two agents and built SquadAgentResolver without calling it; task
    // B4 pointed processes/manufacture.yaml at the role names and deliberately still did not wire it, so for the
    // length of that task a false value here rolled nothing back. B5 closed both halves together:
    // SquadWorkflowReferenceResolver puts every process-node agent name through the resolver before the catalog
    // is consulted, and WorkflowRunModeStore writes the resulting mode onto every transition in
    // workflow_run_event. Setting Enabled to false now genuinely runs implement and review as Daedalus
    // Architect - a weaker configuration in which one agent reviews its own work, which is why the run has to
    // record it.
    //
    // ROLL BACK BY SETTING Enabled TO FALSE, NOT BY DELETING THIS BLOCK. FallbackAgentName defaults to blank,
    // and a blank name does not resolve to "no agent" - Thalos' WorkflowReferenceResolver opens with
    // ThrowIfNullOrWhiteSpace, so it throws out of agent resolution. AddDaedalusAgents rejects a blank value at
    // startup for exactly that reason; see ValidateSquadConfig.
    "Squad": {
      "Enabled": true,
      "FallbackAgentName": "Daedalus Architect"
    },
    "Channels": {
      "DefaultAgent": "Daedalus Architect",
      "Telegram": {
        // SINGLE-INSTANCE TRAP: Telegram's getUpdates long-poll refuses concurrent pollers for one bot token.
        // If this API host is ever scaled to more than one replica, Enabled must be true on exactly one replica
        // and false on every other one - two replicas polling the same bot will fight over getUpdates and
        // silently drop messages. This is an operational trap, not something any test here can catch.
        //
        // BotToken is deliberately empty and must NEVER be filled in here or anywhere else in the repo. Supply
        // the real value locally via `dotnet user-secrets set Thalos:Channels:Telegram:BotToken <token>
        // --project src/Daedalus.Api`, and in the container via the `telegram-bot-token` Aspire parameter
        // (src/Daedalus.AppHost/Program.cs), which the AppHost forwards as the
        // Thalos__Channels__Telegram__BotToken environment variable. Until BotToken is set, Telegram is not
        // registered at all (see AddDaedalusChannels.IsTelegramConfigured), so this section is otherwise inert.
        //
        // AllowedUserIds is rejected empty at startup by design (TelegramOptions.Describe) - an empty allow-list
        // would open the bot, and the agent it talks to, to anyone who finds it. Set it via user-secrets too,
        // to a real Telegram user id, together with PrincipalId, before flipping Enabled to true locally.
        "Enabled": false,
        "BotToken": "",
        "PrincipalId": "",
        "AllowedUserIds": []
      }
    },
    // No workflow__* entry belongs here. Resuming or cancelling a run is POST /api/workflow-runs/{id}/resume|cancel
    // (WorkflowRunsController), never a Thalos tool - DefaultToolAuthorizer only ever evaluates a qualified tool
    // name against this array, and resume/cancel are not registered as a local tool source at all, so no run can
    // reach them through an agent's Tools list. Those two endpoints require the WorkflowResume policy instead
    // (Program.cs), the ASP.NET Core role check equivalent of the developer binding below.
    // This list is a deny-list, not an allow-list: DefaultToolAuthorizer allows any tool no binding matches, so
    // every tool source added without a line here is granted to every caller - including WorkflowCaller, which
    // loops unattended with no human in the turn. Adding a write-capable tool source and its ToolPolicies line
    // is one change, not two.
    "ToolPolicies": [
      // Phase 2.5, task B9, and phase 2.6: roslyn is run-scoped in .mcp.json, so a workflow turn's code action is served
      // by its own run's server, never by this host's solution: in sandbox mode, the shipped one, the server inside the
      // run's own sandbox (McpServersLoader makes the entry remote); in local mode a copy over the run's worktree.
      // csharp-write passes developer and admin, whose chat turns keep the host server, and a granted workflow turn
      // whose grant includes .cs or, under the sandbox, lists no extensions at all and so writes any: RoslynCodeLens
      // writes .cs documents with no extension check, so a grant limited to other extensions must not reach this.
      // AddDaedalusAgents refuses to start when csharp-write is bound to a source that is not run-scoped, local or
      // remote. Audited like workspace-write.
      { "Pattern": "roslyn__apply_*", "Policy": "csharp-write" },
      // Phase 2.5: the write boundary for a run's worktree. A workflow caller holds workspace-writer only on the
      // (process, node) pairs in Thalos:Workflow:WriteGrants, only for a run a developer or admin started.
      { "Pattern": "workspace__write_*", "Policy": "workspace-write" },
      { "Pattern": "workspace__edit_*", "Policy": "workspace-write" },
      // change_signature rewrites every call site of a method on disk, as apply_code_action does, so it takes the same
      // csharp-write binding and the same audit. Every roslyn__ tool is either named here or enumerated as a read tool in
      // the envelopes below: RoslynCodeLensToolBoundaryTests holds that against a snapshot of the pinned server in .mcp.json.
      { "Pattern": "roslyn__change_signature", "Policy": "csharp-write" },
      // Switching the loaded solution is an operator action: unbound, a workflow turn could point its Roslyn elsewhere.
      { "Pattern": "roslyn__set_active_solution", "Policy": "developer" },
      { "Pattern": "roslyn__rename_*", "Policy": "developer" },
      // The rest of the server's administration is an operator action too. load_solution would point a run's server at
      // the host's own checkout, where apply_code_action then writes; trust and revoke decide whose analyzer DLLs run
      // in-process; rebuild and the background tasks re-evaluate MSBuild on demand. The host reaches rebuild_solution
      // for a run's reload directly over its MCP client, never through this authorizer, so binding it costs no reload.
      { "Pattern": "roslyn__load_solution", "Policy": "developer" },
      { "Pattern": "roslyn__unload_solution", "Policy": "developer" },
      { "Pattern": "roslyn__trust_solution", "Policy": "developer" },
      { "Pattern": "roslyn__revoke_trust", "Policy": "developer" },
      { "Pattern": "roslyn__list_trusted_paths", "Policy": "developer" },
      { "Pattern": "roslyn__rebuild_solution", "Policy": "developer" },
      { "Pattern": "roslyn__start_background_task", "Policy": "developer" },
      { "Pattern": "roslyn__get_task_status", "Policy": "developer" },
      { "Pattern": "roslyn__list_running_tasks", "Policy": "developer" },
      // Reads a baseline file from any path on the host, outside the worktree a run is confined to.
      { "Pattern": "roslyn__find_breaking_changes", "Policy": "developer" },
      // THE write boundary for repository actions, not a second opinion on one. Commenting, labelling and closing
      // are visible actions against a real repository, and a scheduled run authenticates as schedule:daedalus with
      // roles ["reader"] - so DefaultToolAuthorizer denies every repoaction__* tool to it no matter what any
      // agent's Tools list says. Removing this line does not merely relax a check; it makes an unattended 07:00
      // run able to close a pull request a human only finds out about at 09:00.
      { "Pattern": "repoaction__*", "Policy": "developer" },
      // Same boundary, owned by Thalos.NET.Git instead of Daedalus: git__* is GitActionTools (branch, commit,
      // push, open pull request) over a real local working tree. A scheduled run's roles ["reader"] fail this
      // policy the same way they fail repoaction__* above - removing this line lets an unattended run push and
      // open a pull request unsupervised.
      { "Pattern": "git__*", "Policy": "developer" },
      // Phase 2.4 task B3: manufacture__start (DaedalusManufactureTools) kicks off a whole manufacturing run -
      // implement, review, publish - unattended, spending real API tokens with no human turn watching any of it.
      // Registered unconditionally (see ManufactureToolSourceName's own remarks), so this line is what actually
      // stops a scheduled or workflow-run caller from starting one: a scheduled run's roles ["reader"] and
      // WorkflowCaller's role "workflow" both fail the developer policy the same way they fail repoaction__* and
      // git__* above. Removing this line would let an unattended run start another run of itself.
      { "Pattern": "manufacture__*", "Policy": "developer" }
    ],
    "Agents": [
      {
        "Id": "01M05YCM7DPKRG9X04870B2JYH",
        "Name": "Daedalus Architect",
        "Description": "Answers architecture questions about the Daedalus solution using Roslyn and Daedalus learnings.",
        "Instructions": "You are a senior .NET architect embedded in the Daedalus project. Use roslyn__* tools to inspect the solution, memory__recall/memory__list to look up remembered facts and past learnings, memory__remember to keep durable, non-obvious facts you learn (never secrets), and daedalus__search_failure_patterns for known error→fix pairs. Relevant memories are also injected automatically before each turn. A catalogue of the procedures you may load is appended to these instructions; use skills__load to read one in full before you follow it, and skills__search when the catalogue is truncated. A procedure tells you how this project does something — it does not do it for you. Use repoaction__* to comment, label, close or file an issue only when the person you are talking to has actually asked for that action against a real repository — these are not read tools, and the change is one other people will see. Cite symbols and files. If a tool fails, say so plainly.",
        // repoaction__* is granted here and nowhere else: the Architect is interactive, so a human sees and can
        // stop a comment, label or close. The scout is unattended and must never hold it. Granting it still does
        // not bypass the repoaction__* tool policy above - the caller has to carry the developer or admin role too.
        // manufacture__* (task B3) is granted here for the same reason and nowhere else: starting a manufacture
        // run is a human-triggered action from an interactive turn, never something the scout or a scheduled run
        // should be able to kick off - and the manufacture__* -> developer policy above still gates the call even
        // for this agent, the same way it already does for repoaction__*.
        "Tools": [ "roslyn__*", "daedalus__*", "memory__*", "skills__*", "context7__*", "repoaction__*", "manufacture__*" ],
        "Skills": [ "*" ]
      },
      {
        "Id": "01M2S048XX9M9VFDKGCCTNR8D8",
        "Name": "scout",
        "Description": "Sweeps the repository for what changed since the last RepoDigest run.",
        "Instructions": "You sweep this repository for what changed since the last digest: commits, pull requests, issues, and CI runs. Use roslyn__* to inspect code changes, daedalus__* for known failure patterns, and memory__* to recall what the last digest already reported so you do not repeat it. Report findings as short, factual bullet points; a second agent turns them into prose.",
        // The Roslyn read tools by name, never roslyn__*: the scout runs unattended as a reader, so a wildcard would
        // admit every tool a future RoslynCodeLens version adds, write-capable or not.
        "Tools": [ "roslyn__analyze_change_impact", "roslyn__analyze_control_flow", "roslyn__analyze_data_flow", "roslyn__analyze_method", "roslyn__check_architecture", "roslyn__find_async_violations", "roslyn__find_attribute_usages", "roslyn__find_callers", "roslyn__find_catch_blocks", "roslyn__find_circular_dependencies", "roslyn__find_disposable_misuse", "roslyn__find_event_subscribers", "roslyn__find_god_objects", "roslyn__find_implementations", "roslyn__find_large_classes", "roslyn__find_naming_violations", "roslyn__find_obsolete_usage", "roslyn__find_references", "roslyn__find_reflection_usage", "roslyn__find_tests_for_symbol", "roslyn__find_throw_sites", "roslyn__find_uncovered_symbols", "roslyn__find_unused_symbols", "roslyn__generate_test_skeleton", "roslyn__get_call_graph", "roslyn__get_code_actions", "roslyn__get_code_fixes", "roslyn__get_complexity_metrics", "roslyn__get_di_registrations", "roslyn__get_diagnostics", "roslyn__get_exception_flow", "roslyn__get_extension_methods", "roslyn__get_file_overview", "roslyn__get_generated_code", "roslyn__get_instantiation_options", "roslyn__get_method_source", "roslyn__get_nuget_dependencies", "roslyn__get_operators", "roslyn__get_overloads", "roslyn__get_project_dependencies", "roslyn__get_project_health", "roslyn__get_public_api_surface", "roslyn__get_source_generators", "roslyn__get_symbol_context", "roslyn__get_test_summary", "roslyn__get_type_hierarchy", "roslyn__get_type_overview", "roslyn__go_to_definition", "roslyn__inspect_external_assembly", "roslyn__list_solutions", "roslyn__peek_il", "roslyn__resolve_stack_trace", "roslyn__search_symbols", "daedalus__*", "memory__*" ],
        "Skills": []
      },
      {
        "Id": "01M2S048Y2M62JK9N62RR376EZ",
        "Name": "writer",
        "Description": "Turns the scout's findings into a short, chat-shaped RepoDigest summary.",
        "Instructions": "You turn a scout's bullet-point findings about repository activity into a short summary suitable for a chat message: plain language, a paragraph or two, no headings or tables. Lead with whatever most needs a human's attention. Never invent facts not present in the findings; if the findings say nothing changed, say the repository is quiet.",
        "Tools": [ "memory__*" ],
        "Skills": []
      },
      // Phase 2.3: the two manufacturing-pipeline roles. Both are live - processes/manufacture.yaml v4 names
      // implementer on `implement` and reviewer on `review`, and ProcessDefinitionSync validates both against
      // this catalog at host start, so a rename here leaves v4 unactivatable rather than failing per node on a
      // paying run. With Thalos:Squad:Enabled false neither is dispatched at all: every node resolves to
      // Daedalus Architect instead, and the run records that it did.
      //
      // Phase 2.4 task B2: "Chartered": true moves each role's Description/Instructions/Model/Skills out of this
      // file and into a versioned charter, roles/<Name>.md, synced by Thalos' CharterSyncService. Only identity
      // (Id, Name), the tool envelope (Tools) and Memory stay here - see AgentEnvelope. This is deliberate for
      // the tool list in particular: a charter naming tools is refused at sync, so the reviewer's independence -
      // holding no write-capable roslyn__* tool - cannot move out of configuration into a markdown file that
      // does not need a reviewed deploy to change.
      {
        "Id": "d689abd7-72dd-4cd7-8a17-611bf5530213",
        "Name": "implementer",
        "Chartered": true,
        // workspace__* (phase 2.5, 2.6): the run's own files, inside its sandbox in the shipped sandbox mode. Its writes
        // are still bound to workspace-write above, which only the implement node of a developer-started run passes;
        // under the sandbox the host-wide ceiling, which the implement grant leaves at any extension, is the only list
        // applied, and protected paths stay unwritable. sandbox__build and sandbox__test (phase 2.6) build and test the
        // run's solution inside its sandbox; they refuse any caller without a run, so no chat turn reaches them.
        // Roslyn: the read tools by name plus apply_code_action, never roslyn__*. A wildcard admitted load_solution, which
        // points the run's server at any solution on the host, and every tool a future RoslynCodeLens version adds.
        "Tools": [ "roslyn__analyze_change_impact", "roslyn__analyze_control_flow", "roslyn__analyze_data_flow", "roslyn__analyze_method", "roslyn__check_architecture", "roslyn__find_async_violations", "roslyn__find_attribute_usages", "roslyn__find_callers", "roslyn__find_catch_blocks", "roslyn__find_circular_dependencies", "roslyn__find_disposable_misuse", "roslyn__find_event_subscribers", "roslyn__find_god_objects", "roslyn__find_implementations", "roslyn__find_large_classes", "roslyn__find_naming_violations", "roslyn__find_obsolete_usage", "roslyn__find_references", "roslyn__find_reflection_usage", "roslyn__find_tests_for_symbol", "roslyn__find_throw_sites", "roslyn__find_uncovered_symbols", "roslyn__find_unused_symbols", "roslyn__generate_test_skeleton", "roslyn__get_call_graph", "roslyn__get_code_actions", "roslyn__get_code_fixes", "roslyn__get_complexity_metrics", "roslyn__get_di_registrations", "roslyn__get_diagnostics", "roslyn__get_exception_flow", "roslyn__get_extension_methods", "roslyn__get_file_overview", "roslyn__get_generated_code", "roslyn__get_instantiation_options", "roslyn__get_method_source", "roslyn__get_nuget_dependencies", "roslyn__get_operators", "roslyn__get_overloads", "roslyn__get_project_dependencies", "roslyn__get_project_health", "roslyn__get_public_api_surface", "roslyn__get_source_generators", "roslyn__get_symbol_context", "roslyn__get_test_summary", "roslyn__get_type_hierarchy", "roslyn__get_type_overview", "roslyn__go_to_definition", "roslyn__inspect_external_assembly", "roslyn__list_solutions", "roslyn__peek_il", "roslyn__resolve_stack_trace", "roslyn__search_symbols", "roslyn__apply_code_action", "daedalus__*", "memory__*", "skills__*", "context7__*", "workspace__*", "sandbox__build", "sandbox__test" ]
      },
      {
        "Id": "6221a3bd-4f5c-483b-b2ff-36a2aba07aef",
        "Name": "reviewer",
        "Chartered": true,
        // The tool list is a positive read-only enumeration, never "roslyn__*". A reviewer that can edit the code
        // it judges can make its own verdict true, and no instruction prevents that - only the absent tool does.
        // Enumerating by exact name means a tool a future RoslynCodeLens version adds is absent by default rather than
        // admitted by a wildcard, even one named find_ or get_. The names are the read tools of the version pinned in
        // .mcp.json; RoslynCodeLensToolBoundaryTests checks them against a snapshot of that server's tools/list. The
        // server's write tools, apply_code_action, change_signature and rename_symbol, are all absent here, and bound in
        // Thalos:ToolPolicies above besides. The isolation rests on those being absent, not on the list being short.
        //
        // This list staying here, in configuration, rather than moving to roles/reviewer.md with the rest of the
        // role, is what task B2 exists to guarantee: a charter's frontmatter may not name a tools key at all
        // (RoleCharterFileLoader refuses the file at sync), so this envelope cannot be weakened by an edit that
        // skips a reviewed deploy. The same positive enumeration holds for the run's files (phase 2.5): the two
        // workspace__ read tools, never workspace__* and never a write or edit tool; and of the sandbox's tools (phase
        // 2.6) only sandbox__test, never sandbox__build or sandbox__*.
        "Tools": [ "roslyn__analyze_change_impact", "roslyn__analyze_control_flow", "roslyn__analyze_data_flow", "roslyn__analyze_method", "roslyn__check_architecture", "roslyn__find_async_violations", "roslyn__find_attribute_usages", "roslyn__find_callers", "roslyn__find_catch_blocks", "roslyn__find_circular_dependencies", "roslyn__find_disposable_misuse", "roslyn__find_event_subscribers", "roslyn__find_god_objects", "roslyn__find_implementations", "roslyn__find_large_classes", "roslyn__find_naming_violations", "roslyn__find_obsolete_usage", "roslyn__find_references", "roslyn__find_reflection_usage", "roslyn__find_tests_for_symbol", "roslyn__find_throw_sites", "roslyn__find_uncovered_symbols", "roslyn__find_unused_symbols", "roslyn__generate_test_skeleton", "roslyn__get_call_graph", "roslyn__get_code_actions", "roslyn__get_code_fixes", "roslyn__get_complexity_metrics", "roslyn__get_di_registrations", "roslyn__get_diagnostics", "roslyn__get_exception_flow", "roslyn__get_extension_methods", "roslyn__get_file_overview", "roslyn__get_generated_code", "roslyn__get_instantiation_options", "roslyn__get_method_source", "roslyn__get_nuget_dependencies", "roslyn__get_operators", "roslyn__get_overloads", "roslyn__get_project_dependencies", "roslyn__get_project_health", "roslyn__get_public_api_surface", "roslyn__get_source_generators", "roslyn__get_symbol_context", "roslyn__get_test_summary", "roslyn__get_type_hierarchy", "roslyn__get_type_overview", "roslyn__go_to_definition", "roslyn__inspect_external_assembly", "roslyn__list_solutions", "roslyn__peek_il", "roslyn__resolve_stack_trace", "roslyn__search_symbols", "daedalus__*", "memory__*", "skills__*", "context7__*", "workspace__read_file", "workspace__list_files", "sandbox__test" ]
      }
    ]
  },
  "ExternalServices": {
    "Mcp": {
      "Enabled": true,
      "Servers": {
        "context7": {
          "Type": "stdio",
          "Command": "npx",
          "Args": [
            "-y",
            "@upstash/context7-mcp"
          ],
          "Tools": [
            "*"
          ],
          "Timeout": 15000
        },
        "daedalus-knowledge": {
          "Type": "local",
          "Tools": ["*"]
        }
      }
    },
    "Platforms": {
      "GitHub": {
        "BaseUrl": "https://github.com",
        "ApiUrl": "https://api.github.com",
        "SshHost": "git@github.com",
        "Enabled": true,
        // AuthToken stays null and must never be filled in here. The agent-facing GitHubOptions does not even
        // bind it: GitHubTokenSource reads the GITHUB_TOKEN environment variable, so no token can be committed.
        "AuthToken": null,
        // Sent on every request; GitHub rejects requests without a User-Agent.
        "UserAgent": "Daedalus",
        // Per-category ceiling for repo_activity. A category that hits it says it was truncated rather than
        // quietly reporting a short list as the whole story.
        "MaxItemsPerCategory": 50,
        // Window repo_activity covers when the caller passes no `since` and the run has no previous occurrence.
        "DefaultLookback": "1.00:00:00"
      },
      "GitLab": {
        "BaseUrl": "https://gitlab.com",
        "ApiUrl": "https://gitlab.com/api/v4",
        "SshHost": "git@gitlab.com",
        "Enabled": true,
        "AuthToken": null
      },
      "AzureDevOps": {
        "BaseUrl": "https://dev.azure.com",
        "ApiUrl": "https://dev.azure.com",
        "SshHost": "git@ssh.dev.azure.com",
        "Enabled": true,
        "AuthToken": null
      },
      "Custom": {}
    },
    "Llm": {
      "Provider": "copilot",
      "Endpoint": "",
      "ApiKey": null,
      "Timeout": 30000,
      "Settings": {}
    }
  },
  "OpenTelemetry": {
    "Logs": {
      "Exporter": "otlp",
