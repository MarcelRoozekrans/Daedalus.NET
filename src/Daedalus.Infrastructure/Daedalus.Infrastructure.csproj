<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework />
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Infrastructure</RootNamespace>
        <AssemblyName>Daedalus.Infrastructure</AssemblyName>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Daedalus.Tests.Unit.Infrastructure" />
        <InternalsVisibleTo Include="Daedalus.Tests.Integration" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Domain\Daedalus.Domain.csproj" />
        <ProjectReference Include="..\Daedalus.Application\Daedalus.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="ZeroAlloc.Results" />
        <PackageReference Include="ZeroAlloc.Rest" />
        <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
        <PackageReference Include="ZLinq" />
        <PackageReference Include="LibGit2Sharp" />
        <!-- Phase 3.5: the data layer on ZeroAlloc.ORM. Maps and SQL classes live here, under Persistence/Orm, because
             the generator reads maps from the compilation that holds the queries (ruling R3). Npgsql and the async
             adapter are direct: DaedalusDb opens pooled connections from the shared NpgsqlDataSource. -->
        <PackageReference Include="Npgsql" />
        <PackageReference Include="AdoNet.Async.Adapters" />
        <PackageReference Include="ZeroAlloc.ORM" />
        <PackageReference Include="ZeroAlloc.ORM.Generator" />
        <PackageReference Include="ZeroAlloc.ORM.Linq" />
    </ItemGroup>

    <ItemGroup>
        <!-- Phase 3.5: Daedalus' schema migrations, read by DaedalusMigrations through EmbeddedResourceMigrationSource
             as Daedalus.Infrastructure.Persistence.Migrations.NNNN_name.sql. -->
        <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    </ItemGroup>

</Project>
