<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Migrations</RootNamespace>
        <AssemblyName>Daedalus.Migrations</AssemblyName>
        <!-- Published as a Native AOT binary. Native AOT trims every assembly, so the trim mode is full: the shared
             partial default would make ILC root each assembly not marked IsTrimmable and report warnings on code
             nothing calls. EF Core's reflection, the reason it was once excluded, went in phase 3.5. The trim
             analyzer stays on from Directory.Build.props. -->
        <PublishAot>true</PublishAot>
        <TrimMode>full</TrimMode>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <!-- PreScopingMigrationHistoryUpgradeTests pins PreScopingMigrationHistory's upgrade statements to the library's. -->
        <InternalsVisibleTo Include="Daedalus.Tests.Integration" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Daedalus.Domain/Daedalus.Domain.csproj"/>
        <ProjectReference Include="../Daedalus.Infrastructure/Daedalus.Infrastructure.csproj"/>
        <ProjectReference Include="../Daedalus.ServiceDefaults/Daedalus.ServiceDefaults.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Phase 2.2 Part B: applies the workflow engine's raw-SQL migrations (WorkflowOrmMigrations,
             OutboxOrmMigrations) as the same explicit, pre-boot deploy step this tool runs Daedalus' own
             migrations as — see Program.cs. AddWorkflowOrm's EnsureSchemaOnStartup is left off for exactly this
             reason: migration 1004 is not backward compatible with pre-1004 code (see task-9-report.md). -->
        <PackageReference Include="Thalos.NET.Workflow.Orm" />
        <PackageReference Include="ZeroAlloc.Outbox.Orm" />
        <PackageReference Include="ZeroAlloc.ORM" />
        <PackageReference Include="AdoNet.Async.Adapters" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

</Project>