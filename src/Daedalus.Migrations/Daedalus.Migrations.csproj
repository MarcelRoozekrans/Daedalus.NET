<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Migrations</RootNamespace>
        <AssemblyName>Daedalus.Migrations</AssemblyName>
        <!-- AOT disabled: Migrations tool requires EF Core reflection for schema discovery -->
        <PublishAot>false</PublishAot>
        <!-- Disable trimming to preserve EF Core reflection capabilities -->
        <TrimMode>none</TrimMode>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Daedalus.Domain/Daedalus.Domain.csproj"/>
        <ProjectReference Include="../Daedalus.Infrastructure/Daedalus.Infrastructure.csproj"/>
        <ProjectReference Include="../Daedalus.ServiceDefaults/Daedalus.ServiceDefaults.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Phase 2.2 Part B: applies the workflow engine's raw-SQL migrations (WorkflowOrmMigrations,
             OutboxOrmMigrations) as the same explicit, pre-boot deploy step this tool already runs EF Core's
             migrations as — see Program.cs. AddWorkflowOrm's EnsureSchemaOnStartup is left off for exactly this
             reason: migration 1004 is not backward compatible with pre-1004 code (see task-9-report.md). -->
        <PackageReference Include="Thalos.NET.Workflow.Orm" />
        <PackageReference Include="ZeroAlloc.Outbox.Orm" />
        <PackageReference Include="ZeroAlloc.ORM" />
        <PackageReference Include="AdoNet.Async.Adapters" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

</Project>