<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>13.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Daedalus.Agents</RootNamespace>
        <AssemblyName>Daedalus.Agents</AssemblyName>
        <!-- Thalos/MAF are not trim-safe yet; this project is never AOT-published -->
        <IsTrimmable>false</IsTrimmable>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Daedalus.Tests.Integration" />
        <InternalsVisibleTo Include="Daedalus.Tests.Unit" />
        <InternalsVisibleTo Include="Daedalus.Tests.Unit.Application" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Daedalus.Domain\Daedalus.Domain.csproj" />
        <ProjectReference Include="..\Daedalus.Application\Daedalus.Application.csproj" />
        <ProjectReference Include="..\Daedalus.Infrastructure\Daedalus.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Thalos.NET" />
        <PackageReference Include="Thalos.NET.Channels" />
        <PackageReference Include="Thalos.NET.Channels.Telegram" />
        <PackageReference Include="Thalos.NET.Mcp" />
        <PackageReference Include="Thalos.NET.Anthropic" />
        <PackageReference Include="Thalos.NET.Sentinel" />
        <PackageReference Include="Thalos.NET.Memory" />
        <PackageReference Include="Thalos.NET.Memory.RagNet" />
        <PackageReference Include="Thalos.NET.Skills" />
        <PackageReference Include="ZeroAlloc.Mapping" />
        <PackageReference Include="ZeroAlloc.Outbox" />
        <PackageReference Include="ZeroAlloc.Outbox.EfCore" />
        <PackageReference Include="Cronos" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <!-- AddHttpClient<GitHubApi>: a pooled, rotated handler instead of a hand-newed HttpClient. -->
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <!-- ZeroAlloc.Results 1.2.1 ships AssemblyVersion 0.1.0.0, a downgrade from 1.2.0's 1.2.0.0, which
             breaks the default assembly binder at host startup. Remove this override once 1.2.2 fixes the stamp. -->
        <PackageReference Include="ZeroAlloc.Results" VersionOverride="1.2.0" />
    </ItemGroup>

</Project>
