{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aspire-apphost",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Daedalus.AppHost/Daedalus.AppHost.csproj"],
      "port": 17300
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Daedalus.Api/Daedalus.Api.csproj", "--urls", "http://localhost:5000"],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Daedalus.Web/Daedalus.Web.csproj", "--urls", "http://localhost:5290"],
      "port": 5290
    }
  ]
}
