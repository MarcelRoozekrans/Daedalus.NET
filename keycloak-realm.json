{
  "realm": "daedalus",
  "displayName": "Daedalus",
  "displayNameHtml": "<strong>Daedalus</strong> - AI-Powered Code Analysis",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "clients": [
    {
      "clientId": "daedalus-api",
      "name": "Daedalus API",
      "description": "Backend API for Daedalus code analysis",
      "publicClient": false,
      "protocol": "openid-connect",
      "enabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "daedalus-api-secret-change-in-production",
      "defaultClientScopes": ["profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-mapper-daedalus-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "daedalus-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "daedalus-wasm",
      "name": "Daedalus Web",
      "description": "Blazor WASM frontend for Daedalus",
      "publicClient": true,
      "protocol": "openid-connect",
      "enabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:5290/authentication/login-callback",
        "http://localhost:5290",
        "http://localhost:8081/authentication/login-callback",
        "http://localhost:8081",
        "http://daedalus-web:8080/authentication/login-callback",
        "http://daedalus-web:8080",
        "http://localhost:*/authentication/login-callback",
        "http://localhost:*"
      ],
      "webOrigins": [
        "http://localhost:5290",
        "http://localhost:8081",
        "http://daedalus-web:8080",
        "http://localhost:8080",
        "+"
      ],
      "defaultClientScopes": ["profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-mapper-daedalus-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "daedalus-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev123",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-daedalus", "project-manager", "task-manager", "analyst"]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-daedalus", "project-manager", "task-manager", "analyst", "admin"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "project-manager", "description": "Can manage projects", "composite": false, "clientRole": false, "attributes": {} },
      { "name": "task-manager", "description": "Can manage tasks", "composite": false, "clientRole": false, "attributes": {} },
      { "name": "analyst", "description": "Can run code analysis", "composite": false, "clientRole": false, "attributes": {} },
      { "name": "admin", "description": "Full administrative access", "composite": false, "clientRole": false, "attributes": {} }
    ]
  },
  "scopeMappings": []
}
